---
// V0.1 classifier eval body, shared by /eval-v01 and /eval?schema=prose-v1.
---
  <main class="eval-page">
    <section class="hero">
      <h1>CCT Fleet · Classifier Eval <span class="status-pill" id="eval-status">loading</span></h1>
      <p class="lede" id="eval-sub">loading…</p>
      <div class="legend">
        <span class="chip chip-cand"><i></i> candidate</span>
        <span class="chip chip-ours"><i></i> Qwen14B-SFT (ours)</span>
        <span class="chip chip-truth"><i></i> Qwen3-30B labels (reference)</span>
      </div>
    </section>

    <section class="kpi-row">
      <div class="kpi"><div class="kpi-n" id="kpi-cands">—</div><div class="kpi-l">candidates vs pseudo-labels</div></div>
      <div class="kpi"><div class="kpi-n accent" id="kpi-spent">—</div><div class="kpi-l">Nebius spent · <span id="kpi-headroom">—</span> headroom</div></div>
      <div class="kpi"><div class="kpi-n" id="kpi-rows">—</div><div class="kpi-l">held-out msgs (Qwen3-30B labels)</div></div>
      <div class="kpi"><div class="kpi-n ours" id="kpi-ours">—</div><div class="kpi-l">our Qwen14B-SFT bar</div></div>
    </section>

    <section class="card">
      <h2>Per-field agreement with Qwen3-30B pseudo-labels (685 held-out msgs) <span class="muted">— macro-F1 per field; Opus-labeled scores: Stage 1 table on the prose-v1 eval tab</span></h2>
      <div id="chart-agreement" class="chart"></div>
      <p class="hint">Grouped bars per field. Each candidate's macro-F1 on that single field vs the Qwen3-30B pseudo-labels (shown as %). <strong class="ours-text">Qwen14B-SFT (ours)</strong> in pink.</p>
    </section>

    <section class="grid-2">
      <div class="card">
        <h2>Alignment rate <span class="muted">— per-message exact match, agreement with Qwen3-30B pseudo-labels (685 held-out msgs)</span></h2>
        <div id="chart-alignment" class="chart"></div>
        <p class="hint">Qwen3-30B-A3B is the labeler, so its own row scores high by construction.</p>
      </div>
      <div class="card">
        <h2>Per-field macro F1 <span class="muted">— agreement with Qwen3-30B pseudo-labels (685 held-out msgs)</span></h2>
        <div id="chart-heatmap" class="chart"></div>
        <p class="hint hint-warn">Reference = Qwen3-30B-A3B labels on 685 held-out messages, not a frontier model.</p>
      </div>
    </section>

    <section class="grid-2">
      <div class="card">
        <h2>Cost <span class="muted">— $ per 1,000 messages classified</span></h2>
        <div id="chart-cost" class="chart"></div>
        <p class="hint" id="cost-note">SFT'd 14B serves locally at near-zero marginal cost after setup; baselines are Nebius Token Factory per-token.</p>
      </div>
      <div class="card">
        <h2>Pareto <span class="muted">— cost vs alignment (log cost axis)</span></h2>
        <div id="chart-pareto" class="chart"></div>
      </div>
    </section>

    <section class="grid-2">
      <div class="card">
        <h2>Latency <span class="muted">— p50 per message (ms)</span></h2>
        <table id="latency-table" class="eval-table"></table>
        <p class="hint">p50 per message on the 685 held-out messages.</p>
      </div>
      <div class="card">
        <h2>Headline story <span class="muted">— the 3 numbers</span></h2>
        <div class="headline-grid" id="headline-grid">
          <div class="hl"><div class="hl-n" id="hl-1">—</div><div class="hl-l">vs flagship baseline</div></div>
          <div class="hl"><div class="hl-n" id="hl-2">—</div><div class="hl-l">latency speedup</div></div>
          <div class="hl"><div class="hl-n" id="hl-3">—</div><div class="hl-l">alignment uplift vs base</div></div>
        </div>
        <p class="hint" id="headline-prose">Measured against Qwen3-30B-A3B pseudo-labels, not a frontier reference: a high score means close to the labeler, not correct. Opus-labeled scores: Stage 1 table on the prose-v1 eval tab.</p>
      </div>
    </section>

    <div class="callout" id="sft-callout" hidden>
      <strong>LoRAs trained</strong> · <span id="sft-callout-tokens"></span> trained tokens · Nebius serverless LoRA inference needs beta access
    </div>

    <details class="extras">
      <summary>Appendix (training details, prose summarizer, Anthropic refs)</summary>

      <section class="card sft" id="sft-card" hidden>
        <h2>SFT training (v0.2 schema, Nebius LoRA)</h2>
        <p class="hint" id="sft-sub"></p>
        <table id="sft-table" class="eval-table"></table>
        <p class="hint" id="sft-serving-note" style="color:#f1a26b;margin-top:12px"></p>
      </section>

      <section class="card prose" id="prose-card" hidden>
        <h2>Prose summarizer comparison <span class="muted">— per-bucket 'started/finished/blocked/key_decisions' bullets</span></h2>
        <p class="hint" id="prose-sub"></p>
        <div class="prose-grid">
          <div>
            <h3 class="sub-h">Bullets per section (avg)</h3>
            <div id="prose-bullets" class="chart"></div>
          </div>
          <div>
            <h3 class="sub-h">Cost + latency per model</h3>
            <table id="prose-cost" class="eval-table"></table>
          </div>
        </div>
        <h3 class="sub-h" style="margin-top:16px">Judge metrics</h3>
        <div id="prose-judge" class="chart"><p class="hint">Not yet run.</p></div>
      </section>

      <section class="card appendix" id="appendix-card" hidden>
        <h2>Anthropic refs <span class="muted">— vs Claude Opus 5.5 labels (1000 msgs, all applicable fields)</span></h2>
        <table id="appendix-table" class="eval-table"></table>
      </section>
    </details>
  </main>


<style is:global>
  :root {
    --col-cand: #5bb6ff;
    --col-ours: #ec4899;
    --col-truth: #a855f7;
    --cell-ok: #22c55e;
    --cell-mid: #eab308;
    --cell-bad: #ef4444;
  }
  .eval-page { max-width: 1400px; margin: 0 auto; padding: 16px 24px 60px; display: flex; flex-direction: column; gap: 14px; color: var(--text); }
  .eval-page .hero h1 { margin: 0 0 6px; font-size: 18px; font-weight: 700; letter-spacing: -.01em; display: flex; align-items: center; gap: 10px; }
  .eval-page .hero .status-pill { display: inline-block; font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 3px; background: #3a2d0b; color: #ffd166; text-transform: uppercase; letter-spacing: .05em; font-family: var(--mono); }
  .eval-page .hero .status-pill.live { background: #0f3524; color: #4ade80; }
  .eval-page .hero .lede { color: var(--muted); font-size: 12px; margin: 0 0 8px; }
  .eval-page .legend { display: flex; gap: 14px; font-size: 11px; color: var(--muted); font-family: var(--mono); }
  .eval-page .chip { display: inline-flex; align-items: center; gap: 5px; }
  .eval-page .chip i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; }
  .eval-page .chip-cand i { background: var(--col-cand); }
  .eval-page .chip-ours i { background: var(--col-ours); }
  .eval-page .chip-truth i { background: var(--col-truth); }

  .eval-page .kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .eval-page .kpi { background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 14px 16px; }
  .eval-page .kpi-n { font-size: 28px; font-weight: 700; font-family: var(--mono); letter-spacing: -.02em; color: var(--text); line-height: 1.1; }
  .eval-page .kpi-n.accent { color: #4ade80; }
  .eval-page .kpi-n.ours { color: var(--col-ours); }
  .eval-page .kpi-l { color: var(--muted); font-size: 11px; margin-top: 4px; }

  .eval-page .grid-2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px; }
  @media (max-width: 720px) { .eval-page .grid-2 { grid-template-columns: 1fr; } .eval-page .kpi-row { grid-template-columns: repeat(2, 1fr); } }

  .eval-page .card { background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 14px 16px; }
  .eval-page .card h2 { margin: 0 0 10px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .eval-page .card h2 .muted { color: var(--muted); font-weight: 400; text-transform: none; letter-spacing: 0; font-size: 10px; margin-left: 6px; opacity: .75; }
  .eval-page .card .chart { min-height: 40px; }
  .eval-page .hint { color: var(--muted); font-size: 11px; margin: 10px 0 0; line-height: 1.5; }
  .eval-page .hint-warn { color: #e8c88a; }
  .eval-page .hint-warn code { background: var(--panel-2); padding: 1px 5px; border-radius: 2px; font-family: var(--mono); font-size: 11px; color: #ffd166; }

  .eval-page .bar-row { display: flex; align-items: center; gap: 10px; margin: 5px 0; font-size: 11px; }
  .eval-page .bar-row .label { width: 180px; font-family: var(--mono); color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .eval-page .bar-row .track { flex: 1; display: block; height: 18px; background: var(--panel-2); border-radius: 3px; position: relative; overflow: hidden; border: 1px solid var(--border); }
  .eval-page .bar-row .fill { display: block; height: 100%; background: #5bb6ff; border-radius: 2px; transition: width .4s ease; min-width: 2px; }
  .eval-page .bar-row.ours .fill { background: #ec4899; }
  .eval-page .bar-row.truth .fill { background: #a855f7; }
  .eval-page .bar-row.pending .fill { background: #2a2a3a; min-width: 0; }
  .eval-page .bar-row .val { width: 70px; text-align: right; font-family: var(--mono); font-size: 11px; color: var(--text); }
  .eval-page .bar-row.ours .val, .eval-page .bar-row.ours .label { color: var(--col-ours); }
  .eval-page .bar-row.truth .val, .eval-page .bar-row.truth .label { color: var(--col-truth); }
  .eval-page .bar-row.pending .val { color: var(--muted); font-style: italic; }

  .eval-page .hm { display: grid; gap: 2px; font-family: var(--mono); font-size: 11px; }
  .eval-page .hm .hm-head { font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .03em; background: transparent; text-align: center; padding: 4px 6px; font-size: 10px; }
  .eval-page .hm .hm-model { text-align: right; color: var(--text); font-weight: 500; background: transparent; padding: 4px 10px 4px 0; font-size: 11px; }
  .eval-page .hm .hm-model.ours { color: var(--col-ours); }
  .eval-page .hm .hm-cell { padding: 6px 4px; text-align: center; border-radius: 3px; color: #0a0a0f; font-weight: 600; font-size: 11px; font-variant-numeric: tabular-nums; }
  .eval-page .hm .hm-pending { color: var(--muted); background: var(--panel-2); font-style: italic; font-weight: 400; }

  .eval-page .pareto { width: 100%; height: 220px; }
  .eval-page .pareto .ax { stroke: var(--border); stroke-width: 1; }
  .eval-page .pareto .gl { stroke: var(--border); stroke-width: 1; stroke-dasharray: 2,3; opacity: .5; }
  .eval-page .pareto .axt { fill: var(--muted); font: 10px var(--mono); }
  .eval-page .pareto .dot-label { fill: var(--text); font: 10px var(--mono); }

  .eval-page .eval-table { width: 100%; border-collapse: collapse; font-size: 12px; font-family: var(--mono); table-layout: auto; }
  .eval-page .eval-table th { text-align: left; color: var(--muted); font-weight: 500; padding: 6px 10px 6px 0; border-bottom: 1px solid var(--border); font-size: 10px; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
  .eval-page .eval-table td { padding: 6px 10px 6px 0; border-bottom: 1px solid rgba(255,255,255,.04); color: var(--text); white-space: nowrap; }
  .eval-page .eval-table th.r, .eval-page .eval-table td.r { text-align: right; }
  .eval-page .eval-table tr:last-child td { border-bottom: none; }
  .eval-page .eval-table tr.ours td { color: var(--col-ours); }
  .eval-page .eval-table tr.truth td { color: var(--col-truth); }

  .eval-page .headline-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 10px; }
  .eval-page .hl { background: var(--panel-2); border: 1px solid var(--border); border-radius: 4px; padding: 10px 12px; }
  .eval-page .hl-n { font-size: 24px; font-weight: 700; font-family: var(--mono); color: #4ade80; letter-spacing: -.02em; line-height: 1.1; }
  .eval-page .hl-l { color: var(--muted); font-size: 10px; margin-top: 3px; }
  .eval-page .ours-text { color: var(--col-ours); font-weight: 600; }

  .eval-page .callout { background: rgba(241, 162, 107, 0.08); border: 1px solid rgba(241, 162, 107, 0.25); border-left: 3px solid #f1a26b; border-radius: 4px; padding: 10px 14px; font-size: 12px; color: var(--text); }

  .eval-page .extras { margin-top: 14px; }
  .eval-page .extras > summary { cursor: pointer; color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; padding: 8px 12px; background: var(--panel); border: 1px solid var(--border); border-radius: 4px; list-style: none; }
  .eval-page .extras > summary::-webkit-details-marker { display: none; }
  .eval-page .extras > summary::before { content: "▸ "; color: var(--muted); }
  .eval-page .extras[open] > summary::before { content: "▾ "; }
  .eval-page .extras[open] > .card { margin-top: 10px; }

  .eval-page .prose-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 12px; }
  .eval-page .sub-h { font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin: 0 0 8px; }
  .eval-page .prose-bullets-tbl { width: 100%; font-size: 11px; font-family: var(--mono); border-collapse: collapse; }
  .eval-page .prose-bullets-tbl th { font-weight: 500; text-align: right; color: var(--muted); padding: 3px 6px; font-size: 10px; text-transform: uppercase; }
  .eval-page .prose-bullets-tbl td { padding: 3px 6px; border-bottom: 1px solid rgba(255,255,255,.04); color: var(--text); }
  .eval-page .prose-bullets-tbl td.lbl { font-weight: 500; }
  .eval-page .prose-bullets-tbl td.r { text-align: right; }
</style>

<script is:inline>
  (async function initEval() {
    const sub = document.getElementById("eval-sub");
    const statusPill = document.getElementById("eval-status");
    let data = null, liveData = null;
    try {
      const [r, lr] = await Promise.all([
        fetch("/data/compare_v2.json?cb=" + Date.now()),
        fetch("/data/eval/live_results.json?cb=" + Date.now()).catch(() => null),
      ]);
      if (!r.ok) throw new Error("HTTP " + r.status);
      data = await r.json();
      if (lr && lr.ok) liveData = await lr.json();
    } catch (e) {
      sub.textContent = "no compare_v2.json yet — run scripts/compare_models.py";
      return;
    }

    const LIVE_SLUG_MAP = {
      "qwen3_30b_a3b": "qwen_30b", "nemotron_nano_30b": "nemotron_30b", "gemma3_27b": "gemma_27b",
      "qwen3_235b": "qwen_235b", "deepseek_v4": "deepseek_flash", "qwen14b_r16": "qwen_sft_r16",
      "qwen14b_r32": "qwen_sft_r32", "qwen3_14b": "qwen_14b",
    };
    const liveBySlug = new Map();
    for (const [key, row] of Object.entries(liveData || {})) {
      if (!row || row.status !== "real") continue;
      const m = key.match(/^(?:baseline_)?(.+)@(.+)$/);
      if (!m) continue;
      const [, rawSlug, endpoint] = m;
      const slug = LIVE_SLUG_MAP[rawSlug] || rawSlug;
      const perField = {};
      for (const [f, f1] of Object.entries(row.macro_f1_per_field || {})) {
        perField[f] = { macro_f1: f1, accuracy: f1, jaccard: f1 };
      }
      liveBySlug.set(slug, {
        slug,
        alignment_rate: (row.exact_match_pct || 0) / 100,
        per_field: perField,
        cost_per_1k_msgs_usd: row.cost_per_1k_rows_usd ?? 0,
        api_errors: row.api_errors || 0,
        parse_errors: row.parse_errors || 0,
        n_rows: row.rows_scored || row.rows_total || 0,
        latency_p50_ms: row.latency_p50_ms,
        _live: true, _endpoint: endpoint,
      });
    }

    const EXPECTED = ["gemma_27b", "qwen_30b", "nemotron_30b", "deepseek_flash", "qwen_235b", "qwen_14b", "qwen_sft_r16", "qwen_sft_r32"];
    const LABELS = {
      "gemma_27b": "Gemma-3-27B", "qwen_30b": "Qwen3-30B-A3B (labeler)", "nemotron_30b": "Nemotron-Nano-30B",
      "deepseek_flash": "DeepSeek-V4-Flash", "qwen_235b": "Qwen3-235B-A22B", "qwen_14b": "Qwen3-14B base",
      "qwen_sft_r16": "Qwen3-14B-SFT r=16", "qwen_sft_r32": "Qwen3-14B-SFT r=32",
    };
    const OURS = new Set(["qwen_sft_r16", "qwen_sft_r32"]);

    // Only the 685-message holdout rows (live_results): the Opus-gold rows are a different message set, shown in the Stage 1 table.
    const byslug = new Map();
    for (const [slug, lrow] of liveBySlug) byslug.set(slug, lrow);

    // KPI tiles
    const scored = EXPECTED.filter((s) => byslug.get(s));
    document.getElementById("kpi-cands").textContent = `${scored.length} / ${EXPECTED.length}`;
    const nHold = Math.max(0, ...[...byslug.values()].map((r) => r.n_rows || 0));
    document.getElementById("kpi-rows").textContent = nHold.toLocaleString();
    const totalCost = scored.reduce((a, s) => a + (byslug.get(s)?.cost_per_1k_msgs_usd || 0), 0);
    document.getElementById("kpi-spent").textContent = `$${totalCost.toFixed(2)}`;
    document.getElementById("kpi-headroom").textContent = `$${Math.max(0, 10 - totalCost).toFixed(2)}`;
    const ours = byslug.get("qwen_sft_r16") || byslug.get("qwen_sft_r32");
    document.getElementById("kpi-ours").textContent = ours ? `${(ours.alignment_rate*100).toFixed(1)}%` : "—";
    const gen = new Date(data.generated_at).toLocaleString();
    const liveCount = liveData ? Object.values(liveData).filter((x) => x && x.status === "real").length : 0;
    sub.textContent = `${scored.length} candidates · ${nHold.toLocaleString()} held-out messages labeled by Qwen3-30B-A3B (pseudo-labels, not a frontier reference)`;
    statusPill.textContent = liveCount > 0 ? `${liveCount} live` : "mock";
    if (liveCount > 0) statusPill.classList.add("live");

    // Alignment bars — the pseudo-label reference pinned to top (100%), rest sorted desc
    const alignEl = document.getElementById("chart-alignment");
    const alignRows = EXPECTED.filter((s) => byslug.get(s)).map((s) => ({ slug: s, r: byslug.get(s), v: byslug.get(s)?.alignment_rate ?? -1 }))
      .sort((a, b) => b.v - a.v);
    const truthRow = `<div class="bar-row truth">
      <span class="label">Qwen3-30B labels (ref)</span>
      <span class="track"><span class="fill" style="width:100%"></span></span>
      <span class="val">100%</span>
    </div>`;
    alignEl.innerHTML = truthRow + alignRows.map(({ slug, r }) => {
      const cls = !r ? "pending" : (OURS.has(slug) ? "ours" : "");
      const val = r ? (r.alignment_rate * 100) : 0;
      return `<div class="bar-row ${cls}">
        <span class="label" title="${LABELS[slug]}">${LABELS[slug]}</span>
        <span class="track"><span class="fill" style="width:${Math.min(100, val).toFixed(1)}%"></span></span>
        <span class="val">${r ? val.toFixed(1) + "%" : "pending"}</span>
      </div>`;
    }).join("");

    // Per-field grouped bar chart — macro-F1 vs the Qwen3-30B pseudo-labels per field
    (function renderAgreement() {
      const el = document.getElementById("chart-agreement");
      if (!el) return;
      const AG_FIELDS = ["user_intent", "agent_intent", "agent_role", "blocker_type", "urgency"];
      // Each model gets a color; models without data are left out.
      const MODELS = [
        { slug: "qwen_30b", label: "Qwen3-30B", color: "#5bb6ff" },
        { slug: "qwen_235b", label: "Qwen3-235B", color: "#8ab4f8" },
        { slug: "gemma_27b", label: "Gemma-3-27B", color: "#ffb86c" },
        { slug: "nemotron_30b", label: "Nemotron-30B", color: "#f87171" },
        { slug: "deepseek_flash", label: "DeepSeek-V4", color: "#b084f0" },
        { slug: "qwen_14b", label: "Qwen3-14B base", color: "#9ca3af" },
        { slug: "qwen_sft_r16", label: "Qwen3-14B-SFT (ours)", color: "#ec4899" },
      ];
      const W = 820, H = 300, M = { l: 44, r: 10, t: 14, b: 70 };
      const chartW = W - M.l - M.r, chartH = H - M.t - M.b;
      const nFields = AG_FIELDS.length;
      const groupW = chartW / nFields;
      const activeModels = MODELS.filter(m => m.pending || byslug.get(m.slug)?.per_field);
      const barW = Math.max(2, (groupW - 10) / activeModels.length);
      const getVal = (slug, field) => {
        const r = byslug.get(slug);
        if (!r || !r.per_field || !r.per_field[field]) return null;
        const pf = r.per_field[field];
        const v = pf.accuracy ?? pf.macro_f1;
        return v == null ? null : v * 100;
      };
      let svg = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet" style="width:100%;height:auto;max-height:340px;display:block">`;
      // Y gridlines + labels (0, 25, 50, 75, 100)
      for (let p = 0; p <= 100; p += 25) {
        const y = M.t + chartH - (p / 100) * chartH;
        svg += `<line x1="${M.l}" x2="${W - M.r}" y1="${y}" y2="${y}" stroke="#2a2a3a" stroke-width="0.6" stroke-dasharray="2,3" opacity="0.6"/>`;
        svg += `<text x="${M.l - 6}" y="${y + 3}" text-anchor="end" font-family="SF Mono,Menlo,monospace" font-size="10" fill="#8a8aa0">${p}%</text>`;
      }
      // X axis field labels + bars
      AG_FIELDS.forEach((field, fi) => {
        const gx = M.l + fi * groupW + 5;
        const labelX = gx + (groupW - 10) / 2;
        const labelY = M.t + chartH + 14;
        svg += `<text x="${labelX}" y="${labelY}" text-anchor="middle" font-family="SF Mono,Menlo,monospace" font-size="10" fill="#e8e8f0">${field.replace("_", " ")}</text>`;
        activeModels.forEach((m, mi) => {
          const x = gx + mi * barW;
          const v = m.pending ? null : getVal(m.slug, field);
          if (v == null) {
            svg += `<rect x="${x}" y="${M.t + chartH - 2}" width="${barW - 1}" height="2" fill="#2a2a3a" opacity="0.4"/>`;
          } else {
            const h = (v / 100) * chartH;
            const y = M.t + chartH - h;
            svg += `<rect x="${x}" y="${y}" width="${barW - 1}" height="${h}" fill="${m.color}" opacity="0.9"><title>${m.label} · ${field}: ${v.toFixed(1)}%</title></rect>`;
          }
        });
      });
      svg += `<line x1="${M.l}" x2="${W - M.r}" y1="${M.t + chartH}" y2="${M.t + chartH}" stroke="#4a4a5e" stroke-width="1"/>`;
      // Legend (bottom)
      const legY = H - 18;
      let legX = M.l;
      activeModels.forEach((m) => {
        const txt = m.label;
        const chipW = Math.max(60, txt.length * 5.5) + 18;
        svg += `<rect x="${legX}" y="${legY - 7}" width="10" height="10" fill="${m.color}" opacity="${m.pending ? 0.4 : 0.9}"/>`;
        svg += `<text x="${legX + 14}" y="${legY + 1}" font-family="SF Mono,Menlo,monospace" font-size="9" fill="${m.pending ? "#6a6a7a" : "#e8e8f0"}">${txt}</text>`;
        legX += chipW;
        if (legX > W - 100) { legX = M.l; legY /* no wrap support, keep inline */; }
      });
      svg += `</svg>`;
      el.innerHTML = svg;
    })();

    // Macro F1 heatmap — traffic light coloring
    const hm = document.getElementById("chart-heatmap");
    const fields = ["user_intent", "agent_intent", "agent_role", "blocker_type", "urgency"];
    const colorFor = (v) => {
      if (v == null) return { bg: "var(--panel-2)", fg: "var(--muted)" };
      if (v >= 0.70) return { bg: "#22c55e", fg: "#0a2b14" };
      if (v >= 0.55) return { bg: "#eab308", fg: "#2a1f04" };
      return { bg: "#f87171", fg: "#2b0a0a" };
    };
    const grid = document.createElement("div");
    grid.className = "hm";
    grid.style.gridTemplateColumns = "180px repeat(" + fields.length + ", 1fr)";
    grid.innerHTML = `<div class="hm-head"></div>` + fields.map((f) => `<div class="hm-head">${f}</div>`).join("");
    // Reference row at the top — perfect by definition
    grid.innerHTML += `<div class="hm-model" style="color:#a855f7">Qwen3-30B labels (ref)</div>` +
      fields.map(() => `<div class="hm-cell" style="background:#a855f7;color:#f5e9ff" title="truth reference">1.00</div>`).join("");
    for (const slug of EXPECTED.filter((s) => byslug.get(s))) {
      const r = byslug.get(slug);
      const mcls = OURS.has(slug) ? "hm-model ours" : "hm-model";
      grid.innerHTML += `<div class="${mcls}">${LABELS[slug]}${OURS.has(slug) ? "*" : ""}</div>`;
      for (const f of fields) {
        if (!r || !r.per_field || !r.per_field[f]) {
          grid.innerHTML += `<div class="hm-cell hm-pending">—</div>`; continue;
        }
        const pf = r.per_field[f];
        const v = (f === "agent_role") ? (pf.jaccard ?? pf.macro_f1) : pf.macro_f1;
        const c = colorFor(v);
        grid.innerHTML += `<div class="hm-cell" style="background:${c.bg};color:${c.fg}" title="${slug} · ${f}">${v != null ? v.toFixed(2) : "—"}</div>`;
      }
    }
    hm.innerHTML = ""; hm.appendChild(grid);

    // Cost bars (sorted desc so expensive at top)
    const costEl = document.getElementById("chart-cost");
    const costRows = EXPECTED.map((s) => ({ slug: s, r: byslug.get(s), c: byslug.get(s)?.cost_per_1k_msgs_usd ?? -1 }))
      .filter((x) => x.c > 0).sort((a, b) => b.c - a.c);
    const maxCost = Math.max(...costRows.map((x) => x.c), 0.01);
    costEl.innerHTML = costRows.map(({ slug, r, c }) => {
      const cls = OURS.has(slug) ? "ours" : "";
      return `<div class="bar-row ${cls}">
        <span class="label">${LABELS[slug]}</span>
        <span class="track"><span class="fill" style="width:${(c/maxCost*100).toFixed(1)}%"></span></span>
        <span class="val">$${c.toFixed(4)}</span>
      </div>`;
    }).join("");

    // Pareto scatter — cost (log) × alignment
    const pareto = document.getElementById("chart-pareto");
    const points = EXPECTED.map((s) => ({ slug: s, r: byslug.get(s) })).filter((p) => p.r && p.r.cost_per_1k_msgs_usd > 0);
    if (points.length) {
      const W = 460, H = 220, M = { l: 50, r: 20, t: 20, b: 36 };
      const minC = Math.min(...points.map((p) => p.r.cost_per_1k_msgs_usd));
      const maxC = Math.max(...points.map((p) => p.r.cost_per_1k_msgs_usd));
      const logMin = Math.log10(minC), logMax = Math.log10(maxC);
      const xScale = (c) => M.l + (Math.log10(c) - logMin) / (logMax - logMin || 1) * (W - M.l - M.r);
      const yScale = (a) => H - M.b - (a) * (H - M.t - M.b);
      let svg = `<svg class="pareto" viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet">`;
      // Y gridlines at 0%, 20%, 40%, 60%, 80%, 100%
      for (let p = 0; p <= 1.0001; p += 0.2) {
        const y = yScale(p);
        svg += `<line class="gl" x1="${M.l}" x2="${W - M.r}" y1="${y}" y2="${y}"/>`;
        svg += `<text class="axt" x="${M.l - 6}" y="${y + 3}" text-anchor="end">${(p*100).toFixed(0)}%</text>`;
      }
      // X ticks (log) at $0.001, $0.01, $0.1, $1
      [-3,-2,-1,0,1].forEach((e) => {
        const v = Math.pow(10, e);
        if (v < minC * 0.5 || v > maxC * 2) return;
        const x = xScale(v);
        svg += `<line class="gl" x1="${x}" x2="${x}" y1="${M.t}" y2="${H - M.b}"/>`;
        svg += `<text class="axt" x="${x}" y="${H - M.b + 14}" text-anchor="middle">$${v < 1 ? v.toFixed(e < -1 ? 3 : 2) : v.toFixed(0)}</text>`;
      });
      svg += `<text class="axt" x="${M.l}" y="${H - 4}">cost per 1K msgs (log)</text>`;
      svg += `<text class="axt" x="${M.l - 42}" y="${M.t + 10}">alignment</text>`;
      // Dots
      for (const { slug, r } of points) {
        const x = xScale(r.cost_per_1k_msgs_usd);
        const y = yScale(r.alignment_rate);
        const color = OURS.has(slug) ? "var(--col-ours)" : "var(--col-cand)";
        svg += `<circle cx="${x}" cy="${y}" r="5" fill="${color}" stroke="#0a0a0f" stroke-width="1.5"/>`;
        svg += `<text class="dot-label" x="${x + 8}" y="${y - 6}">${LABELS[slug].replace(/\s\(.*\)/,"")}</text>`;
      }
      // Reference at (high cost, 100%)
      const opusX = xScale(maxC * 1.5); // off-chart indicator
      svg += `<circle cx="${Math.min(opusX, W - M.r - 10)}" cy="${yScale(1)}" r="5" fill="var(--col-truth)" stroke="#0a0a0f" stroke-width="1.5"/>`;
      svg += `<text class="dot-label" x="${Math.min(opusX, W - M.r - 10) - 8}" y="${yScale(1) - 8}" text-anchor="end" fill="var(--col-truth)">Qwen3-30B labels (ref)</text>`;
      svg += `</svg>`;
      pareto.innerHTML = svg;
    } else {
      pareto.innerHTML = `<p class="hint">no scored candidates yet</p>`;
    }

    // Latency table
    const ltbl = document.getElementById("latency-table");
    ltbl.innerHTML = "<thead><tr><th>model</th><th class='r'>p50 ms</th><th class='r'>cost / 1K</th><th class='r'>rows scored</th></tr></thead>";
    const ltbody = document.createElement("tbody");
    const lrows = EXPECTED.map((s) => ({ slug: s, r: byslug.get(s) })).filter((x) => x.r && x.r.latency_p50_ms)
      .sort((a, b) => (a.r.latency_p50_ms || 1e9) - (b.r.latency_p50_ms || 1e9));
    for (const { slug, r } of lrows) {
      const cls = OURS.has(slug) ? "ours" : "";
      const tr = document.createElement("tr"); tr.className = cls;
      tr.innerHTML = `<td>${LABELS[slug]}</td>
        <td class='r'>${r.latency_p50_ms}</td>
        <td class='r'>$${r.cost_per_1k_msgs_usd.toFixed(4)}</td>
        <td class='r'>${r.n_rows}</td>`;
      ltbody.appendChild(tr);
    }
    // Reference row (synthetic — the labeler itself)
    const opusTr = document.createElement("tr"); opusTr.className = "truth";
    opusTr.innerHTML = `<td>Qwen3-30B labels (ref)</td><td class='r'>—</td><td class='r'>—</td><td class='r'>${nHold.toLocaleString()}</td>`;
    ltbody.appendChild(opusTr);
    ltbl.appendChild(ltbody);

    // Headline story — compute from real data
    const ourR = byslug.get("qwen_sft_r16");
    const baseR = byslug.get("qwen_14b");
    const flagR = byslug.get("qwen_235b") || byslug.get("qwen_30b");
    if (ourR && flagR && ourR.cost_per_1k_msgs_usd > 0 && flagR.cost_per_1k_msgs_usd > 0) {
      const cheaper = (flagR.cost_per_1k_msgs_usd / ourR.cost_per_1k_msgs_usd);
      document.getElementById("hl-1").textContent = `${cheaper.toFixed(1)}×`;
    }
    if (ourR && flagR && ourR.latency_p50_ms && flagR.latency_p50_ms) {
      document.getElementById("hl-2").textContent = `${(flagR.latency_p50_ms / ourR.latency_p50_ms).toFixed(1)}×`;
    } else if (ourR && ourR.latency_p50_ms) {
      document.getElementById("hl-2").textContent = `${ourR.latency_p50_ms}ms`;
    }
    if (ourR && baseR) {
      const uplift = (ourR.alignment_rate - baseR.alignment_rate) * 100;
      const sign = uplift >= 0 ? "+" : "";
      document.getElementById("hl-3").textContent = `${sign}${uplift.toFixed(1)}pp`;
    }

    // --- APPENDIX: SFT training ---
    try {
      const sfr = await fetch("/data/sft_final.json?cb=" + Date.now());
      if (sfr.ok) {
        const sft = await sfr.json();
        document.getElementById("sft-card").hidden = false;
        const totalTok = (sft.jobs || []).reduce((a, j) => a + (j.trained_tokens || 0), 0);
        document.getElementById("sft-sub").textContent =
          `${sft.jobs.length} LoRA jobs · ${(totalTok/1e6).toFixed(2)}M total trained tokens`;
        const cal = document.getElementById("sft-callout");
        if (cal) { cal.hidden = false; const t = document.getElementById("sft-callout-tokens"); if (t) t.textContent = (totalTok/1e6).toFixed(2) + "M"; }
        const stbl = document.getElementById("sft-table");
        stbl.innerHTML = "<thead><tr><th>label</th><th>base model</th><th>r/α</th><th class='r'>trained tokens</th><th class='r'>duration</th><th>status</th></tr></thead>";
        const sbody = document.createElement("tbody");
        for (const j of sft.jobs) {
          const dur = j.duration_sec ? `${Math.floor(j.duration_sec/60)}m ${j.duration_sec%60}s` : "—";
          const tr = document.createElement("tr");
          tr.innerHTML = `<td>${j.label}</td><td>${j.model}</td>
            <td>${j.hyperparameters?.lora_r || "—"}/${j.hyperparameters?.lora_alpha || "—"}</td>
            <td class='r'>${(j.trained_tokens || 0).toLocaleString()}</td>
            <td class='r'>${dur}</td>
            <td style='color:#7ed07e'>${j.status}</td>`;
          sbody.appendChild(tr);
        }
        stbl.appendChild(sbody);
        document.getElementById("sft-serving-note").textContent = sft.serving_blocked_note || "";
      }
    } catch (e) {}

    // --- APPENDIX: Prose summarizer ---
    try {
      const pr = await fetch("/data/prose_compare.json?cb=" + Date.now());
      if (pr.ok) {
        const prose = await pr.json();
        const slugs = Object.keys(prose.candidates || {});
        if (slugs.length) {
          document.getElementById("prose-card").hidden = false;
          document.getElementById("prose-sub").textContent =
            `${prose.n_items_per_model} bucket summaries per model · ${slugs.length} models scored`;
          const sections = ["started", "finished", "blocked", "key_decisions"];
          const tbl = document.createElement("table");
          tbl.className = "prose-bullets-tbl";
          tbl.innerHTML = "<thead><tr><th></th>" + sections.map((s) => `<th>${s}</th>`).join("") + "</tr></thead>";
          const tbody = document.createElement("tbody");
          for (const slug of slugs) {
            const c = prose.candidates[slug];
            const tr = document.createElement("tr");
            tr.innerHTML = `<td class="lbl">${slug}</td>` +
              sections.map((s) => `<td class="r">${(c.bullets_per_section_avg && c.bullets_per_section_avg[s] != null) ? c.bullets_per_section_avg[s] : "—"}</td>`).join("");
            tbody.appendChild(tr);
          }
          tbl.appendChild(tbody);
          const bEl = document.getElementById("prose-bullets"); bEl.innerHTML = ""; bEl.appendChild(tbl);
          const ctbl = document.getElementById("prose-cost");
          ctbl.innerHTML = "<thead><tr><th>model</th><th class='r'>cost/1K items</th><th class='r'>avg latency</th><th class='r'>errors</th></tr></thead>";
          const ctbody = document.createElement("tbody");
          for (const slug of slugs) {
            const c = prose.candidates[slug];
            const tr = document.createElement("tr");
            tr.innerHTML = `<td>${slug}</td><td class='r'>$${c.cost_per_1k_items_usd.toFixed(4)}</td><td class='r'>${c.avg_latency_s.toFixed(1)}s</td><td class='r'>${c.errors}</td>`;
            ctbody.appendChild(tr);
          }
          ctbl.appendChild(ctbody);
        }
      }
    } catch (e) {}

    // --- APPENDIX: Anthropic refs ---
    const appx = (data.appendix || []).filter(Boolean);
    if (appx.length) {
      document.getElementById("appendix-card").hidden = false;
      const atbl = document.getElementById("appendix-table");
      atbl.innerHTML = "<thead><tr><th>model</th><th class='r'>alignment</th><th class='r'>jaccard</th><th class='r'>cost/1K msgs</th></tr></thead>";
      const atbody = document.createElement("tbody");
      for (const r of appx) {
        const aj = r.per_field.agent_role ? r.per_field.agent_role.jaccard : 0;
        const tr = document.createElement("tr");
        tr.innerHTML = `<td>${r.slug}</td><td class='r'>${(r.alignment_rate*100).toFixed(1)}%</td><td class='r'>${aj.toFixed(3)}</td><td class='r'>$${r.cost_per_1k_msgs_usd.toFixed(4)}</td>`;
        atbody.appendChild(tr);
      }
      atbl.appendChild(atbody);
    }
  })();
</script>
