---
// Prose v2 (V0.1.B hierarchical merge) accuracy in the V0.1 eval layout, read from swarm-dashboard-merge's judge reports.
import '../../styles/eval-v2.css';
import fs from 'node:fs';
import path from 'node:path';
import { ROOT } from '../../lib/v02-store';
const DIR = path.join(ROOT, 'data/v01b');
const MERGERS = [
  { key: '8b', label: 'Qwen3-8B', host: 'Modal A10G', dir: 'gamejam-day1', color: '#5bb6ff' },
  { key: '235b', label: 'Qwen3-235B-A22B', host: 'Token Factory', dir: 'gamejam-day1-q235b', color: '#ec4899' },
  { key: 'llama8b', label: 'Llama-3.1-8B', host: 'OpenRouter CoreWeave bf16', dir: 'gamejam-day1-llama8b', color: '#ffb86c' },
];
// 4th merger (free route): joins every chart once swarm-dashboard-merge writes its tree; agreement fills in when agree_merge adds its key.
const NEMO = { key: 'nemo', label: 'Nemotron 3 Ultra 550B-A55B (untuned; also a LoRA teacher)', host: 'free route; list-priced on the Summary tab', dir: 'gamejam-day1-nemotron-ultra', color: '#4ade80' };
const nemoLanded = fs.existsSync(path.join(DIR, NEMO.dir, 'merge_tree.json'));
if (nemoLanded) MERGERS.push(NEMO);
const JUDGES = [{ key: 'haiku', label: 'Claude Haiku 4.5 (cross-family)', file: 'judge_report_haiku.json' }, { key: 'qwen', label: 'Qwen3-235B', file: 'judge_report.json' }];
// col-day is left out: Day1 has a single all-agents-day node (n=1), not a measurement (CKL 2026-10-30).
const LEVELS = ['row-4h', 'row-day', 'col-1h', 'col-4h'];
const LEVEL_NOTE: Record<string, string> = { 'row-4h': 'agent · 4h', 'row-day': 'agent · day', 'col-1h': 'all · 1h', 'col-4h': 'all · 4h', 'col-day': 'all · day' };
// metric key, title, subtitle, higher is better
const METRICS: [string, string, string, boolean][] = [
  ['coverage_all', 'All-fact coverage', 'share of all sampled source facts kept', true],
  ['faithful', 'Faithful', 'merged bullets fully backed by their cited sources', true],
  ['unsupported', 'Unsupported', 'merged bullets the sources do not back · lower is better', false],
  ['near_dup_per_bullet', 'Near-duplicates', 'near-duplicate pairs per merged bullet · lower is better', false],
  ['verbatim_copy', 'Verbatim copy', 'merged bullets copied word for word from one source · lower is better', false],
  ['compression', 'Compression', 'merged bullets / source bullets · lower = shorter', false],
];
const read = (f: string) => { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch { return null; } };
const reports: Record<string, Record<string, any>> = {};
for (const j of JUDGES) { reports[j.key] = {}; for (const m of MERGERS) reports[j.key][m.key] = read(path.join(DIR, m.dir, j.file)); }
const trees: Record<string, any> = Object.fromEntries(MERGERS.map(m => [m.key, read(path.join(DIR, m.dir, 'merge_tree.json'))?.meta]));
// A judge is offered when it scored both Qwen mergers; a merger it did not score simply has no bars.
const judges = JUDGES.filter(j => ['8b', '235b'].every(k => reports[j.key][k]?.levels));
const scored = (j: string) => MERGERS.filter(m => reports[j]?.[m.key]?.levels);
// Comparison text for a tile: every merger except 235B, e.g. 'Qwen3-8B 63% · Llama-3.1-8B 45%'.
const vs = (f: (mk: string) => string, list = MERGERS) => list.filter(m => m.key !== '235b').map(m => `${m.label} ${f(m.key)}`).join(' · ');
const j0 = judges[0]?.key;
const lv = (j: string, m: string, l: string) => reports[j]?.[m]?.levels?.[l] ?? {};
const r2f = (v: any) => Number.isFinite(v) ? v.toFixed(2) : '—';
const pct = (v: any, d = 0) => Number.isFinite(v) ? (v * 100).toFixed(d) + '%' : '—';
const avg = (j: string, m: string, k: string) => { const v = LEVELS.map(l => lv(j, m, l)[k]).filter(Number.isFinite); return v.length ? v.reduce((a, b) => a + b, 0) / v.length : NaN; };
const count = (j: string, m: string, k: string) => LEVELS.reduce((n, l) => n + Math.round((lv(j, m, l)[k] ?? 0) * (lv(j, m, l).bullets_judged ?? 0)), 0);
const judged = (j: string, m: string) => LEVELS.reduce((n, l) => n + (lv(j, m, l).bullets_judged ?? 0), 0);
const facts = (j: string, m: string) => LEVELS.reduce((n, l) => n + (lv(j, m, l).facts_judged ?? 0), 0);
// Headline: agreement with Claude Haiku 4.5 merges of the same tree (reference), from scripts/v01b/agree_merge.py.
const agr = read(path.join(DIR, 'gamejam-day1-haiku/agreement_report.json'));
const ag = (mk: string, l: string) => agr?.levels?.[l]?.[MERGERS.find(m => m.key === mk)!.dir] ?? {};
const MULTI = LEVELS.filter(l => agr?.levels?.[l]);
const agAvg = (mk: string, k: string) => { const v = MULTI.map(l => ag(mk, l)[k]).filter(Number.isFinite); return v.length ? v.reduce((a, b) => a + b, 0) / v.length : NaN; };
const modelName = (id: string) => String(id || '').replace(/^claude-/, 'Claude ').replace(/-(\d)-(\d)-\d{8}$/, ' $1.$2').replace('haiku', 'Haiku').replace('sonnet', 'Sonnet').replace('opus', 'Opus');
const sourceBullets = lv(j0, '8b', 'col-day').source_bullets;
// Same grouped-bar SVG as the V0.1 per-field agreement chart: one group per level, one bar per merger.
function bars(j: string, key: string, big = false) { return barsBy((mk, l) => lv(j, mk, l)[key], big); }
function barsBy(get: (mk: string, l: string) => any, big = false, note: Record<string, string> = LEVEL_NOTE) {
  const two = LEVELS.some(l => note[l].includes('|')), W = big ? 820 : 520, H = (big ? 300 : 240) + (two ? 12 : 0), M = { l: 44, r: 10, t: 16, b: two ? 56 : 44 };
  const cw = W - M.l - M.r, ch = H - M.t - M.b, gw = cw / LEVELS.length, bw = Math.min(big ? 46 : 34, (gw - 16) / MERGERS.length);
  const peak = Math.max(...LEVELS.flatMap(l => MERGERS.map(m => get(m.key, l) ?? 0)));
  const top = peak > 0.5 ? 1 : peak > 0.2 ? 0.5 : peak > 0.1 ? 0.2 : 0.1;
  const mono = 'font-family="SF Mono,Menlo,monospace"';
  let s = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet" style="width:100%;height:auto;max-height:${big ? 340 : 300}px;display:block" role="img">`;
  const ticks = top === 0.5 ? 5 : 4;
  for (let i = 0; i <= ticks; i++) {
    const p = top * i / ticks, y = M.t + ch - (p / top) * ch;
    s += `<line x1="${M.l}" x2="${W - M.r}" y1="${y}" y2="${y}" stroke="#2a2a3a" stroke-width="0.6" stroke-dasharray="2,3" opacity="0.6"/><text x="${M.l - 6}" y="${y + 3}" text-anchor="end" ${mono} font-size="10" fill="#8a8aa0">${(p * 100).toFixed(top < 0.2 ? 1 : 0)}%</text>`;
  }
  LEVELS.forEach((l, li) => {
    const gx = M.l + li * gw, x0 = gx + (gw - bw * MERGERS.length) / 2;
    s += `<text x="${gx + gw / 2}" y="${M.t + ch + 15}" text-anchor="middle" ${mono} font-size="11" fill="#e8e8f0">${l}</text><text x="${gx + gw / 2}" y="${M.t + ch + 28}" text-anchor="middle" ${mono} font-size="9" fill="#8a8aa0">${note[l].split('|')[0]}</text>${note[l].includes('|') ? `<text x="${gx + gw / 2}" y="${M.t + ch + 40}" text-anchor="middle" ${mono} font-size="9" fill="#e8c88a">${note[l].split('|')[1]}</text>` : ''}`;
    MERGERS.forEach((m, mi) => {
      const v = get(m.key, l), x = x0 + mi * bw;
      if (!Number.isFinite(v)) return;
      const h = Math.max(v > 0 ? 1.5 : 0, (v / top) * ch), y = M.t + ch - h;
      s += `<rect x="${x}" y="${y}" width="${bw - 3}" height="${h}" fill="${m.color}" opacity="0.9"><title>${m.label} · ${l}: ${(v * 100).toFixed(1)}%</title></rect><text x="${x + (bw - 3) / 2}" y="${y - 4}" text-anchor="middle" ${mono} font-size="10" fill="${m.color}">${(v * 100).toFixed(v < 0.1 && v > 0 ? 1 : 0)}</text>`;
    });
  });
  return s + `<line x1="${M.l}" x2="${W - M.r}" y1="${M.t + ch}" y2="${M.t + ch}" stroke="#4a4a5e" stroke-width="1"/></svg>`;
}
---
<main class="eval-page v2eval" id="merge-eval">
  <section class="hero">
    <h1>CCT Fleet · Merge Eval <span class="status-pill live">V0.1.B</span></h1>
    <p class="lede">Hourly per-agent bullet summaries merged up a hierarchy: agent rows (4h, day) and all-agent columns (1h, 4h, day) · gamejam Day1 · {sourceBullets ?? '—'} source bullets · headline: agreement with Claude Haiku 4.5 merges; below: checks against the source bullets</p>
    <div class="hero-row">
      <div class="legend">{MERGERS.map(m => <span class="chip"><i style={`background:${m.color}`}></i> {m.label} merger</span>)}</div>
    </div>
    <p class="hint page-note">Agreement section: reference = {agr ? modelName(agr.gt_model) : 'Claude Haiku 4.5'} merges, judge = {agr ? modelName(agr.judge) : 'Claude Sonnet 4.5'}. Source checks section: reference = each node's own input bullets, judge = Claude Haiku 4.5.</p>
  </section>
  {agr ? <>
    <section class="section-head first"><h2>Agreement with Haiku merges</h2><p class="hint">Each merger's bullets compared with {modelName(agr.gt_model)} merges of the same inputs; judged by {modelName(agr.judge)} (same vendor as the GT model).</p></section>
    <section class="kpi-row three">
      <div class="kpi"><div class="kpi-n ours">{r2f(agAvg('235b', 'f1'))}</div><div class="kpi-l">F1 vs Haiku merges, mean of {MULTI.join(', ')} · 235B ({vs(mk => r2f(agAvg(mk, 'f1')))})</div></div>
      <div class="kpi"><div class="kpi-n ours">{pct(agAvg('235b', 'recall'))}</div><div class="kpi-l">Haiku bullets recovered (recall) · 235B ({vs(mk => pct(agAvg(mk, 'recall')))})</div></div>
      <div class="kpi"><div class="kpi-n accent">{pct(agAvg('235b', 'unsupported'))}</div><div class="kpi-l">unsupported candidate bullets · 235B ({vs(mk => pct(agAvg(mk, 'unsupported')))})</div></div>
    </section>
    <section class="card">
      <h2>Agreement with the reference (Claude Haiku merges) <span class="muted">— F1 per level</span></h2>
      <div class="chart" set:html={barsBy((mk, l) => ag(mk, l).f1, true)} />
    </section>
    <section class="grid-2">
      <div class="card"><h2>Recall <span class="muted">— Haiku GT bullets covered by the candidate (partly = 0.5)</span></h2><div class="chart" set:html={barsBy((mk, l) => ag(mk, l).recall, false)} /></div>
      <div class="card"><h2>Precision <span class="muted">— candidate bullets in the GT or backed by their own sources</span></h2><div class="chart" set:html={barsBy((mk, l) => ag(mk, l).precision, false)} /></div>
    </section>
    <section class="card">
      <h2>Agreement detail <span class="muted">— same sampled nodes for both candidates</span></h2>
      <div class="scroll"><table class="eval-table">
        <thead><tr><th>Merger</th><th>Level</th><th class="r">Nodes</th><th class="r">GT bullets</th><th class="r">Cand. bullets</th><th class="r">Recall</th><th class="r">Precision</th><th class="r">Strict precision</th><th class="r">Unsupported</th><th class="r">F1</th><th class="r">Failed nodes</th></tr></thead>
        <tbody>{MERGERS.map(m => LEVELS.map((l, i) => { const x = ag(m.key, l); return (
          <tr class={m.key === '235b' ? 'ours' : ''}><td>{i === 0 ? <>{m.label}<span class="host">{m.host}</span></> : ''}</td><td>{l}</td><td class="r">{x.nodes ?? '—'}</td><td class="r">{x.gt_bullets ?? '—'}</td><td class="r">{x.cand_bullets ?? '—'}</td><td class="r">{r2f(x.recall)}</td><td class="r">{r2f(x.precision)}</td><td class="r">{r2f(x.strict_precision)}</td><td class="r">{r2f(x.unsupported)}</td><td class="r">{r2f(x.f1)}</td><td class="r">{x.failed_nodes ?? '—'}</td></tr>); }))}</tbody>
      </table></div>
      <p class="hint">Failed nodes = nodes where the merger returned no valid merge (scored as empty). Precision = (bullets stated in the GT merge + bullets not in GT but backed by their cited sources) / candidate bullets; strict precision counts GT matches only; F1 uses recall and the lenient precision.</p>
    </section>
  </> : <section class="card"><p class="hint">Haiku ground-truth agreement not found.</p></section>}
  <section class="section-head">
    <div><h2>Source checks</h2><p class="hint">Each merged node checked against its own input bullets (the V0.1 hourly bullets it merges); judge selectable, default Claude Haiku 4.5.</p></div>
    {judges.length > 0 && <div class="actions"><label for="merge-judge" class="hint" style="margin:0">Judge</label><select id="merge-judge">{judges.map(j => <option value={j.key}>{j.label}</option>)}</select></div>}
  </section>
  {!judges.length ? <section class="card"><p class="hint">Judge reports not found.</p></section> : judges.map(j => (
    <div class="judge-view" data-judge={j.key} hidden={j.key !== j0}>
      <section class="kpi-row">
        <div class="kpi"><div class="kpi-n ours">{pct(lv(j.key, '235b', 'col-4h').coverage_important)}</div><div class="kpi-l">important facts kept, all agents · 4h · 235B ({vs(mk => pct(lv(j.key, mk, 'col-4h').coverage_important), scored(j.key))})</div></div>
        <div class="kpi"><div class="kpi-n ours">{pct(avg(j.key, '235b', 'coverage_important'))}</div><div class="kpi-l">important-fact coverage, mean of {LEVELS.length} levels · 235B ({vs(mk => pct(avg(j.key, mk, 'coverage_important')), scored(j.key))})</div></div>
        <div class="kpi"><div class="kpi-n accent">{scored(j.key).reduce((n, m) => n + count(j.key, m.key, 'unsupported'), 0)} / {scored(j.key).reduce((n, m) => n + judged(j.key, m.key), 0)}</div><div class="kpi-l">unsupported merged bullets, {scored(j.key).length} mergers</div></div>
        <div class="kpi"><div class="kpi-n">{pct(avg(j.key, '235b', 'verbatim_copy'))}</div><div class="kpi-l">verbatim copies · 235B ({vs(mk => pct(avg(j.key, mk, 'verbatim_copy')), scored(j.key))})</div></div>
      </section>
      <section class="card">
        <h2>Important-fact coverage by level <span class="muted">— % of judge-flagged important source facts kept in the merged node</span></h2>
        <div class="chart" set:html={bars(j.key, 'coverage_important', true)} />
        <p class="hint">Grouped bars per level, one per merger. <strong class="ours-text">Qwen3-235B</strong> in pink. The 1h per-agent cell is the source itself and is not judged.</p>
      </section>
      {[0, 2, 4].map(i => (
        <section class="grid-2">{METRICS.slice(i, i + 2).map(([k, t, sub]) => (
          <div class="card"><h2>{t} <span class="muted">— {sub}</span></h2><div class="chart" set:html={bars(j.key, k)} /></div>))}
        </section>))}
      <section class="grid-2">
        <div class="card">
          <h2>Source-check story <span class="muted">— the 3 numbers</span></h2>
          <div class="headline-grid">
            <div class="hl"><div class="hl-n">{Number.isFinite(lv(j.key, '235b', 'col-4h').coverage_important - lv(j.key, '8b', 'col-4h').coverage_important) ? '+' + ((lv(j.key, '235b', 'col-4h').coverage_important - lv(j.key, '8b', 'col-4h').coverage_important) * 100).toFixed(0) + ' pt' : '—'}</div><div class="hl-l">important facts kept at the 4h column</div></div>
            <div class="hl"><div class="hl-n">{count(j.key, '235b', 'unsupported')}</div><div class="hl-l">unsupported 235B bullets of {judged(j.key, '235b')}</div></div>
            <div class="hl"><div class="hl-n">{pct(avg(j.key, '235b', 'verbatim_copy'))}</div><div class="hl-l">235B verbatim copies (8B {pct(avg(j.key, '8b', 'verbatim_copy'))})</div></div>
          </div>
          <p class="hint">Qwen3-8B mostly selects one source bullet per merged bullet, so coverage falls as the span grows. <strong class="ours-text">Qwen3-235B</strong> merges several sources per bullet and keeps most important facts at every level.</p>
        </div>
        <div class="card how">
          <h2>How we evaluated</h2>
          <ul>
            <li><strong>Headline (top):</strong> reference = {agr ? modelName(agr.gt_model) : 'Claude Haiku 4.5'} merges of the same inputs; judge = {agr ? modelName(agr.judge) : '—'} (same vendor as the GT model); mergers = {MERGERS.map(m => m.label).join(', ')}.</li>
            <li><strong>These source-grounded checks:</strong> judge = {j.label}; reference = each node's own input bullets (the V0.1 hourly bullets it merges), not the Haiku merges.</li>
            <li>The judge sees each merged node's <strong>source bullets</strong> and its <strong>merged bullets</strong>, and only grades.</li>
            <li><strong>Coverage:</strong> up to 8 nodes per level, 40 source facts per node ({facts(j.key, '235b')} facts here). The judge flags important facts (deliverables, results, blockers, decisions) and marks each covered (1), partly (0.5) or missing (0).</li>
            <li><strong>Faithfulness:</strong> 40 merged bullets per level, each checked against the sources it cites: faithful, partial (added or shifted detail) or unsupported.</li>
            <li><strong>Copying:</strong> near-duplicates, single-source and verbatim-copy rates are counted on the merged tree itself.</li>
            <li>Both mergers get the same prompt, bullet caps and judged samples. Judge: {j.label}.</li>
          </ul>
        </div>
      </section>
    </div>))}
  <details class="extras">
    <summary>Appendix (merge runs, judges)</summary>
    <section class="grid-2">
      <div class="card">
        <h2>Merge runs <span class="muted">— from each merge tree</span></h2>
        <div class="scroll"><table class="eval-table">
          <thead><tr><th>Merger</th><th class="r">Calls</th><th class="r">Fallbacks</th><th class="r">Tokens in / out</th><th class="r">Wall time</th><th class="r">Caps / section</th></tr></thead>
          <tbody>{MERGERS.map(m => { const t = trees[m.key]; return (
            <tr class={m.key === '235b' ? 'ours' : ''}><td>{m.label}<span class="host">{m.host}</span></td><td class="r">{t?.usage?.calls ?? '—'}</td><td class="r">{t?.usage?.fallbacks ?? '—'}</td><td class="r">{t ? `${(t.usage.in / 1000).toFixed(0)}k / ${(t.usage.out / 1000).toFixed(0)}k` : '—'}</td><td class="r">{t ? (t.elapsed_s / 60).toFixed(1) + ' min' : '—'}</td><td class="r">{t ? Object.values(t.caps).join(' / ') : '—'}</td></tr>); })}</tbody>
        </table></div>
      </div>
      <div class="card">
        <h2>Judges <span class="muted">— same samples for every merger</span></h2>
        <div class="scroll"><table class="eval-table">
          <thead><tr><th>Judge</th><th class="r">Calls</th><th class="r">Judge USD (est.)</th></tr></thead>
          <tbody>{judges.map(j => <tr><td>{j.label}</td><td class="r">{MERGERS.reduce((n, m) => n + (reports[j.key][m.key]?.judge_calls ?? 0), 0)}</td><td class="r">{j.key === 'haiku' ? 'subscription' : 'USD ' + MERGERS.reduce((n, m) => n + (reports[j.key][m.key]?.judge_usd_est ?? 0), 0).toFixed(3)}</td></tr>)}</tbody>
        </table></div>
      </div>
    </section>
  </details>
</main>
<style is:global>
  .v2eval .hint.ref { margin-top: 6px; }
  .v2eval .kpi-row.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .v2eval .section-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 10px; border-top: 1px solid var(--border); padding-top: 14px; }
  .v2eval .section-head.first { border-top: 0; padding-top: 0; margin-top: 4px; display: block; }
  .v2eval .section-head .hint { margin: 4px 0 0; }
  .v2eval .page-note { margin-top: 8px; color: var(--text); }
  .v2eval .section-head h2 { margin: 0; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .v2eval .ours-text { color: var(--col-ours); font-weight: 600; }
  .v2eval .headline-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-bottom: 10px; }
  .v2eval .hl { background: var(--panel-2); border: 1px solid var(--border); border-radius: 4px; padding: 10px 12px; }
  .v2eval .hl-n { font-size: 24px; font-weight: 700; font-family: var(--mono); color: #4ade80; letter-spacing: -.02em; line-height: 1.1; }
  .v2eval .hl-l { color: var(--muted); font-size: 10px; margin-top: 3px; }
  .v2eval .how ul { margin: 0; padding-left: 18px; font-size: 12px; line-height: 1.6; color: var(--text); }
  .v2eval .how li { margin: 2px 0; } .v2eval .how strong { color: var(--text); }
  .v2eval .extras > summary { cursor: pointer; color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; padding: 8px 12px; background: var(--panel); border: 1px solid var(--border); border-radius: 4px; list-style: none; }
  .v2eval .extras > summary::-webkit-details-marker { display: none; }
  .v2eval .extras > summary::before { content: "▸ "; } .v2eval .extras[open] > summary::before { content: "▾ "; }
  .v2eval .extras[open] > .grid-2 { margin-top: 10px; }
  @media (max-width: 820px) { .v2eval .headline-grid { grid-template-columns: 1fr; } }
</style>
<script>
const sel = document.getElementById('merge-judge') as HTMLSelectElement | null;
sel?.addEventListener('change', () => document.querySelectorAll<HTMLElement>('#merge-eval .judge-view').forEach(v => { v.hidden = v.dataset.judge !== sel.value; }));
</script>
