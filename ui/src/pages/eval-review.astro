---
import Layout from '../layouts/Layout.astro';
import '../styles/v02.css';
import V02DatasetPicker from '../components/V02DatasetPicker.astro';
export const prerender=false;
---
<Layout title="V0.2 · Human-review audit">
<main class="v02">
  <header class="masthead"><div><p class="eyebrow">CCT SUMMARIZER / V0.2 EVALUATION</p><h1>Measure the facts that matter.</h1><p>Task coverage, faithful claims, identity, relationships, and state over time. Current scores audit each run against its own human reviews; cross-model rollout comparison is being prepared.</p></div><nav class="links"><a href="/eval">Model eval →</a><a href="/review">Review predictions →</a><a href="/eval-v01">V0.1 archive</a></nav></header>
    <V02DatasetPicker />
  <div class="statusbar"><span class="badge live"><span id="run-window">ACTIVE DATASET</span></span><span id="reference">Loading reference status…</span><button type="button" id="refresh-metrics">Refresh metrics</button></div>
  <p id="metrics-error" class="error" role="alert" hidden></p>
  <section class="eval-grid" style="margin-bottom:20px">
    <article class="panel stat"><small>Human-reviewed reference turns</small><div class="value" id="reviewed-count">—</div><p class="muted" id="reviewed-detail">Machine drafts await review.</p></article>
    <article class="panel stat"><small>Task F1</small><div class="value" id="task-f1">—</div><p class="muted">Review-aligned task precision and coverage.</p></article>
    <article class="panel stat"><small>Unsupported extra claims</small><div class="value" id="hallucination-rate">—</div><p class="muted">Requires source-grounded judge verdicts.</p></article>
  </section>
  <section class="panel" style="margin-bottom:20px"><div class="panel-head"><h2>New evaluation contract</h2><span class="badge">V0.2 state graph</span></div><div style="overflow:auto"><table><thead><tr><th>Dimension</th><th>Result</th><th>How it is measured</th></tr></thead><tbody id="metric-rows"><tr><td colspan="3">Loading metrics…</td></tr></tbody></table></div></section>
  <div class="eval-grid" style="grid-template-columns:1fr 1fr;margin-bottom:20px">
    <section class="panel stat"><p class="eyebrow">FAITHFULNESS ≠ REFERENCE AGREEMENT</p><h2>Three outcomes for an extra claim</h2><p style="margin-top:12px"><strong>Supported:</strong> the source backs it; the reference may be incomplete.</p><p style="margin-top:10px"><strong>Contradicted:</strong> the source says otherwise.</p><p style="margin-top:10px"><strong>Insufficient evidence:</strong> the source cannot establish it.</p><p class="muted" style="margin-top:12px">Reference-only facts are recall errors. Free-text matching and readability wait for an independent judge; empty scores never mean zero.</p></section>
    <section class="panel stat"><p class="eyebrow">TRAINING READINESS</p><h2>Review → freeze → split → train</h2><p style="margin-top:12px">Each run keeps original model labels, human corrections, and provenance separate. The Day 1 Luna run is the machine teacher baseline; it is not human-approved ground truth. Training export uses approved or corrected turns and chronological splits.</p><p class="muted" style="margin-top:12px">Paid API calls and training are disabled for this run. No model uplift or generalization claim is reported before a held-out evaluation exists.</p><a style="display:inline-block;margin-top:16px" href="/review">Build the reviewed reference →</a></section>
  </div>
  <section class="panel"><div class="panel-head"><h2>Structured field diagnostics</h2><small>Macro F1 and exact field accuracy</small></div><div style="overflow:auto"><table><thead><tr><th>Field</th><th>Macro F1</th><th>Accuracy</th><th>Examples</th></tr></thead><tbody id="field-rows"><tr><td colspan="4">Review predictions to populate field diagnostics.</td></tr></tbody></table></div></section>
  <section class="panel" style="margin-top:20px" id="quota-benchmark"><div class="panel-head"><h2>Haiku 4.5 vs Luna · quota test</h2><span id="benchmark-state" class="badge">Loading…</span></div><div style="padding:20px"><p id="benchmark-progress">Same 160 saved turn inputs. One candidate each; the baseline stays unchanged.</p><p class="muted" style="margin-top:8px">Teacher-forced comparison with native provider token counts. Format/evidence validation is not a human quality score. Quota meters are rounded and shared with other sessions.</p><div style="overflow:auto;margin-top:12px"><table><thead><tr><th>Measurement</th><th>Result</th></tr></thead><tbody id="benchmark-rows"></tbody></table></div><p class="muted" style="margin-top:10px">Claude subscription only; paid overage is disabled. No Codex labeling calls are being made by this test.</p></div></section>
  <p class="footer-note">Importance ranks use low=1, medium=2, high=3. MAE measures distance; Spearman measures whether the ordering agrees (ties receive average ranks). Constant or insufficient rankings have no correlation score.</p>
</main>
</Layout>
<script>
const $=(id:string)=>document.getElementById(id)!;
const esc=(s:any)=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
const format=(v:any,digits=2)=>Number.isFinite(v)?new Intl.NumberFormat('en-US',{maximumFractionDigits:digits}).format(v):'Not measured';
const percent=(v:any)=>Number.isFinite(v)?format(v*100,1)+'%':'Not measured';
const triplet=(v:any)=>v&&v.f1!==null?`P ${percent(v.precision)} · R ${percent(v.recall)} · F1 ${percent(v.f1)}`:'Needs reviewed reference';
async function load(){try{const response=await fetch('/api/v02/metrics'+(new URL(location.href).searchParams.has('dataset')?'?dataset='+encodeURIComponent(new URL(location.href).searchParams.get('dataset')!):''),{cache:'no-store'}),d=await response.json();if(!response.ok)throw new Error(d.error);const m=d.metrics;$('run-window').textContent=d.dataset+' · '+(d.manifest?.teacher_model||'');$('metrics-error').hidden=true;$('reference').textContent=`${d.generated_turns} generated · ${d.reviewed_turns} reviewed · ${d.rejected_turns} rejected`;$('reviewed-count').textContent=format(d.reviewed_turns,0);$('reviewed-detail').textContent=`${d.unreviewed_turns} machine drafts still need review.`;$('task-f1').textContent=percent(m.tasks.f1);$('hallucination-rate').textContent=percent(m.hallucination.unsupported_rate);
const rows=[['Task precision / recall / F1',triplet(m.tasks),'Human-maintained task references identify matching entities.'],['Importance-weighted task coverage',triplet(m.importance_weighted_tasks),'Low / medium / high weight 1 / 2 / 3.'],['Task identity resolution',triplet(m.task_identity),'Correct new, existing, or ambiguous resolution on aligned tasks.'],['Relationships',triplet(m.relationships),'Directed actor/task triples, including delegated task IDs.'],['Key decisions',triplet(m.decisions),'Human-aligned decision references; semantic matching is a separate judge step.'],['Importance MAE / Spearman',`${format(m.importance.mae)} / ${format(m.importance.spearman)}`,'Ordinal distance and rank correlation; ties use average ranks.'],['Task state transition accuracy',percent(m.state_transition_accuracy),'Final status delta versus the reviewed delta, with shared prior context.'],['Blocker fields',m.fields['blocker.present']?percent(m.fields['blocker.present'].macro_f1):'Needs reviewed reference','Presence, human-help flag, and waiting actor are evaluated separately.'],['Compression',m.compression.source_to_prediction_char_ratio?format(m.compression.source_to_prediction_char_ratio)+'× source / output chars':'Needs reviewed reference','Token estimates use characters ÷ 4 and are not provider-billed counts.'],['Unsupported extra claims',percent(m.hallucination.unsupported_rate),'Contradicted + insufficient evidence among independently judged extra claims.'],['Readability rubric','Independent judge pending','Clarity, organization, conciseness: each 1–5.']];$('metric-rows').innerHTML=rows.map(r=>`<tr><td>${esc(r[0])}</td><td class="mono">${esc(r[1])}</td><td class="muted">${esc(r[2])}</td></tr>`).join('');const fields=Object.entries(m.fields);$('field-rows').innerHTML=fields.length?fields.map(([k,v]:[string,any])=>`<tr><td>${esc(k)}</td><td class="mono">${percent(v.macro_f1)}</td><td class="mono">${percent(v.accuracy)}</td><td class="mono">${format(v.count,0)}</td></tr>`).join(''):'<tr><td colspan="4" class="muted">No human-reviewed examples yet. Approve or correct a prediction to begin.</td></tr>';
}catch(e){$('metrics-error').hidden=false;$('metrics-error').textContent=(e as Error).message;}}
async function loadBenchmark(){try{const response=await fetch('/api/v02/benchmark',{cache:'no-store'});if(!response.ok)return;const d=await response.json();$('benchmark-state').textContent=d.state||'not started';if(!d.usage)return;$('benchmark-progress').textContent=`${d.completed_calls} / ${d.planned_turns} calls completed · ${d.valid_first_pass} passed strict first-attempt format/evidence checks`+(d.error?' · '+d.error:'');const matched=d.matched_fully_lean_calls;const rows=[['Haiku total input (includes cache read + write)',format(d.usage.total_input_tokens,0)],['Haiku output',format(d.usage.output_tokens,0)],['Claude weekly meter change',format(d.weekly_delta_pp)+' percentage points'],['Claude five-hour meter change',format(d.five_hour_delta_pp)+' percentage points'],['Identical-prompt subset vs fully lean Luna',`${matched.turns} turns`],['Subset input: Haiku / Luna',`${format(matched.haiku_total_input,0)} / ${format(matched.luna_input,0)}`],['Subset output: Haiku / Luna',`${format(matched.haiku_output,0)} / ${format(matched.luna_output,0)}`]];if(d.comparison){const c=d.comparison;rows.push(['Same-prompt strict first-pass: Haiku / Luna',`${c.haiku_strict_first_pass} / ${c.luna_strict_first_pass} of ${c.fully_lean_matched_turns}`],['Same-period shared weekly meter change: Claude / Codex',`${format(c.haiku_shared_weekly_delta_pp)} / ${format(c.luna_shared_weekly_delta_pp)} percentage points · different plan capacities; includes other work`]);}$('benchmark-rows').innerHTML=rows.map(r=>`<tr><td>${esc(r[0])}</td><td class="mono">${esc(r[1])}</td></tr>`).join('');}catch{}}
$('refresh-metrics').addEventListener('click',()=>{load();loadBenchmark();});load();loadBenchmark();setInterval(loadBenchmark,10000);
</script>
