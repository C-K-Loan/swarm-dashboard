    function orderBySpawn(agents) {
      const parents = window._spawnParents;
      if (!parents || typeof parents !== "object") return { list: agents, info: new Map() };
      const byTitle = new Map();
      for (const a of agents) if (a && a.title && !byTitle.has(a.title)) byTitle.set(a.title, a);
      const kids = new Map(); // parentTitle -> [agent]
      const roots = [];
      for (const a of agents) {
        const pt = a && a.title ? parents[a.title] : null;
        if (pt && pt !== a.title && byTitle.has(pt)) { if (!kids.has(pt)) kids.set(pt, []); kids.get(pt).push(a); }
        else roots.push(a);
      }
      if (!kids.size) return { list: agents, info: new Map() };
      const out = [], info = new Map(), seen = new Set();
      const walk = (a, depth, last) => {
        if (seen.has(a)) return; seen.add(a); // cycle guard
        const ch = (kids.get(a.title) || []).filter((c) => !seen.has(c));
        info.set(a, { depth, last, kids: ch.length });
        out.push(a);
        if (window._spawnCollapsed.has(a.title)) return;
        ch.forEach((c, i) => walk(c, depth + 1, i === ch.length - 1));
      };
      roots.forEach((r) => walk(r, 0, true));
      for (const a of agents) if (!seen.has(a)) walk(a, 0, true); // cycle leftovers
      return { list: out, info };
    }

    // Render timeline with bucketing
    function cellSummaryPreview(agent, cell) {
      const rollup = hierarchy.summaryRollup(window._bucketSummaries, hierarchy.members(agent).map(a => a.id), cell.start_ts, cell.end_ts);
      const bullets = ["finished", "key_decisions", "started", "blocked"].flatMap(field => rollup.fields[field].map(b => ({ ...b, field })));
      const seen = new Set();
      const preview = bullets.filter(b => { const key = hierarchy.normalizedBullet(b.text); if (seen.has(key)) return false; seen.add(key); return true; }).slice(0, 3);
      const detail = !window._bucketSummaries ? "Saved summaries loading…" : !rollup.rows.length ? "No saved hourly summaries in this interval." : `${rollup.rows.length} saved hourly summaries · ${rollup.coveredAgents}/${hierarchy.members(agent).length} agents covered · ${rollup.uniqueBullets} unique bullets (${rollup.duplicates} exact repeats merged)`;
      return { preview, tooltip: `${detail}${preview.map(b => "\n• " + b.text).join("")}\nSelect this cell for all saved bullets and sources.` };
    }

    function renderTimeline(agents, bucketMode) {
      const el = document.getElementById("tl-chart");
      if (!el) return;
      el.innerHTML = "";
      if (!agents.length) {
        el.innerHTML = "<p class='hint' style='padding:40px;text-align:center'>No agents in this range · widen the filter</p>";
        return;
      }
      // Compute time scale from segment range
      let minTs = Infinity, maxTs = 0;
      for (const a of agents) for (const s of a.segments) {
        if (s.start_ts < minTs) minTs = s.start_ts;
        if (s.end_ts > maxTs) maxTs = s.end_ts;
      }
      if (maxTs <= minTs) maxTs = minTs + 60;

      let bucketSec = (bucketMode === "raw") ? 0 : parseInt(bucketMode);
      // --- PERF: hard safety cap on total (agents × buckets) ---
      // Gamejam hourly over all-time = 93 agents × ~1k buckets = freezes browser.
      // Auto-coarsen bucketSec one step up until cell budget fits.
      let perfBanner = "";
      if (bucketSec > 0) {
        const CELL_BUDGET = 50000;
        const UPSTEPS = [300, 900, 3600, 14400, 86400, 7*86400, 30*86400];
        const nAgents = Math.min(60, agents.length);
        const spanRaw = maxTs - minTs;
        // Only busy (agent, bucket) pairs become cells; idle runs coalesce.
        const busyCells = (sec) => {
          let n = 0;
          for (const a of agents.slice(0, nAgents)) {
            let last = -1;
            for (const s of a.segments) {
              if (s.state === "idle") continue;
              const lo = Math.max(Math.floor(s.start_ts / sec), last + 1), hi = Math.floor(s.end_ts / sec);
              if (hi >= lo) { n += hi - lo + 1; last = hi; }
              if (n > CELL_BUDGET) return n;
            }
          }
          return n;
        };
        let effSec = bucketSec;
        while (effSec > 0) {
          if (busyCells(effSec) <= CELL_BUDGET) break;
          const next = UPSTEPS.find(s => s > effSec);
          if (!next) break;
          effSec = next;
        }
        if (effSec !== bucketSec) {
          const label = effSec === 300 ? "5min" : effSec === 900 ? "15min" : effSec === 3600 ? "hour" : effSec === 14400 ? "4h" : effSec === 86400 ? "day" : `${effSec}s`;
          perfBanner = `auto-coarsened to ${label} buckets (requested size needs more than ${CELL_BUDGET} busy cells; narrow the range to keep it)`;
          bucketSec = effSec;
        }
      }
      // Align bucket boundaries to clean clock units
      if (bucketSec > 0) {
        minTs = Math.floor(minTs / bucketSec) * bucketSec;
        maxTs = Math.ceil(maxTs / bucketSec) * bucketSec;
      }
      const span = maxTs - minTs;

      // --- PERF: compact-empty-buckets remap ---
      // When toggle is on, scan each agent's segments to find busy buckets,
      // then compress long runs of empty buckets to a fixed narrow slot.
      let compactEnabled = !!window._compactEmpty && bucketSec > 0;
      let compactMap = null;        // original bucket idx -> compact position
      let compactSlots = 0;         // total "slots" in compact view
      const GAP_RUN_MIN = 3;        // compress runs of >=3 empty buckets
      const GAP_SLOT = 0.5;         // each collapsed gap takes 0.5 slot
      if (compactEnabled) {
        const totalBuckets = Math.ceil(span / bucketSec);
        const busy = new Uint8Array(totalBuckets);
        for (const a of agents) {
          for (const s of a.segments) {
            const bi = Math.max(0, Math.floor((s.start_ts - minTs) / bucketSec));
            const be = Math.min(totalBuckets - 1, Math.floor((s.end_ts - 1 - minTs) / bucketSec));
            for (let i = bi; i <= be; i++) busy[i] = 1;
          }
        }
        compactMap = new Float32Array(totalBuckets + 1);
        let pos = 0, emptyRun = 0;
        for (let i = 0; i < totalBuckets; i++) {
          if (busy[i]) {
            if (emptyRun >= GAP_RUN_MIN) pos += GAP_SLOT;
            emptyRun = 0;
            compactMap[i] = pos;
            pos += 1;
          } else {
            if (emptyRun < GAP_RUN_MIN) {
              compactMap[i] = pos;
              pos += 1;
            } else {
              // collapsed: snap to the gap-slot's left edge
              compactMap[i] = pos;
            }
            emptyRun++;
          }
        }
        compactMap[totalBuckets] = pos;
        compactSlots = Math.max(1, pos);
      }

      const labelWidth = Math.min(320, Math.max(140, Math.round((el.parentElement?.clientWidth || el.clientWidth || 1200) * 0.32)));
      // v13-X: zoom-aware row heights so thumbnails are legible per bucket size.
      const ROW_H_BY_BUCKET = { 0: 22, 300: 26, 900: 30, 3600: 36, 14400: 48, 86400: 60 };
      // Compact density (default) caps rows at 30px: name + model on line 1, fleet + id/turns/cost on line 2.
      const rowHeight = Math.min(window._rowDensity === "comfortable" ? 99 : 30, ROW_H_BY_BUCKET[bucketSec] || 36);
      // Cap rows at 60 for performance; sort already prioritizes blocked
      // Flat rows in the chosen sort (default: spawn order = first activity); spawn nesting lives in the spawn-tree widget.
      const spawn = { list: agents, info: new Map() };
      // Pin favorites to the top (stable within fav / non-fav groups). Favorites
      // are keyed by title (works for agents AND fleet/org rows since those use
      // the fleet/org name as title).
      const favs = window._favorites || new Set();
      const favsList = spawn.list.filter(a => favs.has(a.title));
      const nonFavs = spawn.list.filter(a => !favs.has(a.title));
      // The fleet's master (the agent CKL talks to, "<fleet>-master"; busiest session if several) is pinned first and
      // stays visible under the axis while rows scroll.
      const fleetSel = document.getElementById("fleet-select")?.value || "";
      const master = fleetSel ? spawn.list.filter(a => !a.members && a.title === `${fleetSel}-master`).sort((a, b) => (b.total_turns || 0) - (a.total_turns || 0))[0] : null;
      const visibleAgents = [...(master ? [master] : []), ...[...favsList, ...nonFavs].filter(a => a !== master)].slice(0, 60);
      const chartHeight = visibleAgents.length * rowHeight + 40;
      // v14-FF: continuous zoom via window._zoomMult (1 = fit viewport)
      const viewportWidth = Math.max(800, el.clientWidth || 1200);
      const baseChartWidth = viewportWidth - labelWidth - 4; // small right inset only: a wide one read as a dead strip
      // Zoom-out floor is fit-to-width: below 1 the grid ended early and left dead space on the right.
      const zoomMult = Math.max(1, Math.min(100, Number(window._zoomMult) || 1));
      let chartWidth = baseChartWidth * zoomMult;
      // Minimum cell click target per bucket — if the natural chart width would
      // smash cells below the floor, grow chartWidth so horizontal scroll kicks
      // in. Keeps turn/15min/hour views usable without pixel-mash jank.
      const MIN_CELL_PX_BY_BUCKET = { 300: 8, 900: 10, 3600: 14, 14400: 22, 86400: 42 };
      const minCellPx = MIN_CELL_PX_BY_BUCKET[bucketSec];
      if (minCellPx && bucketSec > 0) {
        const nCells = Math.max(1, Math.ceil(span / bucketSec));
        const required = nCells * minCellPx;
        if (required > chartWidth) chartWidth = required;
      }
      const width = labelWidth + chartWidth + 4;
      let xFor;
      if (compactEnabled && compactMap && compactSlots > 0) {
        // Map any ts → bucket index → compact slot position → x pixels
        xFor = (ts) => {
          const bi = (ts - minTs) / bucketSec;
          const biLo = Math.max(0, Math.min(compactMap.length - 1, Math.floor(bi)));
          const base = compactMap[biLo];
          const frac = bi - biLo;
          // Only interpolate within a single bucket slot (busy buckets occupy 1
          // slot; collapsed empties occupy 0 — so frac inside a collapsed range
          // just stays snapped to the gap edge)
          const slot = base + frac;
          return labelWidth + (slot / compactSlots) * chartWidth;
        };
      } else {
        xFor = (ts) => labelWidth + ((ts - minTs) / span) * chartWidth;
      }
      // expose for scroll handler
      renderTimeline.lastGeometry = { minTs, maxTs, span, labelWidth, chartWidth, baseChartWidth, bucketSec, rowHeight, headerY: 24, xFor };

      // Perf banner (auto-coarsen notice)
      const hStatus = document.getElementById("hierarchy-status");
      if (perfBanner && hStatus) {
        const prev = hStatus.textContent || "";
        if (!prev.includes("auto-coarsened")) hStatus.textContent = (prev ? prev + " · " : "") + perfBanner;
      }

      // Build SVG
      const parts = [`<svg width="${width}" height="${chartHeight}" xmlns="http://www.w3.org/2000/svg" style="display:block;background:var(--panel)">`];

      // X axis ticks (density-aware: scale with chartWidth so labels never overlap).
      // For day-or-wider buckets, snap tick pitch to the bucket boundary so every
      // column gets a solid divider + a clickable header → "select whole column".
      const niceSteps = [60, 300, 900, 1800, 3600, 2*3600, 4*3600, 6*3600, 12*3600, 86400, 2*86400, 7*86400, 14*86400, 30*86400, 90*86400];
      const minPitchPx = 70;
      const maxTicks = Math.max(2, Math.floor(chartWidth / minPitchPx));
      const rawStep = span / maxTicks;
      // Every non-raw bucket gets clickable column headers (CKL ask: not just day).
      const columnMode = bucketSec > 0;
      // Tick labels follow density to stay readable; dividers/hitboxes follow bucketSec.
      const stepSec = niceSteps.find(s => s >= rawStep) || niceSteps[niceSteps.length - 1];
      // Compact 24h local-time labels (no "Z", no ":00" for hour-grid).
      const tickLabel = (ts) => {
        const d = new Date(ts * 1000);
        if (stepSec >= 86400) return d.toISOString().slice(5, 10);          // "10-14"
        if (stepSec % 3600 === 0) return String(d.getUTCHours()).padStart(2, "0"); // "00".."23" UTC, matches data + selection pill
        return String(d.getUTCHours()).padStart(2, "0") + ":" + String(d.getUTCMinutes()).padStart(2, "0");
      };
      // Density-label pass: text labels + a dashed body tick, snapped to stepSec
      // Axis band: opaque header (sticky on vertical scroll via _syncSticky) so labels never sit on cell noise.
      const AXIS_H = 22;
      const axisParts = [`<rect x="${labelWidth}" y="0" width="${Math.max(0, width - labelWidth)}" height="${AXIS_H}" fill="#1c1c2b"/><line x1="${labelWidth}" y1="${AXIS_H + 0.5}" x2="${width}" y2="${AXIS_H + 0.5}" stroke="#3d3d55"/>`];
      const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
      let t = Math.ceil(minTs / stepSec) * stepSec;
      while (t <= maxTs) {
        const x = xFor(t);
        const d = new Date(t * 1000);
        const dayStart = stepSec < 86400 && d.getUTCHours() === 0 && d.getUTCMinutes() === 0;
        parts.push(`<line x1="${x}" y1="${AXIS_H}" x2="${x}" y2="${chartHeight - 10}" stroke="${dayStart ? "#5ce6c6" : "#4a4a5e"}" stroke-width="${dayStart ? 1 : 0.7}" stroke-opacity="${dayStart ? 0.45 : 1}" stroke-dasharray="${dayStart ? "" : "2 3"}"/>`);
        axisParts.push(`<line x1="${x}" y1="${AXIS_H - 7}" x2="${x}" y2="${AXIS_H}" stroke="#8a8aa6"/>`);
        axisParts.push(`<text x="${x + 3}" y="15" font-family="SF Mono,Menlo,monospace" font-size="11" font-weight="600" fill="${dayStart ? "#5ce6c6" : "#d8d8e8"}">${dayStart ? MONTHS[d.getUTCMonth()] + " " + d.getUTCDate() : tickLabel(t)}</text>`);
        t += stepSec;
      }
      // Column dividers + clickable headers at EVERY bucket boundary (any
      // non-raw bucket). Pushed last so they paint on top of row backgrounds —
      // otherwise invisible, which was the recurring bug.
      const headerDividers = [];
      if (columnMode) {
        // Thinner line + lower opacity when columns are dense (so hour-bucket
        // doesn't look like a prison fence).
        const colCount = Math.ceil((maxTs - minTs) / bucketSec);
        const dense = colCount > 32;
        const divStroke = dense ? "0.6" : "1.2";
        const divOpacity = dense ? "0.18" : "0.5";
        let b = Math.ceil(minTs / bucketSec) * bucketSec;
        while (b <= maxTs) {
          const x = xFor(b);
          const xNext = xFor(b + bucketSec);
          const colW = Math.max(0, xNext - x);
          const colLabel = tickLabel(b);
          headerDividers.push(`<line x1="${x}" y1="${AXIS_H}" x2="${x}" y2="${chartHeight - 10}" stroke="#9898b4" stroke-width="${divStroke}" stroke-opacity="${divOpacity}"/>`);
          axisParts.push(`<line x1="${x}" y1="${AXIS_H - 3}" x2="${x}" y2="${AXIS_H}" stroke="#5a5a74"/>`);
          axisParts.push(`<rect class="col-header-hit" data-col-ts="${b}" data-col-end="${b + bucketSec}" x="${x}" y="0" width="${colW}" height="${AXIS_H}" fill="transparent" style="cursor:pointer"><title>${colLabel} UTC — click to select the whole column across all agents</title></rect>`);
          b += bucketSec;
        }
      }

      // Rows
      const projColors = { gamejam: "#ffb86c", "other-project": "#00e8c6", "other-project": "#ff8c4c", "other-project": "#5cff8c" };

      // Store per-agent cells for click lookup
      const cellStore = []; // array of per-agent arrays

      const stickyParts = [], pinParts = [], pinLabelParts = [];
      visibleAgents.forEach((a, i) => {
        const y = 24 + i * rowHeight;
        // The pinned master row renders into its own groups (pinned on vertical scroll by _syncSticky).
        const rowParts = a === master ? pinParts : parts, labelParts = a === master ? pinLabelParts : stickyParts;
        rowParts.push(`<rect x="0" y="${y - 2}" width="${width}" height="${rowHeight - 1}" fill="${i % 2 ? '#15151e' : '#13131a'}"/>`);
        const safeTitle = (a.title || "").slice(0, Math.min(24, Math.floor((labelWidth - 24) / 6))).replace(/[<>&]/g, "");
        const safeProj = (a.project || "").replace(/[<>&]/g, "");
        const safeFleet = (a.fleet || "").replace(/[<>&]/g, "");
        const dotColor = projColors[a.project] || "#8a8aa0";
        const modelInfo = a.members ? { label: "", family: "other" } : computeModelLabel(a);
        const cost = Number(a.total_cost_usd || 0);
        const fp = a.level === "org" ? `${new Set(a.members.map(m => m.fleet).filter(Boolean)).size} fleets · ${a.members.filter(m => !m.fleet).length} loose · ${a.members.filter(m => hierarchyConfig.agentSources?.[m.id]?.source === "default").length} default` : [safeFleet, safeProj].filter(Boolean).join("·").slice(0, 28);
        const turnsIn = rangeTurns(a);
        const meta = `${a.members ? a.members.length + " agents" : String(a.id || "").slice(0, 12)} · ${turnsIn}t · $${cost.toFixed(cost >= 1 ? 2 : 4)}`;
        // Sidebar parts are collected and emitted after all rows in a sticky <g> (pinned on horizontal scroll)
        const sp = spawn.info.get(a) || { depth: 0, last: true, kids: 0 };
        const ox = Math.min(sp.depth, 6) * 10; // depth × 10px label offset
        const hasTree = spawn.info.size > 0;
        const tx = hasTree ? 22 : 16, cx = hasTree ? 14 : 8;
        labelParts.push(`<rect x="0" y="${y - 2}" width="${labelWidth}" height="${rowHeight - 1}" fill="${i % 2 ? '#15151e' : '#13131a'}"/>`);
        if (sp.depth > 0) labelParts.push(`<text x="${2 + ox - 10 + 1}" y="${y + 11}" font-family="SF Mono,Menlo,monospace" font-size="10" fill="#4a4a5a">${sp.last ? "└" : "├"}</text>`);
        labelParts.push(`<circle cx="${cx + ox}" cy="${y + 7}" r="3" fill="${dotColor}"/>`);
        const titleStr = safeTitle.slice(0, Math.max(8, 24 - Math.floor(ox / 6)));
        labelParts.push(`<text x="${tx + ox}" y="${y + 11}" font-family="SF Mono,Menlo,monospace" font-size="10" fill="#a855f7">${titleStr}</text>`);
        if (modelInfo.label && labelWidth >= 240) {
          labelParts.push(`<text x="${labelWidth - 6}" y="${y + 11}" text-anchor="end" font-family="SF Mono,Menlo,monospace" font-size="9" fill="${modelColor(modelInfo.family)}"><title>${modelInfo.tooltip}</title>${modelInfo.label}</text>`);
        }
        if (rowHeight >= 30 && labelWidth < 240) {
          labelParts.push(`<text x="${tx + ox}" y="${y + 22}" font-family="SF Mono,Menlo,monospace" font-size="8.5" fill="#8a8aa0">${a.members ? a.members.length + " agents" : turnsIn + " turns"}</text>`);
        } else if (rowHeight >= 30) {
          labelParts.push(`<text x="${tx + ox}" y="${y + 22}" font-family="SF Mono,Menlo,monospace" font-size="8.5" fill="#8a8aa0">${fp}</text>`);
          labelParts.push(`<text x="${labelWidth - 6}" y="${y + 22}" text-anchor="end" font-family="SF Mono,Menlo,monospace" font-size="8.5" fill="#6a6a7a">${meta}</text>`);
        }
        // v14-II+: clickable row-label hitbox (whole label strip for this agent) — select entire row
        labelParts.push(`<rect class="row-label" data-agent-row-i="${i}" x="0" y="${y - 2}" width="${labelWidth}" height="${rowHeight - 1}" fill="transparent" style="cursor:pointer"><title>${escapeHtml(a.title)} — click to select whole row${a.level === "org" ? "; source: " + escapeHtml(hierarchyConfig.source || "explicit membership") : ""}</title></rect>`);
        // Favorite star — rendered AFTER row-label so it sits on top in SVG stacking
        // order and the row-select handler doesn't swallow its clicks. 20% bigger
        // than title text, with a 20×rowH invisible hitbox so it's easy to hit.
        const isFav = favs.has(a.title);
        const starX = tx + ox + titleStr.length * 6 + 8;
        const starHitW = 20;
        labelParts.push(`<g class="row-fav" data-fav-title="${(a.title || "").replace(/"/g, "&quot;")}" style="cursor:pointer">
          <rect x="${starX - 4}" y="${y - 2}" width="${starHitW}" height="${rowHeight - 1}" fill="transparent"/>
          <text x="${starX}" y="${y + 12}" font-family="SF Mono,Menlo,monospace" font-size="14" fill="${isFav ? "#a855f7" : "#4a4a5a"}" style="user-select:none; pointer-events:none">★</text>
          <title>${isFav ? "unpin from top" : "pin to top"}</title>
        </g>`);
        if (sp.kids > 0) {
          const closed = window._spawnCollapsed.has(a.title);
          labelParts.push(`<text class="spawn-toggle" data-spawn-title="${(a.title || "").replace(/"/g, "&quot;")}" x="${2 + ox}" y="${y + 11}" font-family="SF Mono,Menlo,monospace" font-size="10" fill="#00e8c6" style="cursor:pointer"><title>${closed ? "expand" : "collapse"} ${sp.kids} spawned agent${sp.kids === 1 ? "" : "s"}</title>${closed ? "▸" : "▾"}</text>`);
        }

        if (bucketSec === 0) {
          // Raw per-segment mode (previous behavior)
          const agentCells = [];
          const rawCells = a.members ? hierarchy.rawGroupCells(a, bucketizeAgent) : a.segments;
          rawCells.forEach((s, j) => {
            const x = xFor(s.start_ts);
            const w = Math.max(3, xFor(s.end_ts) - x);
            const color = COLORS[s.state] || "#3a3a4a";
            const op = urgencyBoost(s);
            const extraStroke = (s.state === "blocked" || s.state === "context_exhausted")
              ? `stroke="#ffffff" stroke-opacity="0.6" stroke-width="0.5"` : "";
            const title = `${a.title} · ${s.state}${s.blocker_type ? ' ('+s.blocker_type+')' : ''} · ${s.turn_count} turns · ${(s.duration_sec/60).toFixed(1)}min`;
            rowParts.push(`<rect data-agent-i="${i}" data-cell-i="${j}" class="seg state-${s.state}" x="${x}" y="${y}" width="${w}" height="${rowHeight - 4}" fill="${color}" opacity="${op.toFixed(2)}" ${extraStroke} style="cursor:pointer"><title>${escapeHtml(title)}</title></rect>`);
            agentCells.push(s);
          });
          cellStore.push(agentCells);
        } else {
          // Bucketed mode: continuous bands, no gaps
          const buckets = bucketizeAgent(a, minTs, maxTs, bucketSec);
          const bucketCells = [];
          const minCellWidthForThumb = 10; // below this, a thumb is a smear — just show flat color
          // --- PERF: coalesce consecutive idle buckets into a single band per
          // run instead of a <rect> per bucket. For gamejam/all-time this cuts
          // 10k-50k idle rects down to a few dozen. We still push the bucket
          // metadata into bucketCells for click lookup so selection still works.
          const PERF_COALESCE = true;
          let idleRunStart = -1, idleRunEndTs = 0;
          const flushIdleRun = (upToJ) => {
            if (idleRunStart < 0) return;
            const first = buckets[idleRunStart];
            const x0 = xFor(first.start_ts);
            const xE = xFor(idleRunEndTs);
            const wR = Math.max(1, xE - x0 - 0.5);
            rowParts.push(`<rect class="seg state-idle idle-run" x="${x0}" y="${y}" width="${wR}" height="${rowHeight - 4}" fill="#3a3a4a" opacity="0.25" pointer-events="none"/>`);
            idleRunStart = -1;
          };
          buckets.forEach((b, j) => {
            if (PERF_COALESCE && b.state === "idle") {
              // Group into coalesced band; still push a cell record so clicks
              // map correctly if someone selects via column header.
              bucketCells.push(b);
              if (idleRunStart < 0) idleRunStart = j;
              idleRunEndTs = b.end_ts;
              return;
            } else if (PERF_COALESCE && idleRunStart >= 0) {
              flushIdleRun(j);
            }
            const x = xFor(b.start_ts);
            const w = Math.max(1, xFor(b.end_ts) - x - 0.5);
            const color = COLORS[b.state] || "#3a3a4a";
            const op = b.state === "idle" ? 0.35 : urgencyBoost(b);
            const bLabel = bucketSec === 300 ? "5min" : bucketSec === 900 ? "15min" : bucketSec === 3600 ? "hour" : bucketSec === 14400 ? "4h" : bucketSec === 86400 ? "day" : `${bucketSec}s`;
            const tsLabel = new Date(b.start_ts * 1000).toISOString().slice(5, 16).replace("T", " ") + "Z";
            // Try to add a background thumbnail if media exists in this bucket
            let poster = null;
            if (b.state !== "idle" && w >= minCellWidthForThumb && bucketSec >= 300) {
              poster = pickPosterForWindow(a.id, b.start_ts, b.end_ts);
            }
            const mediaCount = countMediaInWindow(a.id, b.start_ts, b.end_ts);
            const prosePreview = a.members && bucketSec >= 3600 ? cellSummaryPreview(a, b) : null;
            const title = (b.state === "idle"
              ? `${a.title} · no activity · ${tsLabel} · ${bLabel} bucket`
              : `${a.title} · ${b.state}${b.blocker_type ? ' ('+b.blocker_type+')' : ''} · ${b.turn_count} turns · ${tsLabel} · ${bLabel} bucket${mediaCount ? ' · '+mediaCount+' media' : ''}`) + (prosePreview ? '\n' + prosePreview.tooltip : '');
            if (poster && poster.web_url) {
              const clipId = `clip-${i}-${j}`;
              rowParts.push(`<clipPath id="${clipId}"><rect x="${x}" y="${y}" width="${w}" height="${rowHeight - 4}"/></clipPath>`);
              // Zoom-adaptive tint: wide cells (zoomed in) show the photo; narrow cells stay color-coded.
              // w<=20 → 0.55 tint (strong state signal), w>=120 → 0.18 tint (image clearly visible).
              const tintT = Math.max(0, Math.min(1, (w - 20) / 100));
              const tintOp = op * (0.55 - 0.37 * tintT);
              // Image opacity rises with zoom too, so detail is crisp when the cell is big.
              const imgOp = 0.88 + 0.12 * tintT;
              rowParts.push(`<image href="${poster.web_url}" x="${x}" y="${y}" width="${w}" height="${rowHeight - 4}" preserveAspectRatio="xMidYMid slice" clip-path="url(#${clipId})" opacity="${imgOp.toFixed(2)}"/>`);
              rowParts.push(`<rect x="${x}" y="${y}" width="${w}" height="${rowHeight - 4}" fill="${color}" opacity="${tintOp.toFixed(2)}" clip-path="url(#${clipId})"/>`);
              // Bottom gradient keeps state-color readable as a strip under the image when tint is low.
              if (tintT > 0.3) {
                const gradId = `g-${i}-${j}`;
                const stripH = Math.min(10, (rowHeight - 4) * 0.22);
                rowParts.push(`<linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${color}" stop-opacity="0"/><stop offset="1" stop-color="${color}" stop-opacity="${(op * 0.7).toFixed(2)}"/></linearGradient>`);
                rowParts.push(`<rect x="${x}" y="${y + (rowHeight - 4) - stripH}" width="${w}" height="${stripH}" fill="url(#${gradId})" clip-path="url(#${clipId})"/>`);
              }
              const strokeAttr = (b.state === "blocked" || b.state === "context_exhausted")
                ? `stroke="#ffffff" stroke-opacity="0.6" stroke-width="0.5"` : "";
              rowParts.push(`<rect data-agent-i="${i}" data-cell-i="${j}" class="seg state-${b.state} has-thumb" x="${x}" y="${y}" width="${w}" height="${rowHeight - 4}" fill="transparent" ${strokeAttr} style="cursor:pointer"><title>${escapeHtml(title)}</title></rect>`);
            } else {
              const extraStroke = (b.state === "blocked" || b.state === "context_exhausted")
                ? `stroke="#ffffff" stroke-opacity="0.5" stroke-width="0.5"` : "";
              rowParts.push(`<rect data-agent-i="${i}" data-cell-i="${j}" class="seg state-${b.state}" x="${x}" y="${y}" width="${w}" height="${rowHeight - 4}" fill="${color}" opacity="${op.toFixed(2)}" ${extraStroke} style="cursor:pointer"><title>${escapeHtml(title)}</title></rect>`);
            }
            if (prosePreview?.preview.length && w >= 90 && rowHeight >= 48) {
              const clipId = `prose-${i}-${j}`;
              const maxChars = Math.max(12, Math.floor((w - 14) / 5.2));
              const words = prosePreview.preview[0].text.split(/\s+/);
              const lines = [];
              const maxLines = rowHeight >= 60 ? 3 : 2;
              while (words.length && lines.length < maxLines) {
                let line = words.shift();
                while (words.length && line.length + words[0].length + 1 <= maxChars) line += " " + words.shift();
                lines.push(line.length > maxChars ? line.slice(0, maxChars - 1) + "…" : line);
              }
              if (words.length) lines[lines.length - 1] = lines[lines.length - 1].slice(0, maxChars - 1) + "…";
              rowParts.push(`<clipPath id="${clipId}"><rect x="${x + 4}" y="${y + 3}" width="${w - 8}" height="${rowHeight - 10}"/></clipPath><g class="cell-prose-preview" pointer-events="none" clip-path="url(#${clipId})"><rect x="${x + 4}" y="${y + 3}" width="${w - 8}" height="${rowHeight - 10}" fill="var(--panel)" opacity="0.9"/>${lines.map((line, lineIdx) => `<text x="${x + 8}" y="${y + 15 + lineIdx * 12}" font-family="SF Mono,Menlo,monospace" font-size="9" fill="var(--text)">${escapeHtml(line)}</text>`).join("")}</g>`);
            }
            bucketCells.push({ ...b, _bucket: bLabel });
          });
          if (PERF_COALESCE && idleRunStart >= 0) flushIdleRun(buckets.length);
          cellStore.push(bucketCells);
        }
      });
      // Column header dividers: pushed LAST so they paint on top of row cells.
      // (bright "#9898b4", width 1.5 — the previous attempts kept getting hidden
      // behind row backgrounds painted later; this finally fixes it)
      if (headerDividers.length) parts.push(headerDividers.join(""));
      if (pinParts.length) parts.push(`<g id="tl-pin-row">${pinParts.join("")}<line x1="0" y1="${24 + rowHeight - 2.5}" x2="${width}" y2="${24 + rowHeight - 2.5}" stroke="#3d3d55"/></g>`);
      parts.push(`<g id="tl-axis">${axisParts.join("")}</g>`);
      parts.push(`<g id="tl-sticky">${stickyParts.join("")}<line class="tl-sticky-edge" x1="${labelWidth - 0.5}" y1="0" x2="${labelWidth - 0.5}" y2="${chartHeight}" stroke="#2a2a3a"/><defs><linearGradient id="tl-shadow-grad" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#000" stop-opacity="0.55"/><stop offset="1" stop-color="#000" stop-opacity="0"/></linearGradient></defs><rect id="tl-sticky-shadow" x="${labelWidth}" y="0" width="10" height="${chartHeight}" fill="url(#tl-shadow-grad)" opacity="0" pointer-events="none"/></g>`);
      if (pinLabelParts.length) parts.push(`<g id="tl-pin-label">${pinLabelParts.join("")}<line x1="0" y1="${24 + rowHeight - 2.5}" x2="${labelWidth}" y2="${24 + rowHeight - 2.5}" stroke="#3d3d55"/></g>`);
      parts.push(`<g id="tl-corner"><rect x="0" y="0" width="${labelWidth}" height="${AXIS_H}" fill="#1c1c2b"/><line x1="0" y1="${AXIS_H + 0.5}" x2="${labelWidth}" y2="${AXIS_H + 0.5}" stroke="#3d3d55"/><text x="8" y="15" font-family="SF Mono,Menlo,monospace" font-size="10" fill="#8a8aa0">agents · time UTC</text>${sortToggle(labelWidth)}</g>`);
      parts.push("</svg>");
      el.innerHTML = parts.join("");
      if (window._syncSticky) window._syncSticky();

      // Click handler
      el.querySelectorAll("rect.seg").forEach((r) => {
        r.addEventListener("click", (ev) => {
          if (ev._fromMarquee) return;
          const i = parseInt(r.getAttribute("data-agent-i"));
          const j = parseInt(r.getAttribute("data-cell-i"));
          selectSingleCell(i, j, /*scrollIntoView*/ false);
        });
      });
      // v14-II+: row-label click = select whole row (all non-idle cells for that agent)
      el.querySelectorAll("rect.row-label").forEach((r) => {
        r.addEventListener("click", (ev) => {
          const i = parseInt(r.getAttribute("data-agent-row-i"));
          window._lastSelAxis = "row";
          window._lastSelRowIdx = i;
          // Drop the cell cursor so the cell-nav keydown handler bails and
          // the row-axis handler (installChartNav) takes over Up/Down.
          currentCell = null;
          selectAgentRows([i], ev.shiftKey);
        });
      });
      // Column-header click (day+ bucket): select every agent's cell in that column
      el.querySelectorAll("rect.col-header-hit").forEach((r) => {
        r.addEventListener("click", (ev) => {
          const colTs = parseInt(r.getAttribute("data-col-ts"));
          const colEnd = parseInt(r.getAttribute("data-col-end"));
          window._lastSelAxis = "col";
          window._lastSelColTs = colTs;
          window._lastSelColEnd = colEnd;
          // Drop the cell cursor so the cell-nav keydown handler bails and
          // the col-axis handler (installChartNav) takes over Left/Right.
          currentCell = null;
          selectColumn(colTs, colEnd, ev.shiftKey);
        });
      });
      el.querySelectorAll(".spawn-toggle").forEach((t) => {
        t.addEventListener("click", (ev) => {
          ev.stopPropagation();
          const title = t.getAttribute("data-spawn-title");
          const set = window._spawnCollapsed;
          if (set.has(title)) set.delete(title); else set.add(title);
          try { localStorage.setItem("cct_spawn_collapsed_v1", JSON.stringify([...set])); } catch (_) {}
          const wrap = document.querySelector(".tl-chart-wrap");
          const sl = wrap ? wrap.scrollLeft : 0, st = wrap ? wrap.scrollTop : 0;
          renderTimeline(currentAgents, currentBucket);
          if (wrap) { wrap.scrollLeft = sl; wrap.scrollTop = st; }
        });
      });
      // Favorite toggle on row label
      el.querySelectorAll(".row-fav").forEach((t) => {
        t.addEventListener("click", (ev) => {
          ev.stopPropagation();
          const title = t.getAttribute("data-fav-title");
          if (!title) return;
          const set = window._favorites;
          if (set.has(title)) set.delete(title); else set.add(title);
          try { localStorage.setItem("cct_favs_v1", JSON.stringify([...set])); } catch (_) {}
          const wrap = document.querySelector(".tl-chart-wrap");
          const sl = wrap ? wrap.scrollLeft : 0;
          renderTimeline(currentAgents, currentBucket);
          if (wrap) { wrap.scrollLeft = sl; wrap.scrollTop = 0; }
        });
      });
      // v13-Z: enable keyboard arrow navigation
      el.setAttribute("tabindex", "0");

      // Marquee drag selection
      installMarquee(el, visibleAgents, cellStore);

      // Return state for refresh helper
      renderTimeline.lastState = { visibleAgents, cellStore };
      window._paintSelectionHighlights?.();
    }

    // ===== Marquee multi-cell selection =====
    const selectionSet = new Set(); // "agentIdx-cellIdx"
    let marqueeState = null; // { startX, startY, overlayEl }
    // v13-Z: tracked single-cell cursor for arrow nav
    let currentCell = null; // { ai, ci }

    /* v14-LL universal viz selection bus
     * Every widget (timeline, comms, treemap, future vizzes) subscribes once;
     * each publish re-renders all subscribers against the same scope.
     * Scope: { agentIds: Set|null, titles: Set|null, timeRange: [a,b]|null,
     *          source: 'timeline'|'comms'|'treemap'|..., stickyElementKey: string|null }
     * Example:
     *   const unsub = window._selectionBus.subscribe((scope) => myRender(scope));
     *   window._selectionBus.publish({ agentIds: null, titles: new Set(['x']), timeRange: null, source: 'treemap', stickyElementKey: 'x' });
     */
    window._selectionBus = window._selectionBus || {
      subscribers: new Set(),
      lastScope: null,
      subscribe(fn) {
        this.subscribers.add(fn);
        // Replay the latest scope so late subscribers (comms, treemap, future
        // widgets) catch up to filter changes that fired during their own
        // init (fleetchange / orgchange from URL state). Without this, loading
        // ?org=Ghost shows a scoped timeline but an unfiltered comms graph
        // until the user touches a dropdown.
        if (this.lastScope) {
          try { fn(this.lastScope); } catch (e) { console.warn("selectionBus late-subscriber replay error:", e); }
        }
        return () => this.subscribers.delete(fn);
      },
      // Global labels run (prompt + model dropdowns in the header); separate channel so a switch keeps the selection.
      labels: null,
      labelSubs: new Set(),
      subscribeLabels(fn) { this.labelSubs.add(fn); return () => this.labelSubs.delete(fn); },
      setLabels(run) {
        if (run === this.labels) return;
        this.labels = run;
        this.labelSubs.forEach((fn) => { try { fn(run); } catch (e) { console.warn("selectionBus labels subscriber error:", e); } });
      },
      publish(scope) {
        this.lastScope = scope;
        this.subscribers.forEach((fn) => { try { fn(scope); } catch (e) { console.warn("selectionBus subscriber error:", e); } });
      },
    };

    function updateSpawnTree(scope = window._selectionBus.lastScope) {
      const body = document.getElementById("st-body");
      const fleet = document.getElementById("fleet-select")?.value || "";
      const org = document.getElementById("org-select")?.value || "";
      const q = document.getElementById("agent-filter")?.value || "";
      const range = document.getElementById("range-select")?.value || "all";
      let filtered = filterFleet(filterOrg(filterText(data.agents, q), org), fleet);
      // Explicit selections describe agents even if they have no turns in this interval.
      if (!scope?.titles && !scope?.agentIds && !fleet && !org) filtered = filterRange(filtered, range);
      const grouped = scope?.source === "fleet-filter" || scope?.source === "org-filter" ||
        !!scope?.stickyElementKey?.startsWith("org:") || scope?.stickyElementKey === fleet && !!fleet;
      const tree = window.SpawnTree.selectSpawnTree(data.agents, filtered, window._spawnParents, scope, grouped);
      const result = window.SpawnTree.renderSpawnTree(body, tree.roots, tree.parents);
      document.getElementById("st-sub").textContent = result.omitted ? `· +${result.omitted} more not shown` : "";
      body.dataset.renderVersion = String(Number(body.dataset.renderVersion || 0) + 1);
    }
    window._selectionBus.subscribe(updateSpawnTree);

    // Guards timeline's own publish while it is applying an incoming scope (prevents echo loop).
    let _timelinePublishEnabled = true;
    function publishTimelineScope(explicit) {
      if (!_timelinePublishEnabled) return;
      const vs = renderTimeline.lastState;
      if (!vs && !explicit) return;
      let titles = null, agentIds = null, timeRange = null, windows = null;
      if (explicit) {
        titles = explicit.titles || null;
        agentIds = explicit.agentIds || null;
        timeRange = explicit.timeRange || null;
        windows = explicit.windows || (agentIds && timeRange ? [...agentIds].map(sid => ({sid,start:timeRange[0],end:timeRange[1]})) : null);
      } else if (selectionSet.size > 0) {
        titles = new Set(); agentIds = new Set(); windows = [];
        let tsMin = Infinity, tsMax = -Infinity;
        selectionSet.forEach((key) => {
          const parts = key.split("-");
          const i = parseInt(parts[0]); const j = parseInt(parts[1]);
          const a = vs.visibleAgents[i];
          if (a) for (const member of hierarchy.members(a)) { if (member.title) titles.add(member.title); if (member.id) agentIds.add(member.id); }
          const c = (vs.cellStore[i] || [])[j];
          if (c) {
            for (const member of hierarchy.members(a)) windows.push({sid:member.id,start:c.start_ts,end:c.end_ts || c.start_ts + 60});
            if (c.start_ts < tsMin) tsMin = c.start_ts;
            const e = c.end_ts || c.start_ts;
            if (e > tsMax) tsMax = e;
          }
        });
        if (tsMin !== Infinity) timeRange = [tsMin, tsMax];
        if (titles.size === 0) titles = null;
        if (agentIds.size === 0) agentIds = null;
      }
      window._selectionBus.publish({ agentIds, titles, timeRange, windows, source: "timeline", stickyElementKey: null });
    }

    // Timeline subscribes to the bus: incoming scopes from other widgets drive selectionSet.
    window._selectionBus.subscribe((scope) => {
      if (!scope || scope.source === "timeline" && !scope.restoreSelection) return;
      const vs = renderTimeline.lastState;
      if (!vs) return;
      // Full clear (click same node twice / empty area)
      if (!scope.titles && !scope.agentIds && !scope.timeRange) {
        selectionSet.clear();
        currentCell = null;
        document.querySelectorAll("#tl-chart rect.seg").forEach((r) => {
          r.removeAttribute("stroke"); r.removeAttribute("stroke-width");
          r.setAttribute("opacity", "1");
        });
        hideSelectionChip();
        return;
      }
      // Resolve titles/ids to row indexes
      const titles = scope.titles, ids = scope.agentIds;
      const rowIdxs = [];
      vs.visibleAgents.forEach((a, i) => {
        if (!a) return;
        if (hierarchy.members(a).some(member => hierarchy.matches(member, scope))) rowIdxs.push(i);
      });
      _timelinePublishEnabled = false;
      incomingScope = scope;
      try { selectAgentRows(rowIdxs, false, scope.timeRange); }
      finally { incomingScope = null; _timelinePublishEnabled = true; }
      // Panels follow the original scope, including members hidden by the chart's
      // 60-row cap. A titles-only scope must never widen to an entire group.
      const scoped = data.agents.filter(a => hierarchy.matches(a, scope));
      if (scoped.length) {
        const starts = scoped.flatMap(a => a.segments.map(s => s.start_ts));
        const ends = scoped.flatMap(a => a.segments.map(s => s.end_ts || s.start_ts + 60));
        const [lo, hi] = scope.timeRange || [Math.floor(starts.reduce((n, x) => Math.min(n, x), Infinity) / 3600) * 3600, Math.ceil((ends.reduce((n, x) => Math.max(n, x), 0) + 0.001) / 3600) * 3600];
        // Exact windows (incl. []) win over the bounding range so a pin on a
        // disjoint selection never renders gap turns in the panels.
        const byId = new Map(scoped.map(a => [a.id, a]));
        const picked = Array.isArray(scope.windows)
          ? scope.windows.filter(w => byId.has(w.sid)).map(w => ({ a: byId.get(w.sid), cell: bucketizeAgent(byId.get(w.sid), w.start, w.end, w.end - w.start)[0] }))
          : scoped.map(a => ({ a, cell: bucketizeAgent(a, lo, hi, hi - lo)[0] }));
        panelChannel = scope.channel || null;
        try { renderAggregatePanels(picked, selectionSet.size); } finally { panelChannel = null; }
        const count = scoped.length;
        const slot = document.getElementById("selection-chip-slot");
        if (slot && !slot.hidden) slot.querySelector(".selection-member-count").textContent = `${count} agent${count === 1 ? "" : "s"}`;
      }
    });

    // v14-II+: select every non-idle cell for the given agent row indexes
    // v14-LL: optional `timeWindow` = [tsMin, tsMax] restricts to cells whose start_ts is in range
    function selectColumn(colTs, colEnd, additive) {
      const vs = renderTimeline.lastState;
      if (!vs) return;
      if (!additive) selectionSet.clear();
      const picked = [];
      vs.visibleAgents.forEach((a, i) => {
        const cells = vs.cellStore[i] || [];
        cells.forEach((c, j) => {
          if (c.state === "idle") return;
          const cEnd = c.end_ts || c.start_ts + 60;
          if (cEnd <= colTs || c.start_ts >= colEnd) return;
          selectionSet.add(`${i}-${j}`);
          picked.push({ a, cell: c });
        });
      });
      if (!picked.length) { hideSelectionChip(); publishTimelineScope(); return; }
      document.querySelectorAll("#tl-chart rect.seg").forEach((r) => {
        const i = parseInt(r.getAttribute("data-agent-i"));
        const j = parseInt(r.getAttribute("data-cell-i"));
        const isSel = selectionSet.has(`${i}-${j}`);
        const stateCls = Array.from(r.classList).find((c) => c.startsWith("state-"));
        const st = stateCls ? stateCls.replace("state-", "") : "idle";
        if (isSel) { r.setAttribute("stroke", "#a855f7"); r.setAttribute("stroke-width", "2.2"); r.setAttribute("opacity", "1"); }
        else { r.setAttribute("opacity", st === "idle" ? "0.15" : "0.35"); r.removeAttribute("stroke"); r.removeAttribute("stroke-width"); }
      });
      renderAggregatePanels(picked, picked.length);
      // Keyboard column steps land here too, so the cells/agents chip must follow every column change.
      showSelectionChip(picked.length, new Set(picked.map((p) => p.a.id)).size);
      publishTimelineScope();
    }

    function selectAgentRows(rowIdxs, additive, timeWindow) {
      const vs = renderTimeline.lastState;
      if (!vs) return;
      if (!additive) selectionSet.clear();
      const picked = [];
      rowIdxs.forEach((i) => {
        const a = vs.visibleAgents[i];
        if (!a) return;
        const cells = vs.cellStore[i] || [];
        cells.forEach((c, j) => {
          if (c.state === "idle") return;
          if (timeWindow && ((c.end_ts || c.start_ts + 60) <= timeWindow[0] || c.start_ts >= timeWindow[1])) return;
          if (incomingScope?.windows && !incomingScope.windows.some(w => hierarchy.members(a).some(m => m.id === w.sid) && c.start_ts < w.end && (c.end_ts || c.start_ts + 60) > w.start)) return;
          selectionSet.add(`${i}-${j}`);
          picked.push({ a, cell: c });
        });
      });
      // Additive row picks render the entire selected union.
      if (additive) {
        picked.length = 0;
        selectionSet.forEach(key => {
          const [i, j] = key.split("-").map(Number);
          if (vs.visibleAgents[i] && vs.cellStore[i]?.[j]) picked.push({ a: vs.visibleAgents[i], cell: vs.cellStore[i][j] });
        });
      }
      if (!picked.length) {
        // Empty result (e.g. pin on a session outside exact windows): drop the
        // stale highlight so the chart matches the bus, then publish as before.
        if (!additive) { clearSelection(); currentCell = null; }
        publishTimelineScope();
        return;
      }
      // Mirror the marquee visual update
      document.querySelectorAll("#tl-chart rect.seg").forEach((r) => {
        const i = parseInt(r.getAttribute("data-agent-i"));
        const j = parseInt(r.getAttribute("data-cell-i"));
        const isSel = selectionSet.has(`${i}-${j}`);
        const stateCls = Array.from(r.classList).find((c) => c.startsWith("state-"));
        const st = stateCls ? stateCls.replace("state-", "") : "idle";
        if (isSel) {
          r.setAttribute("stroke", "#a855f7");
          r.setAttribute("stroke-width", "2.2");
          r.setAttribute("opacity", "1");
        } else {
          r.setAttribute("opacity", st === "idle" ? "0.15" : "0.35");
        }
      });
      if (picked.length === 1) {
        renderPanels(picked[0].a, picked[0].cell);
      } else {
        renderAggregatePanels(picked);
        const nAgents = new Set(picked.map((p) => p.a.id)).size;
        showSelectionChip(picked.length, nAgents);
      }
      publishTimelineScope();
    }

    function selectSingleCell(ai, ci, scrollIntoView) {
      const vs = renderTimeline.lastState;
      if (!vs) return;
      const agent = vs.visibleAgents[ai];
      if (!agent) return;
      const cells = vs.cellStore[ai] || [];
      if (ci < 0 || ci >= cells.length) return;
      const cell = cells[ci];
      clearSelection();
      renderPanels(agent, cell);
      currentCell = { ai, ci };
      // Clear col/row-axis state so the installChartNav cyclical handler
      // doesn't swallow Arrow keys meant for cell-level navigation.
      window._lastSelAxis = null;
      // Visual: dim others, highlight target
      document.querySelectorAll("#tl-chart rect.seg").forEach((o) => {
        const stateCls = Array.from(o.classList).find((c) => c.startsWith("state-"));
        const st = stateCls ? stateCls.replace("state-", "") : "idle";
        o.setAttribute("opacity", st === "idle" ? "0.2" : "0.5");
      });
      const target = document.querySelector(`#tl-chart rect[data-agent-i="${ai}"][data-cell-i="${ci}"]`);
      // Remove any prior virtual cursor overlay (empty cells don't have their
      // own <rect> after idle coalescing — we draw a transient cursor instead).
      document.querySelectorAll("#tl-chart rect.virtual-cell-cursor").forEach(e => e.remove());
      let cursorX = 0, cursorY = 0;
      if (target) {
        target.setAttribute("opacity", "1");
        target.setAttribute("stroke", "#a855f7");
        target.setAttribute("stroke-width", "2");
        cursorX = parseFloat(target.getAttribute("x"));
        cursorY = parseFloat(target.getAttribute("y"));
      } else {
        // Empty cell: synthesize a cursor rect at the right x/y using the
        // chart geometry so arrow-nav never visually "loses" the cursor.
        const geom = renderTimeline.lastGeometry;
        const svg  = document.querySelector("#tl-chart svg");
        if (geom && svg && cell) {
          const xFor = geom.xFor || ((ts) => geom.labelWidth + ((ts - geom.minTs) / geom.span) * geom.chartWidth);
          const x = xFor(cell.start_ts);
          const w = Math.max(2, xFor(cell.end_ts || cell.start_ts + 60) - x - 0.5);
          // Row Y: prefer a real cell rect in this row; otherwise use the
          // chart's row geometry so fully-idle rows (no data-agent-i rects
          // at all) still get a cursor placed on their actual row — not up
          // in the time-axis header area.
          const anyRowRect = document.querySelector(`#tl-chart rect[data-agent-i="${ai}"]`);
          const rh = geom.rowHeight || 36;
          const y = anyRowRect ? parseFloat(anyRowRect.getAttribute("y")) : ((geom.headerY || 24) + ai * rh);
          const h = anyRowRect ? parseFloat(anyRowRect.getAttribute("height")) : (rh - 4);
          const ghost = document.createElementNS("http://www.w3.org/2000/svg", "rect");
          ghost.setAttribute("class", "virtual-cell-cursor");
          ghost.setAttribute("x", x); ghost.setAttribute("y", y);
          ghost.setAttribute("width", w); ghost.setAttribute("height", h);
          ghost.setAttribute("fill", "none");
          ghost.setAttribute("stroke", "#a855f7");
          ghost.setAttribute("stroke-width", "2");
          ghost.setAttribute("stroke-dasharray", "3 2");
          ghost.setAttribute("pointer-events", "none");
          svg.appendChild(ghost);
          cursorX = x; cursorY = y;
        }
      }
      if (scrollIntoView && (cursorX || cursorY)) {
        const wrap = document.querySelector(".tl-chart-wrap");
        if (wrap) {
          // cursorX/cursorY are SVG-local coords; the SVG is a child of the
          // scrollable wrap, so the cursor's position in the scrollable area
          // is just cursorX/cursorY. Compare against the visible window
          // [scrollLeft, scrollLeft + clientWidth] directly (the earlier
          // svgRect-based math double-counted scrollLeft and never fired on
          // off-screen targets).
          const vw = wrap.clientWidth, vh = wrap.clientHeight;
          const sl = wrap.scrollLeft,  st = wrap.scrollTop;
          const geom = renderTimeline.lastGeometry;
          const labelW = geom?.labelWidth || 160;
          // Pin the sticky label column by scrolling until cursor is PAST the
          // label gutter plus a small margin.
          const leftEdge  = sl + labelW + 24;
          const rightEdge = sl + vw - 48;
          if (cursorX < leftEdge) {
            wrap.scrollTo({ left: Math.max(0, cursorX - labelW - 60), behavior: "smooth" });
          } else if (cursorX > rightEdge) {
            wrap.scrollTo({ left: cursorX - vw + 120, behavior: "smooth" });
          }
          const topEdge    = st + 40;
          const bottomEdge = st + vh - 40;
          if (cursorY < topEdge) {
            wrap.scrollTo({ top: Math.max(0, cursorY - 80), behavior: "smooth" });
          } else if (cursorY > bottomEdge) {
            wrap.scrollTo({ top: cursorY - vh + 80, behavior: "smooth" });
          }
        }
      }
      // v14-LL: single-cell click publishes a scope with just this agent + cell window
      if (agent && agent.title) {
        const tsMin = cell.start_ts, tsMax = cell.end_ts || cell.start_ts;
        publishTimelineScope(hierarchy.scopeForRows([agent], [tsMin, tsMax]));
      }
    }

    function cellIsActive(cell) {
      if (!cell) return false;
      if (cell.state && cell.state !== "idle") return true;
      if ((cell.turn_count || 0) > 0) return true;
      return false;
    }

    function navHoriz(dir, step, skipIdle) {
      // dir: -1 left, +1 right. step: 1 or 10.
      // CHANGED: plain arrow = move by 1 cell INCLUDING empty/idle ones (so
      // users can tab through quiet stretches). Hold Shift and the caller
      // passes skipIdle=true to hop to the next active cell instead.
      if (!currentCell) return;
      const vs = renderTimeline.lastState;
      if (!vs) return;
      const cells = vs.cellStore[currentCell.ai] || [];
      let ci = currentCell.ci;
      for (let s = 0; s < step; s++) {
        let nextCi = ci + dir;
        if (skipIdle) {
          while (nextCi >= 0 && nextCi < cells.length && !cellIsActive(cells[nextCi])) {
            nextCi += dir;
          }
        }
        if (nextCi < 0 || nextCi >= cells.length) return;
        ci = nextCi;
      }
      selectSingleCell(currentCell.ai, ci, true);
    }

    function navVert(dir, skipIdle) {
      if (!currentCell) return;
      const vs = renderTimeline.lastState;
      if (!vs) return;
      let ai = currentCell.ai + dir;
      if (skipIdle) {
        // Skip to the next ROW whose cell at the current time column is active.
        while (ai >= 0 && ai < vs.visibleAgents.length) {
          const cs = vs.cellStore[ai] || [];
          const ci = Math.min(currentCell.ci, cs.length - 1);
          if (cs[ci] && cellIsActive(cs[ci])) break;
          ai += dir;
        }
      }
      if (ai < 0 || ai >= vs.visibleAgents.length) return;
      const cells = vs.cellStore[ai] || [];
      if (!cells.length) { selectSingleCell(ai, 0, true); return; }
      const ci = Math.min(currentCell.ci, cells.length - 1);
      selectSingleCell(ai, ci, true);
    }

    function navHome() {
      if (!currentCell) return;
      const vs = renderTimeline.lastState;
      if (!vs) return;
      const cells = vs.cellStore[currentCell.ai] || [];
      if (cells.length) selectSingleCell(currentCell.ai, 0, true);
    }
    function navEnd() {
      if (!currentCell) return;
      const vs = renderTimeline.lastState;
      if (!vs) return;
      const cells = vs.cellStore[currentCell.ai] || [];
      if (cells.length) selectSingleCell(currentCell.ai, cells.length - 1, true);
    }

    document.addEventListener("keydown", (ev) => {
      // Ignore if typing in an input/textarea
      const t = ev.target;
      if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
      if (!currentCell && !["Escape"].includes(ev.key)) return;
      switch (ev.key) {
        // Shift+arrow = SKIP IDLE (hop to next active cell); plain arrow = +1 cell (incl. empty)
        case "ArrowLeft":  ev.preventDefault(); navHoriz(-1, 1, ev.shiftKey); break;
        case "ArrowRight": ev.preventDefault(); navHoriz(+1, 1, ev.shiftKey); break;
        case "ArrowUp":    ev.preventDefault(); navVert(-1, ev.shiftKey); break;
        case "ArrowDown":  ev.preventDefault(); navVert(+1, ev.shiftKey); break;
        case "PageUp":     ev.preventDefault(); navHoriz(-1, 10, ev.shiftKey); break;
        case "PageDown":   ev.preventDefault(); navHoriz(+1, 10, ev.shiftKey); break;
        case "Home":       ev.preventDefault(); navHome(); break;
        case "End":        ev.preventDefault(); navEnd(); break;
      }
    });

    function clearSelection() {
      selectionSet.clear();
      document.querySelectorAll("#tl-chart rect.seg").forEach((r) => {
        const stateCls = Array.from(r.classList).find((c) => c.startsWith("state-"));
        const st = stateCls ? stateCls.replace("state-", "") : "idle";
        r.removeAttribute("stroke-width");
        r.removeAttribute("stroke");
        if (r.classList.contains("has-thumb")) {
          r.setAttribute("fill", "transparent");
        }
      });
      // Nuke the empty-cell cursor overlay too
      document.querySelectorAll("#tl-chart rect.virtual-cell-cursor").forEach(e => e.remove());
      hideSelectionChip();
    }

    function installMarquee(el, visibleAgents, cellStore) {
      const wrap = document.querySelector(".tl-chart-wrap");
      if (!wrap) return;
      // Remove any previously attached overlay (DOM only — listeners install once)
      wrap.querySelectorAll(".tl-marquee").forEach((n) => n.remove());
      if (window._marqueeInstalled) return;
      window._marqueeInstalled = true;

      wrap.addEventListener("mousedown", (ev) => {
        if (ev.button !== 0) return;
        // ignore clicks on scrollbars
        if (ev.target.closest(".tl-hint") || ev.target.closest(".selection-chip")) return;
        // v14-LL: marquee ONLY on Shift+drag. Everything else pans.
        if (!ev.shiftKey) return;
        const svg = document.querySelector("#tl-chart svg");
        if (!svg) return;
        // Store start in VIEWPORT coords; overlay uses position:fixed so it needs no
        // offset / scroll math and renders correctly in all 4 drag directions.
        const sxV = ev.clientX;
        const syV = ev.clientY;
        const overlay = document.createElement("div");
        overlay.className = "tl-marquee";
        overlay.style.cssText = `position:fixed; border:1px dashed var(--accent); background:rgba(0,232,198,0.08); pointer-events:none; z-index:50; left:${sxV}px; top:${syV}px; width:0; height:0;`;
        document.body.appendChild(overlay);
        marqueeState = { startXv: sxV, startYv: syV, overlay, moved: false };
        ev.preventDefault();
      });

      window.addEventListener("mousemove", (ev) => {
        if (!marqueeState) return;
        const cxV = ev.clientX, cyV = ev.clientY;
        const x = Math.min(marqueeState.startXv, cxV);
        const y = Math.min(marqueeState.startYv, cyV);
        const w = Math.abs(cxV - marqueeState.startXv);
        const h = Math.abs(cyV - marqueeState.startYv);
        if (w > 3 || h > 3) marqueeState.moved = true;
        marqueeState.overlay.style.left = x + "px";
        marqueeState.overlay.style.top = y + "px";
        marqueeState.overlay.style.width = w + "px";
        marqueeState.overlay.style.height = h + "px";
      });

      window.addEventListener("mouseup", (ev) => {
        if (!marqueeState) return;
        const svg = document.querySelector("#tl-chart svg");
        const { startXv, startYv, overlay, moved } = marqueeState;
        // Read current render state fresh (survives live-refresh re-renders mid-drag)
        const vs = renderTimeline.lastState || {};
        const visibleAgents = vs.visibleAgents || [];
        const cellStore = vs.cellStore || [];
        marqueeState = null;
        overlay.remove();
        if (!moved || !svg) return; // treat as click
        // Translate viewport-space marquee into SVG-content coords for hit-test
        const rect = svg.getBoundingClientRect();
        const startX = startXv - rect.left, startY = startYv - rect.top;
        const cx = ev.clientX - rect.left, cy = ev.clientY - rect.top;
        const x0 = Math.min(startX, cx), x1 = Math.max(startX, cx);
        const y0 = Math.min(startY, cy), y1 = Math.max(startY, cy);
        // Hit test all rect.seg
        selectionSet.clear();
        const picked = []; // { a, cell }
        // First pass: row-label hits → whole-row selection (v14-II+)
        const wholeRows = new Set();
        document.querySelectorAll("#tl-chart rect.row-label").forEach((r) => {
          const rx = parseFloat(r.getAttribute("x"));
          const ry = parseFloat(r.getAttribute("y"));
          const rw = parseFloat(r.getAttribute("width"));
          const rh = parseFloat(r.getAttribute("height"));
          if (rx + rw < x0 || rx > x1 || ry + rh < y0 || ry > y1) return;
          wholeRows.add(parseInt(r.getAttribute("data-agent-row-i")));
        });
        wholeRows.forEach((i) => {
          const cells = cellStore[i] || [];
          cells.forEach((c, j) => {
            if (c.state === "idle") return;
            selectionSet.add(`${i}-${j}`);
            picked.push({ a: visibleAgents[i], cell: c });
          });
        });
        document.querySelectorAll("#tl-chart rect.seg").forEach((r) => {
          const rx = parseFloat(r.getAttribute("x"));
          const ry = parseFloat(r.getAttribute("y"));
          const rw = parseFloat(r.getAttribute("width"));
          const rh = parseFloat(r.getAttribute("height"));
          // Rect intersection
          if (rx + rw < x0 || rx > x1 || ry + rh < y0 || ry > y1) return;
          const i = parseInt(r.getAttribute("data-agent-i"));
          const j = parseInt(r.getAttribute("data-cell-i"));
          const stateCls = Array.from(r.classList).find((c) => c.startsWith("state-"));
          const st = stateCls ? stateCls.replace("state-", "") : "idle";
          if (st === "idle") return; // skip idle cells per spec
          const key = `${i}-${j}`;
          if (selectionSet.has(key)) return; // already picked by whole-row
          selectionSet.add(key);
          picked.push({ a: visibleAgents[i], cell: cellStore[i][j] });
        });
        if (picked.length === 0) return;
        if (picked.length === 1) {
          renderPanels(picked[0].a, picked[0].cell);
        }
        // Visual update
        document.querySelectorAll("#tl-chart rect.seg").forEach((r) => {
          const i = parseInt(r.getAttribute("data-agent-i"));
          const j = parseInt(r.getAttribute("data-cell-i"));
          const isSel = selectionSet.has(`${i}-${j}`);
          const stateCls = Array.from(r.classList).find((c) => c.startsWith("state-"));
          const st = stateCls ? stateCls.replace("state-", "") : "idle";
          if (isSel) {
            r.setAttribute("stroke", "#a855f7");
            r.setAttribute("stroke-width", "0.6");
            r.setAttribute("opacity", "1");
          } else {
            r.setAttribute("opacity", st === "idle" ? "0.15" : "0.35");
          }
        });
        if (picked.length > 1) {
          renderAggregatePanels(picked);
          showSelectionChip(picked.length, new Set(picked.map((p) => p.a.id)).size);
        }
        publishTimelineScope();
      });

      document.addEventListener("keydown", (ev) => {
        if (ev.key === "Escape") {
          clearSelection();
          currentCell = null;
          // Restore default rendering
          document.querySelectorAll("#tl-chart rect.seg").forEach((r) => {
            r.setAttribute("opacity", "1");
          });
          publishTimelineScope({ titles: null, agentIds: null, timeRange: null });
          return;
        }
        // v16-B: Ctrl/Cmd+A → marquee-equivalent select-all across visible agents (non-idle cells)
        if ((ev.ctrlKey || ev.metaKey) && (ev.key === "a" || ev.key === "A")) {
          const t = ev.target;
          if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
          ev.preventDefault();
          // CRITICAL: installMarquee runs once; its closure-captured visibleAgents/cellStore
          // go stale after any re-render. Pull fresh state (same as the mouseup hit-test does).
          const vs = renderTimeline.lastState || {};
          const visibleAgentsNow = vs.visibleAgents || [];
          const cellStoreNow = vs.cellStore || [];
          selectionSet.clear();
          const picked = [];
          for (let i = 0; i < visibleAgentsNow.length; i++) {
            const cells = cellStoreNow[i] || [];
            for (let j = 0; j < cells.length; j++) {
              const c = cells[j];
              if (!c || c.state === "idle") continue;
              selectionSet.add(`${i}-${j}`);
              picked.push({ a: visibleAgentsNow[i], cell: c });
            }
          }
          if (!picked.length) return;
          // Ctrl+A select-all: signal selection with stroke only; do NOT touch opacity.
          // Idle buckets render at opacity 0.35 and low-activity cells at <1 — bumping them
          // to 1 (or dimming to 0.15/0.35) makes previously-invisible rects pop as "shadows".
          document.querySelectorAll("#tl-chart rect.seg").forEach((r) => {
            const i = parseInt(r.getAttribute("data-agent-i"));
            const j = parseInt(r.getAttribute("data-cell-i"));
            if (selectionSet.has(`${i}-${j}`)) {
              r.setAttribute("stroke", "#a855f7");
              r.setAttribute("stroke-width", "0.6");
            } else {
              r.removeAttribute("stroke");
              r.removeAttribute("stroke-width");
            }
          });
          if (picked.length === 1) {
            renderPanels(picked[0].a, picked[0].cell);
          } else {
            renderAggregatePanels(picked);
            showSelectionChip(picked.length, new Set(picked.map((p) => p.a.id)).size);
          }
          publishTimelineScope();
        }
      });
    }

    function showSelectionChip(cells, agents) {
      const vs = renderTimeline.lastState;
      const rows = [...new Set([...selectionSet].map(key => Number(key.split("-")[0])))].map(i => vs?.visibleAgents[i]).filter(Boolean);
      if (rows.length) agents = hierarchy.scopeForRows(rows).agentIds.size;
      const level = document.getElementById("row-level").value;
      const slot = document.getElementById("selection-chip-slot");
      if (!slot) return;
      slot.innerHTML = `<strong>${cells}</strong> cell${cells === 1 ? "" : "s"}${level !== "agent" ? ` · ${rows.length} ${level} row${rows.length === 1 ? "" : "s"}` : ""} · <span class="selection-member-count">${agents} agent${agents === 1 ? "" : "s"}</span> <button type="button" class="selection-chip-clear" title="clear selection (esc)" aria-label="Clear selection">✕</button>`;
      slot.hidden = false;
      slot.querySelector("button").addEventListener("click", () => {
        clearSelection();
        document.querySelectorAll("#tl-chart rect.seg").forEach((r) => r.setAttribute("opacity", "1"));
        publishTimelineScope({ titles: null, agentIds: null, timeRange: null });
      });
    }
    function hideSelectionChip() {
      const slot = document.getElementById("selection-chip-slot");
      if (!slot) return;
      slot.innerHTML = "";
      slot.hidden = true;
    }

    function renderAggregatePanels(picked, chartCells = picked.length) {
      picked = hierarchy.expandPicked(picked, bucketizeAgent, incomingScope);
      renderAggregatePanels.lastSelection = picked;
      renderPanels.lastSelection = null;
      // Picked: [{a, cell}, ...]
      const intents = {}, roles = {}, blockers = {}, urgencies = {};
      let totalCost = 0, totalTIn = 0, totalTOut = 0, totalTurns = 0;
      let startTs = Infinity, endTs = 0;
      const agentIds = new Set();
      const agentTitles = {};
      for (const { a, cell } of picked) {
        agentIds.add(a.id);
        agentTitles[a.id] = a.title;
        totalCost += cell.cost_usd || 0;
        totalTIn += cell.tokens_in || 0;
        totalTOut += cell.tokens_out || 0;
        totalTurns += cell.turn_count || 0;
        startTs = Math.min(startTs, cell.start_ts);
        endTs = Math.max(endTs, cell.end_ts || cell.start_ts + 60);
        for (const [k, v] of Object.entries(cell.intents || {})) intents[k] = (intents[k] || 0) + v;
        for (const [k, v] of Object.entries(cell.roles || {})) roles[k] = (roles[k] || 0) + v;
        for (const [k, v] of Object.entries(cell.blockers || {})) blockers[k] = (blockers[k] || 0) + v;
        for (const [k, v] of Object.entries(cell.urgencies || {})) urgencies[k] = (urgencies[k] || 0) + v;
      }
      const durationMin = (endTs - startTs) / 60;

      // Stats: one compact line; selected cells / agents live in the header selection row.
      document.getElementById("summary-sub").textContent = "";
      const durSec = endTs - startTs;
      const durStr = !Number.isFinite(durSec) || durSec < 0 ? "—"
        : durSec < 60 ? durSec.toFixed(0) + "s"
        : durSec < 3600 ? (durSec / 60).toFixed(1) + "min"
        : (durSec / 3600).toFixed(1) + "h";
      document.getElementById("s-cost").innerHTML = costLine(totalCost, totalTIn, totalTOut, totalTurns, durStr);

      // Artifacts panel: union media/code across all picked cells, dedupe by path
      renderAggregateArtifacts(picked);

      // Labels panel: distribution bars (picked rows are {a, cell}; need the inner cell)
      const userIntents = {};
      for (const { cell } of picked) for (const [k, v] of Object.entries(cell.user_intents || {})) userIntents[k] = (userIntents[k] || 0) + v;
      renderAggregateLabels({ intents, roles, blockers, urgencies, userIntents });
      // Transcript panel: union across picked cells, sorted by ts
      renderTranscriptMulti(picked);
      renderBucketSummaryMulti(picked);
    }

    function renderAggregateArtifacts(picked) {
      const art = document.getElementById("art-body");
      document.getElementById("art-sub").textContent = "";
      const byPath = new Map();
      for (const { a, cell } of picked) {
        const arts = (window._artifacts || {})[a.id] || [];
        for (const x of arts) {
          if (x.ts < cell.start_ts || x.ts >= (cell.end_ts || cell.start_ts + 60)) continue;
          const prev = byPath.get(x.path);
          // Prefer renderable (web_url) over ghost dupes — mentioned-artifact
          // merges can emit the same path under multiple sids, one ghost + one real.
          if (!prev || (x.web_url && !prev.web_url)) byPath.set(x.path, x);
        }
      }
      const items = Array.from(byPath.values());
      // Note: we no longer early-return on empty artifacts — fleet/org rows commonly
      // have 0 artifacts because artifacts.json is bundle-indexed and misses many
      // sessions, while file_diffs.json has full coverage. Code section below
      // reads from file_diffs regardless.
      const media = items.filter((x) => x.kind === "media");
      const code = items.filter((x) => x.kind === "code");
      // Dedup media by stem (prefer mp4). Secondary preference: a candidate
      // with a resolvable web_url beats one without (same stem can appear
      // twice when prose refers to it + a mirror scanner also catalogs it;
      // without this guard the first-seen null-web_url entry wins and the
      // whole tile renders as "file missing" even though the mirror is live).
      const byStem = new Map();
      for (const m of media) {
        const stem = m.basename.replace(/\.(mp4|webm|mov|png|jpg|jpeg|gif|webp|svg)$/i, "");
        const ext = (m.basename.split(".").pop() || "").toLowerCase();
        const rank = { mp4: 3, webm: 3, mov: 3, png: 2, jpg: 2, jpeg: 2, webp: 2 }[ext] || 1;
        const prev = byStem.get(stem);
        const prevReal = prev && prev.web_url ? 1 : 0;
        const curReal  = m && m.web_url ? 1 : 0;
        if (!prev
            || rank > prev._rank
            || (rank === prev._rank && curReal > prevReal)) {
          byStem.set(stem, { ...m, _rank: rank });
        }
      }
      // Renderable-first ordering: web_url-bearing cards take all the limited
      // display slots before ghost placeholders. Within each group, user picks
      // newest-first (default) or oldest-first via the toolbar checkbox.
      const oldestFirst = !!document.getElementById("art-sort-oldest")?.checked;
      const mediaCards = Array.from(byStem.values()).sort((a, b) => {
        const aReal = a.web_url ? 1 : 0, bReal = b.web_url ? 1 : 0;
        return (bReal - aReal) || (oldestFirst ? (a.ts - b.ts) : (b.ts - a.ts));
      });
      const parts = [];
      // Optional user filter: hide ghost tiles entirely
      const hideMissing = !!document.getElementById("art-hide-missing")?.checked;
      const mediaDisplay = hideMissing ? mediaCards.filter(m => m.web_url) : mediaCards;
      const nMissing = mediaCards.length - mediaCards.filter(m => m.web_url).length;
      if (mediaDisplay.length) {
        const defaultCap = devMode === "dev" ? MEDIA_MAX_DEV : MEDIA_MAX_NONDEV;
        const expanded = !!window._artMediaExpand;
        const maxN = expanded ? mediaDisplay.length : defaultCap;
        const shown = mediaDisplay.slice(0, maxN);
        const extra = mediaDisplay.length - shown.length;
        const missingNote = !hideMissing && nMissing > 0 ? ` <span class="art-sub-mono">· ${nMissing} missing on disk</span>` : "";
        parts.push(`<div class="art-section"><div class="art-sec-head">media <span class="n">×${mediaDisplay.length} unique</span>${missingNote}</div>`);
        parts.push(`<div class="diary-grid">`);
        for (const m of shown) {
          const url = m.web_url;
          const ext = (m.basename.split(".").pop() || "").toLowerCase();
          const titleText = (m.diary_title || m.basename).replace(/-[a-f0-9]{7,}(?:-\d{8}T\d{6})?$/, "");
          const mtime = fmtMtime(m.ts);
          if (!url) {
            const srcPath = escapeHtml(m.path || m.basename || "");
            parts.push(`<figure class="diary-card missing" title="source file not found on disk — likely a pruned worktree path: ${srcPath}"><div class="diary-missing-ph">⬚</div><h4>${escapeHtml(titleText)}</h4><p class="diary-meta">source missing on disk</p></figure>`);
            continue;
          }
          if (["mp4","webm","mov"].includes(ext)) {
            // Use a sibling poster when present (diary pre-generates them);
            // otherwise seek to 5s via media-fragment so the browser shows a
            // non-black frame as thumbnail. In both cases playback starts at 0
            // when the user hits play (poster doesn't affect currentTime; and
            // we pass the plain url with no #t when the poster is set).
            const posterAttr = m.poster_url ? ` poster="${m.poster_url}"` : "";
            const vSrc = m.poster_url ? url : (url + "#t=5");
            parts.push(`<figure class="diary-card"><video controls preload="metadata"${posterAttr} src="${vSrc}"></video><h4>${escapeHtml(titleText)} <small>${mtime}</small></h4></figure>`);
          } else {
            parts.push(`<figure class="diary-card"><img loading="lazy" src="${url}" alt="${escapeHtml(titleText)}"/><h4>${escapeHtml(titleText)} <small>${mtime}</small></h4></figure>`);
          }
        }
        if (extra > 0) parts.push(`<button class="diary-card more diary-show-more" id="art-show-more"><div class="more-count">+${extra}</div><p>show all · click to expand</p></button>`);
        else if (expanded && mediaDisplay.length > defaultCap) parts.push(`<button class="diary-card more diary-show-more" id="art-collapse"><div class="more-count">▴</div><p>collapse</p></button>`);
        parts.push(`</div></div>`);
      }
      // Code section: primary source is file_diffs.json (100% session coverage via
      // [REDACTED_PATH] scan). artifacts.json is bundle-indexed and may miss
      // many sessions (fleet/org views were empty for this reason), so we no longer
      // gate the whole code block on `code.length` from artifacts.
      const fd = window._fileDiffs || null;
      let codeSectionHtml = "";
      if (fd) {
        const byPathDiff = new Map();
        for (const { a, cell } of picked) {
          const lo = cell.start_ts, hi = cell.end_ts || cell.start_ts + 60;
          for (const r of (fd[a.id] || [])) {
            if (r.ts < lo || r.ts >= hi) continue;
            const prev = byPathDiff.get(r.path) || { la: 0, lr: 0, touches: 0, repo: r.repo };
            prev.la += r.la || 0;
            prev.lr += r.lr || 0;
            prev.touches += 1;
            byPathDiff.set(r.path, prev);
          }
        }
        const files = Array.from(byPathDiff.entries())
          .map(([path, v]) => ({ path, ...v }))
          .sort((a, b) => (b.la + b.lr) - (a.la + a.lr));
        if (files.length) {
          // Extension chip row — derived from file_diffs paths (not artifacts.json)
          const byExt = {};
          for (const f of files) {
            const ext = (f.path.split(".").pop() || "?").toLowerCase().slice(0, 8);
            byExt[ext] = (byExt[ext] || 0) + 1;
          }
          const extSummary = Object.entries(byExt).sort((a, b) => b[1] - a[1]).slice(0, 8)
            .map(([e, n]) => `<span class="chip">${e} <span class="n">×${n}</span></span>`).join(" ");

          const totLa = files.reduce((s, f) => s + f.la, 0);
          const totLr = files.reduce((s, f) => s + f.lr, 0);
          const shown = files.slice(0, 50);
          const extra = files.length - shown.length;
          const rows = shown.map((f) => {
            const rel = f.repo && f.path.startsWith(f.repo) ? f.path.slice(f.repo.length).replace(/^\/+/, "") : f.path;
            const repoTag = f.repo ? f.repo.split("/").slice(-1)[0] : "";
            const touch = f.touches > 1 ? ` <span class="cf-touch">×${f.touches}</span>` : "";
            return `<li class="code-file"><span class="cf-repo" title="${escapeHtml(f.repo || "")}">${escapeHtml(repoTag)}</span><span class="cf-path" title="${escapeHtml(f.path)}"><bdi>${escapeHtml(rel)}</bdi></span>${touch}<span class="cf-add">+${f.la}</span><span class="cf-rem">−${f.lr}</span></li>`;
          }).join("");
          const more = extra > 0 ? `<li class="code-file more"><span class="hint">+${extra} more files</span></li>` : "";
          const header = `<li class="code-file cf-head"><span class="cf-repo">repo</span><span class="cf-path">path</span><span class="cf-touch"></span><span class="cf-add">+</span><span class="cf-rem">−</span></li>`;
          const fileListHtml = `<div class="code-rollup"><div class="cr-tot"><span class="cf-add">+${totLa}</span><span class="cf-rem">−${totLr}</span><span class="hint">across ${files.length} ${files.length === 1 ? "file" : "files"}</span></div><ul class="code-files">${header}${rows}${more}</ul></div>`;
          codeSectionHtml = `<div class="art-section"><div class="art-sec-head">code <span class="n">${files.length} files</span></div>${extSummary}${fileListHtml}</div>`;
        }
      } else if (code.length) {
        // file_diffs still loading — fall back to the extension chips from artifacts
        const byExt = {};
        for (const c of code) {
          const ext = (c.basename.split(".").pop() || "?").toLowerCase();
          byExt[ext] = (byExt[ext] || 0) + 1;
        }
        const extSummary = Object.entries(byExt).sort((a, b) => b[1] - a[1]).slice(0, 8)
          .map(([e, n]) => `<span class="chip">${e} <span class="n">×${n}</span></span>`).join(" ");
        codeSectionHtml = `<div class="art-section"><div class="art-sec-head">code <span class="n">${code.length} files</span></div>${extSummary}<p class="hint" style="margin-top:6px">loading per-file diffs…</p></div>`;
      }
      if (codeSectionHtml) parts.push(codeSectionHtml);

      // Sandbox / cct-live artifacts: one line per file, click opens modal.
      // Covers agents (opencode sandbox etc) whose file_diffs is empty but
      // whose workdir files were scanned into artifacts.json by the augment
      // script. Includes code, doc, data, image kinds.
      const liveFiles = items.filter((x) => ["code","doc","data","image"].includes(x.kind));
      if (liveFiles.length) {
        const sorted = liveFiles.slice().sort((a, b) => (b.ts || 0) - (a.ts || 0));
        const rows = sorted.map((f, i) => {
          const safePath = escapeHtml(f.path || "");
          const safeBase = escapeHtml(f.basename || f.path || "");
          const mtime = fmtMtime(f.ts);
          const kindTag = `<span class="cf-kind cf-kind-${f.kind}">${f.kind}</span>`;
          const extTag = `<span class="cf-ext">${(f.basename || "").split(".").pop() || ""}</span>`;
          const url = artifactUrl(f.web_url, f.path);
          const srcLink = url ? `<a class="cf-src" href="${escapeHtml(url)}" target="_blank" rel="noopener" title="open in new tab">↗</a>` : "";
          const dataAttr = `data-url="${escapeHtml(url)}" data-path="${safePath}" data-name="${safeBase}" data-size="${f.size_bytes ?? f.size ?? ''}"`;
          return `<li class="code-file cf-live clickable" ${dataAttr}>${kindTag}<button type="button" class="cf-path cf-preview" title="${safePath}"><bdi>${safeBase}</bdi></button>${extTag}<span class="cf-mtime">${mtime}</span>${srcLink}</li>`;
        }).join("");
        parts.push(`<div class="art-section"><div class="art-sec-head">files <span class="n">${liveFiles.length}</span> <span class="hint">· click to preview · ↗ open in new tab</span></div><ul class="code-files code-files-live">${rows}</ul></div>`);
      }

      if (!parts.length) parts.push(`<p class="hint">no artifacts across selection</p>`);
      art.innerHTML = parts.join("");
      // Wire modal open on live file rows
      art.querySelectorAll(".cf-live.clickable").forEach((row) => {
        row.addEventListener("click", (ev) => {
          if (ev.target.closest(".cf-src")) return; // let the ↗ anchor open natively
          const url = row.getAttribute("data-url");
          const name = row.getAttribute("data-name");
          const path = row.getAttribute("data-path");
          openArtifactModal({ url, name, path, size: row.getAttribute("data-size") });
        });
      });
      if (!window._fileDiffs && !window._artRetryHooked) {
        window._artRetryHooked = true;
        window.addEventListener("file_diffs_loaded", () => renderAggregateArtifacts(picked), { once: true });
      }
    }

    function renderAggregateLabels(agg) {
      const bar = (count, max) => {
        const pct = max ? (count / max) * 100 : 0;
        return `<div class="lab-bar" style="width:${pct.toFixed(1)}%"></div>`;
      };
      const section = (title, obj) => {
        const entries = Object.entries(obj).sort((a, b) => b[1] - a[1]);
        if (!entries.length) return "";
        const max = entries[0][1];
        const rows = entries.slice(0, 8).map(([k, n]) => `
          <div class="lab-row"><span class="lab-k">${k}</span><div class="lab-track">${bar(n, max)}</div><span class="lab-n">×${n}</span></div>`).join("");
        return `<div class="lab-group"><div class="lab-title">${title}</div>${rows}</div>`;
      };
      writeLabels(
        section("user intents", agg.userIntents || {}),
        section("intents", agg.intents) + section("roles", agg.roles) + section("blockers", agg.blockers) + section("urgencies", agg.urgencies));
    }

    // v16: labels inlined into summary panel as 3-col grid — cost | human | agent
    function writeLabels(humanHtml, agentHtml) {
      const empty = `<p class="hint">none</p>`;
      const h = document.getElementById("s-labels-human");
      const a = document.getElementById("s-labels-agent");
      if (h) h.innerHTML = humanHtml || empty;
      if (a) a.innerHTML = agentHtml || empty;
    }

    function fmtTime(ts) { return new Date(ts * 1000).toLocaleTimeString() + " " + new Date(ts * 1000).toLocaleDateString(); }

    // === v12-R transcript panel ===
    const TX_PAGE = 50;
    // v13-AA: per-kind filters (replaces compound human-only)
    let txFilters = { showTools: false, showSub: true, showA2A: true, showHuman: true, showAgent: true, showHeartbeat: false, showHarness: false, showSpawn: true, search: "" };
    const HEARTBEAT_RE = /^\s*(?:\[heartbeat\]|\[hb\])/i;
    // Display-time fallback for rows the load-time pass left as "u" (single rule set: transcript-roles.mjs).
    // Rows are classified in place by _reclassifyTranscriptRoles; raw rows fall back to text-only rules.
    function reclassifyUser(r) {
      if (r.r !== "u" || r.why) return { role: r.r, a2a: r.a2a || null, why: r.why || null };
      const out = classifyUserRow(r.x);
      return { role: out.r, a2a: out.a2a, why: out.why };
    }
    let txSelection = null;
    let panelChannel = null; // A2A channel of the incoming bus scope while its panels render // { kind: "single"|"multi", bucket: {startTs,endTs,sessionIds:[]}, rendered: n }

    function fmtClock(ts) {
      const d = new Date(ts * 1000);
      return d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false });
    }

    function compactMsg(ag, max) {
      if (!ag) return "";
      ag = ag.replace(/^claude-/, "").replace(/^codex-/, "");
      return ag.length > max ? ag.slice(0, max - 1) + "…" : ag;
    }

    // Exact per-session half-open selection windows; null means unconstrained.
    function inSelectionWindows(windows, sid, t) {
      if (!windows) return true;
      return windows.some(w => w.sid === sid && t >= w.start && t < w.end);
    }
    function windowsFromPicked(picked) {
      return picked.map(({ a, cell }) => ({ sid: a.id, start: cell.start_ts, end: cell.end_ts || cell.start_ts + 60 }));
    }

    function collectTranscriptRows(sessionIds, startTs, endTs, windows = null) {
      const idx = window._transcript;
      if (!idx) return null;
      const out = [];
      for (const sid of sessionIds) {
        const rows = idx[sid];
        if (!rows) continue;
        for (const r of rows) {
          if (r.t < startTs || r.t >= endTs) continue;
          if (!inSelectionWindows(windows, sid, r.t)) continue;
          out.push({ ...r, sid });
        }
      }
      out.sort((a, b) => a.t - b.t);
      return out;
    }

    function applyTxFilters(rows) {
      let out = rows;
      // v13-AA: filter by individual message kind
      out = out.filter((r) => {
        // Heartbeat gate (checked first so it applies regardless of role).
        if (HEARTBEAT_RE.test(r.x || "")) return txFilters.showHeartbeat;
        // Runtime re-classification: fixes mis-tagged "u" messages caused by
        // pasted_content wrappers eating the [from X] a2a header, plus flags
        // Claude Code harness notifications and spawn/boot prompts separately.
        const rc = reclassifyUser(r);
        if (rc.role === "x") return txFilters.showA2A;
        if (rc.role === "sys") return txFilters.showHarness;
        if (rc.role === "spawn") return txFilters.showSpawn;
        if (r.r === "u" && !txFilters.showHuman) return false;
        if (r.r === "x" && !txFilters.showA2A) return false;
        if (r.r === "s" && !txFilters.showSub) return false;
        if (r.r === "a" && !txFilters.showAgent) return false;
        return true;
      });
      // tools filter gates the inline "[tool_use ×N]" badges we add to agent bubbles
      if (txFilters.search) {
        const q = txFilters.search.toLowerCase();
        out = out.filter((r) => (r.x || "").toLowerCase().includes(q) || (r.ag || "").toLowerCase().includes(q));
      }
      return out;
    }

    function roleClass(r) {
      if (r === "u") return "human";
      if (r === "x") return "a2a";
      if (r === "s") return "subagent";
      if (r === "sys") return "harness";
      if (r === "spawn") return "spawn";
      return "agent";
    }
    function roleBadge(r, a2aSender) {
      if (r === "u") return "👤 human";
      if (r === "x") return `📬 from ${a2aSender || "agent"}`;
      if (r === "s") return "↪ subagent";
      if (r === "sys") return "⚙ harness";
      if (r === "spawn") return a2aSender ? `🌱 brief from ${a2aSender}` : "🌱 spawn brief";
      return "🤖 agent";
    }

    // v13-DD: resolve CKL's `<pasted_content id="...">BODY</pasted_content id="...">` tags
    // into visually-distinct nested blocks. Operates on RAW text (pre-markdown) so the
    // paste body stays monospace and is NOT re-parsed as markdown.
    const PASTE_RE = /<pasted_content\s+id="([^"]+)">([\s\S]*?)<\/pasted_content[^>]*>/g;
    function extractPastes(text) {
      // Replace paste tags with sentinel tokens; return (textWithSentinels, pasteBodies[])
      const bodies = [];
      const out = text.replace(PASTE_RE, (_m, id, body) => {
        const i = bodies.push(body.trim()) - 1;
        return `\n\n⟪PASTE_${i}⟫\n\n`;
      });
      return { out, bodies };
    }

    function renderMarkdown(text) {
      // v13-EE: GFM markdown. Falls back to escape+linebreak if marked not loaded.
      if (!window.marked || !window.marked.parse) {
        return escapeHtml(text).replace(/\n/g, "<br>");
      }
      try {
        return window.marked.parse(text, { gfm: true, breaks: true, headerIds: false, mangle: false });
      } catch (e) {
        return escapeHtml(text).replace(/\n/g, "<br>");
      }
    }

    function renderBubble(r) {
      // Use the runtime re-classification so pasted-wrapped a2a / harness noise /
      // spawn prompts display with the correct badge, not just filter correctly.
      const rc = reclassifyUser(r);
      const effRole = rc.role;
      const effA2a = rc.a2a || r.a2a;
      const cls = roleClass(effRole);
      const header = `
        <div class="tx-head">
          <span class="tx-role">${roleBadge(effRole, effA2a)}</span>
          ${r.ag && effRole !== "x" ? `<span class="tx-ag">${escapeHtml(compactMsg(r.ag, 42))}</span>` : ""}
          ${r.m && effRole !== "x" && effRole !== "u" ? `<span class="tx-model">${escapeHtml(compactMsg(r.m, 24))}</span>` : ""}
          <span class="tx-time" data-ts="${r.t}">${fmtClock(r.t)}</span>
        </div>`;
      const toolBadge = (r.tc > 0 && txFilters.showTools)
        ? `<div class="tx-tools">[tool_use ×${r.tc}${r.fe ? " · file edit" : ""}]</div>` : "";
      // 1. Extract pastes to sentinel tokens so markdown parsing skips them
      const { out: withSentinels, bodies } = extractPastes(r.x || "");
      // 2. Render markdown on the rest
      let html = renderMarkdown(withSentinels);
      // 3. Substitute sentinel tokens with paste blocks (escaped, pre-formatted)
      html = html.replace(/⟪PASTE_(\d+)⟫/g, (_m, i) => {
        const body = bodies[parseInt(i)] || "";
        const short = body.length > 320;
        const preview = short ? body.slice(0, 320) + "…" : body;
        return `<div class="tx-paste"><div class="tx-paste-head">📎 pasted ${body.length.toLocaleString()} chars</div><pre class="tx-paste-body">${escapeHtml(preview)}</pre></div>`;
      });
      const truncHint = r.trunc ? '<span class="tx-trunc">… (truncated at 2.2k chars)</span>' : "";
      return `<div class="tx-bubble ${cls}">${header}<div class="tx-text tx-md">${html}${truncHint}</div>${toolBadge}</div>`;
    }

    // "$0.129 USD · 1.02M in / 91k out · 4,718 turns · 24.0h"; exact figures in the tooltip.
    function costLine(cost, tin, tout, turns, dur) {
      const big = (n) => n >= 1e6 ? (n / 1e6).toFixed(2) + "M" : n >= 1e3 ? Math.round(n / 1e3) + "k" : String(n || 0);
      const usd = (cost || 0) >= 0.01 ? (cost || 0).toFixed(3) : (cost || 0).toFixed(5);
      const title = `classifier cost ${(cost || 0).toFixed(5)} USD · tokens in ${(tin || 0).toLocaleString()} / out ${(tout || 0).toLocaleString()}`;
      return `<span title="${title}">$${usd} USD · ${big(tin)} in / ${big(tout)} out · ${(turns || 0).toLocaleString()} turns · ${dur}</span>`;
    }
    function renderTranscriptImpl(sessionIds, startTs, endTs, label, windows = null, channel = null) {
      const body = document.getElementById("transcript-body");
      const subEl = document.getElementById("tx-sub");
      if (!body) return;
      if (!window._transcript) {
        body.innerHTML = `<p class="hint">loading transcript index…</p>`;
        return;
      }
      let raw = collectTranscriptRows(sessionIds, startTs, endTs, windows) || [];
      // An A2A channel pick narrows the transcript to messages between its two agents (either direction).
      if (channel) {
        const titleOf = new Map(data.agents.map(a => [a.id, a.title]));
        const pair = new Set([channel.from, channel.to]);
        raw = raw.filter(r => {
          const rc = reclassifyUser(r), to = titleOf.get(r.sid);
          const from = rc.role === "x" || rc.role === "spawn" ? (rc.a2a || r.a2a) : rc.role === "u" ? (rc.a2a || "human") : null;
          return from && from !== to && pair.has(from) && pair.has(to);
        });
      }
      const rows = applyTxFilters(raw);
      if (subEl) subEl.textContent = (channel ? ` · ${channel.from} ↔ ${channel.to}` : "") + (rows.length !== raw.length ? ` · ${rows.length}/${raw.length} shown by filters` : "");
      if (!rows.length) {
        body.innerHTML = `<p class="hint">no prose messages in this window (${raw.length} total · ${rows.length} after filters)</p>`;
        return;
      }
      const shown = Math.min(TX_PAGE, rows.length);
      let html = rows.slice(0, shown).map(renderBubble).join("");
      if (rows.length > shown) {
        html += `<div class="tx-more" id="tx-more" data-shown="${shown}" data-total="${rows.length}">show next ${Math.min(TX_PAGE, rows.length - shown)} of ${rows.length - shown} remaining</div>`;
      }
      body.innerHTML = html;
      body.scrollTop = 0;
      body._rows = rows;
      body._shown = shown;
      const more = document.getElementById("tx-more");
      if (more) more.addEventListener("click", () => expandMoreTranscript());
    }

    function expandMoreTranscript() {
      const body = document.getElementById("transcript-body");
      if (!body || !body._rows) return;
      const next = Math.min(body._shown + TX_PAGE, body._rows.length);
      const slice = body._rows.slice(body._shown, next);
      const moreEl = document.getElementById("tx-more");
      const html = slice.map(renderBubble).join("");
      if (moreEl) moreEl.outerHTML = html + (next < body._rows.length
        ? `<div class="tx-more" id="tx-more" data-shown="${next}" data-total="${body._rows.length}">show next ${Math.min(TX_PAGE, body._rows.length - next)} of ${body._rows.length - next} remaining</div>`
        : "");
      body._shown = next;
      const newMore = document.getElementById("tx-more");
      if (newMore) newMore.addEventListener("click", () => expandMoreTranscript());
    }

    function renderTranscriptSingle(agent, seg) {
      txSelection = { kind: "single", sessionIds: [agent.id], startTs: seg.start_ts, endTs: seg.end_ts || seg.start_ts + 60, label: compactMsg(agent.title, 30) };
      renderTranscriptImpl(txSelection.sessionIds, txSelection.startTs, txSelection.endTs, txSelection.label);
    }
    function renderTranscriptMulti(picked) {
      const sids = Array.from(new Set(picked.map(({a}) => a.id)));
      let s = Infinity, e = 0;
      for (const { cell } of picked) {
        s = Math.min(s, cell.start_ts);
        e = Math.max(e, cell.end_ts || cell.start_ts + 60);
      }
      // Bounding [s,e) is only a prefilter; exact windows exclude gaps between
      // disjoint cells and other sessions' cells in the same span.
      // Only a panel render driven by an incoming A2A channel scope carries the channel; any chart/nav pick clears it.
      txSelection = { kind: "multi", sessionIds: sids, startTs: s, endTs: e, windows: windowsFromPicked(picked), label: `${picked.length} cells · ${sids.length} agents`, channel: panelChannel };
      renderTranscriptImpl(txSelection.sessionIds, txSelection.startTs, txSelection.endTs, txSelection.label, txSelection.windows, txSelection.channel);
    }
    window._renderCurrentTranscript = () => {
      if (!txSelection) return;
      renderTranscriptImpl(txSelection.sessionIds, txSelection.startTs, txSelection.endTs, txSelection.label, txSelection.windows || null, txSelection.channel || null);
    };

    // Filter wiring
    ["tx-tools", "tx-sub-cb", "tx-a2a", "tx-human-cb", "tx-agent", "tx-hb-cb", "tx-sys-cb", "tx-spawn-cb"].forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.addEventListener("change", () => {
        txFilters.showTools = document.getElementById("tx-tools").checked;
        txFilters.showSub = document.getElementById("tx-sub-cb").checked;
        txFilters.showA2A = document.getElementById("tx-a2a").checked;
        txFilters.showHuman = document.getElementById("tx-human-cb").checked;
        txFilters.showAgent = document.getElementById("tx-agent").checked;
        txFilters.showHeartbeat = !!document.getElementById("tx-hb-cb")?.checked;
        txFilters.showHarness = !!document.getElementById("tx-sys-cb")?.checked;
        txFilters.showSpawn = !!document.getElementById("tx-spawn-cb")?.checked;
        window._renderCurrentTranscript();
      });
    });
    const searchEl = document.getElementById("tx-search");
    if (searchEl) {
      let debounce;
      searchEl.addEventListener("input", () => {
        clearTimeout(debounce);
        debounce = setTimeout(() => {
          txFilters.search = searchEl.value.trim();
          window._renderCurrentTranscript();
        }, 180);
      });
    }
    // === /v12-R ===

    // === v12-S bucket prose summaries ===
    let bsSelection = null; // { sessionIds:[], startTs, endTs }
    const BUCKET_GRAIN_SEC = 3600;

    function relAgo(ts) {
      if (!ts) return "";
      const now = Date.now() / 1000;
      let s = Math.max(0, now - ts);
      if (s < 60) return `${Math.round(s)}s ago`;
      s /= 60; if (s < 60) return `${Math.round(s)}m ago`;
      s /= 60; if (s < 24) return `${Math.round(s)}h ago`;
      s /= 24; if (s < 30) return `${Math.round(s)}d ago`;
      s /= 30; if (s < 12) return `${Math.round(s)}mo ago`;
      return `${Math.round(s / 12)}y ago`;
    }

    // Task graph and Summary are separate widgets fed by the same selection (bsSelection).
    function renderBucketSummaryImpl() { renderTaskGraph(); renderProseSummary(); }
    function renderTaskGraph() {
      const sec = document.getElementById("bucket-summary-section");
      const body = document.getElementById("bs-body");
      if (!sec || !body) return;
      if (!bsSelection) { disposeV02Summary(body); sec.hidden = true; body.replaceChildren(); return; }
      sec.hidden = false;
      renderV02Summary(body, null, bsSelection);
    }
    function renderProseSummary() {
      const sec = document.getElementById("prose-section");
      const body = document.getElementById("prose-body");
      const sub = null; // no header sub line; the libs put their stats in the body
      if (!sec || !body) return;
      const head = document.getElementById("prose-head"), v01 = document.getElementById("summary-version")?.value === "0.1";
      sec.querySelector(".prose-ts")?.toggleAttribute("hidden", !v01); // timestamps only apply to V0.1 bullets
      if (head) head.replaceChildren();
      if (!bsSelection) { sec.hidden = true; body.replaceChildren(); return; }
      // V0.1.B: hierarchical merged bullets (swarm-dashboard-merge owns the lib); picker + info go in the one-row header.
      if (!v01) { sec.hidden = false; renderV01BSummary(body, sub, bsSelection, { head }); return; }
      if (!window._bucketSummaries) {
        sec.hidden = false;
        body.innerHTML = `<p class="hint">loading summaries…</p>`;
        return;
      }
      const rollup = hierarchy.summaryRollup(window._bucketSummaries, bsSelection.sessionIds, bsSelection.startTs, bsSelection.endTs);
      const rows = rollup.rows;
      if (!rows.length) {
        sec.hidden = false;
        body.innerHTML = `<p class="hint">No saved hourly summaries for these agents in this interval. Try a different interval or widen the selection.</p>`;
        if (sub) sub.textContent = "";
        return;
      }
      const totals = { msgs: 0 };
      for (const r of rows) totals.msgs += r.msg_count || 0;
      const sections = [
        { k: "started", title: "started", cls: "bs-started", cap: 7, icon: "⏵" },
        { k: "finished", title: "finished", cls: "bs-finished", cap: 7, icon: "✓" },
        { k: "blocked", title: "blocked", cls: "bs-blocked", cap: 5, icon: "⨯" },
        { k: "key_decisions", title: "key decisions", cls: "bs-decisions", cap: 5, icon: "◉" },
      ];
      const showTs = !!document.getElementById("bs-show-ts")?.checked;
      const parts = [];
      const coarse = bsSelection.startTs % BUCKET_GRAIN_SEC !== 0 || bsSelection.endTs % BUCKET_GRAIN_SEC !== 0;
      parts.push(`<p class="hint">Hourly source summaries${coarse ? " overlap this selection and may include activity outside its bounds" : " within this interval"}; coverage shown above.</p>`);
      const groupParts = [];
      for (const sec_cfg of sections) {
        const bullets = rollup.fields[sec_cfg.k];
        if (!bullets.length) continue;
        const renderBullet = b => {
          const tsHtml = showTs && b.ts ? ` <span class="bs-ts">· ${escapeHtml(relAgo(b.ts))}</span>` : "";
          return `<li>${escapeHtml(b.text)}${tsHtml}</li>`;
        };
        const liHtml = bullets.slice(0, sec_cfg.cap).map(renderBullet).join("");
        const more = bullets.length > sec_cfg.cap ? `<details class="bs-more"><summary>show ${bullets.length - sec_cfg.cap} more · ${bullets.length} total</summary><ul class="bs-list">${bullets.slice(sec_cfg.cap).map(renderBullet).join("")}</ul></details>` : "";
        groupParts.push(`<div class="bs-group ${sec_cfg.cls}"><div class="bs-group-title">${sec_cfg.icon} ${sec_cfg.title} <span class="bs-group-n">${bullets.length}</span></div><ul class="bs-list">${liHtml}</ul>${more}</div>`);
      }
      if (groupParts.length) parts.push(`<div class="bs-grid">${groupParts.join("")}</div>`);
      sec.hidden = false;
      body.innerHTML = parts.length ? parts.join("") : `<p class="hint">summary generated but all sections empty (quiet bucket)</p>`;
      if (sub) sub.textContent = ` · ${rollup.uniqueBullets} unique bullets · ${rollup.duplicates} exact repeats merged · Qwen3-30B-A3B`;
    }

    {
      const ver = document.getElementById("summary-version");
