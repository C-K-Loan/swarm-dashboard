  .transcript-controls input:disabled + * { opacity: 0.4; }
  .transcript-search { flex: 1 1 100px; min-width: 100px; background: var(--panel-2); border: 1px solid var(--border); color: var(--text); padding: 3px 8px; border-radius: 4px; font-size: 11px; font-family: var(--mono); }
  .transcript-body { display: flex; flex-direction: column; gap: 6px; padding: 4px 2px 8px; scroll-behavior: smooth; }

  .tx-bubble { padding: 6px 9px; border-radius: 8px; font-size: 11px; line-height: 1.45; max-width: 94%; border: 1px solid rgba(42,42,58,0.5); }
  .tx-bubble.human { align-self: flex-start; background: #1b2d47; border-color: #2a4a73; color: #d9e4f5; }
  .tx-bubble.a2a { align-self: flex-start; background: #2d2619; border-color: #4a3f23; color: #ecdcc0; max-width: 92%; }
  .tx-bubble.agent { align-self: flex-end; background: #19261c; border-color: #294a2f; color: #d9ecda; }
  .tx-bubble.subagent { align-self: flex-end; background: #231a2d; border-color: #3d2a4a; color: #e4d9ec; font-style: italic; max-width: 86%; margin-right: 8%; }
  .tx-head { display: flex; align-items: center; gap: 6px; margin-bottom: 3px; font-size: 9px; font-family: var(--mono); color: var(--muted); flex-wrap: wrap; }
  .tx-head .tx-role { color: var(--text); font-weight: 600; font-family: inherit; font-size: 10px; }
  .tx-head .tx-ag { color: var(--accent); }
  .tx-head .tx-model { opacity: 0.7; }
  .tx-head .tx-time { margin-left: auto; opacity: 0.65; cursor: default; }
  .tx-text { word-wrap: break-word; white-space: normal; }
  .tx-trunc { color: var(--muted); font-style: italic; margin-left: 4px; font-size: 10px; }
  .tx-tools { margin-top: 3px; color: var(--warn); font-family: var(--mono); font-size: 9px; opacity: 0.75; }
  .tx-more { align-self: center; background: var(--panel-2); color: var(--accent); border: 1px solid var(--border); padding: 4px 10px; border-radius: 12px; font-size: 10px; font-family: var(--mono); cursor: pointer; margin-top: 4px; }
  .tx-more:hover { border-color: var(--accent); }
  .tx-paste { margin: 4px 0; background: rgba(10,11,16,0.7); border-left: 2px solid var(--accent); border-radius: 3px; padding: 5px 8px; font-size: 10px; }
  .tx-paste-head { color: var(--accent); font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 3px; opacity: 0.85; }
  .tx-paste-body { color: var(--text); white-space: pre-wrap; font-family: var(--mono); font-size: 10px; line-height: 1.35; max-height: 180px; overflow: auto; margin: 0; }
  /* v13-EE: markdown rendering inside bubbles */
  .tx-md p { margin: 2px 0; }
  .tx-md ul, .tx-md ol { margin: 2px 0 2px 0; padding-left: 18px; }
  .tx-md li { margin: 1px 0; }
  .tx-md strong { font-weight: 700; }
  .tx-md em { font-style: italic; }
  .tx-md a { color: var(--accent); text-decoration: none; }
  .tx-md a:hover { text-decoration: underline; }
  .tx-md code { background: rgba(10,11,16,0.6); border-radius: 3px; padding: 0 4px; font-family: var(--mono); font-size: 10px; color: #ffd79a; }
  .tx-md pre { background: rgba(10,11,16,0.7); border-radius: 4px; padding: 6px 8px; margin: 4px 0; overflow-x: auto; font-size: 10px; font-family: var(--mono); line-height: 1.4; }
  .tx-md pre code { background: transparent; padding: 0; color: var(--text); }
  .tx-md h1, .tx-md h2, .tx-md h3, .tx-md h4 { margin: 6px 0 2px; font-size: 12px; color: var(--text); font-weight: 700; }
  .tx-md blockquote { margin: 4px 0; padding: 2px 8px; border-left: 2px solid var(--border); color: var(--muted); font-style: italic; }
  .tx-md hr { border: 0; border-top: 1px dashed var(--border); margin: 6px 0; }
  .tx-md table { border-collapse: collapse; font-size: 10px; margin: 4px 0; }
  .tx-md th, .tx-md td { border: 1px solid var(--border); padding: 2px 6px; }

  .bucket-summary-section { margin: 0; padding: 0; }
  /* V0.2: version picker sits at the start of the state graph's single control row; timestamps only apply to V0.1. */
  .bucket-summary-section { position: relative; }
  /* Summary widget: one header row [version][merge model] ... info (full stats on hover). */
  .prose-head { display: flex; flex-wrap: nowrap; align-items: center; gap: 6px; min-width: 0; margin-bottom: 6px; }
  .prose-tools { display: contents; }
  .prose-head .prose-select, .prose-head .v01b-tree { background: var(--panel-2); color: var(--text); border: 1px solid var(--border); border-radius: 4px; padding: 2px 6px; font: 11px var(--mono); cursor: pointer; flex: 0 1 auto; min-width: 0; max-width: 190px; }
  .prose-head .prose-select:hover, .prose-head .v01b-tree:hover { border-color: var(--muted); }
  .prose-head .v01b-info { margin-left: auto; color: var(--muted); font: 10px var(--mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; cursor: help; }
  .prose-head .prose-ts { margin-left: auto; }
  .prose-head .prose-ts[hidden] { display: none; }
  .bs-node-head { font-weight: 600; font-size: 11px; margin: 6px 0 2px; }
  .bs-src { font-size: 10px; color: #6b7280; }
  .bs-src summary { cursor: pointer; }
  .bs-head { margin-bottom: 2px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .bs-title { color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }
  @media (max-width: 600px) { .bs-head { display: block; } .bs-title, .bs-title .col-sub { display: block; margin-left: 0; } .bs-toggle { margin-top: 6px; } }
  .bs-toggle { color: var(--muted); font-size: 10px; font-family: var(--mono); display: inline-flex; align-items: center; gap: 4px; cursor: pointer; }
  .bs-toggle input { margin: 0; }
  .bs-ts { color: var(--muted); font-family: var(--mono); font-size: 10px; }
  .bs-body { font-size: 11px; }
  /* Responsive bullet columns based on the WIDGET width (container queries),
     not viewport. 4-col kicks in at ~500px widget width (≈30% of a 1600px
     screen), 2-col at 300-500px, single col under 300px. */
  .bs-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; align-items: start; }
  @container summary-widget (max-width: 500px) { .bs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @container summary-widget (max-width: 300px) { .bs-grid { grid-template-columns: 1fr; } }
  .bs-group { margin-bottom: 0; min-width: 0; }
  .bs-group-title { color: var(--text); font-size: 10px; letter-spacing: 0.05em; margin-bottom: 2px; display: flex; align-items: center; gap: 4px; opacity: 0.85; text-transform: uppercase; }
  .bs-group-n { color: var(--muted); font-family: var(--mono); font-weight: 400; opacity: 0.7; margin-left: auto; }
  .bs-list { margin: 0; padding: 0 0 0 14px; list-style: none; }
  .bs-list li { padding: 1px 0; font-size: 11px; line-height: 1.4; position: relative; }
  .bs-list li::before { content: "·"; position: absolute; left: -8px; color: var(--muted); }
  .bs-started .bs-group-title { color: #ffb86c; }
  .bs-finished .bs-group-title { color: #5cff8c; }
  .bs-blocked .bs-group-title { color: var(--err); }
  .bs-decisions .bs-group-title { color: #c9a0ff; }

  .tl-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; padding: 6px 10px; margin-bottom: 8px; background: rgba(21,21,30,0.5); border: 1px solid var(--border); border-radius: 6px; font-size: 10px; color: var(--muted); font-family: var(--mono); }
  .tl-legend .legend-group { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
  .tl-legend .legend-head { color: var(--text); font-weight: 600; margin-right: 2px; text-transform: uppercase; letter-spacing: 0.08em; }
  .tl-legend .legend-dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 2px; margin-left: 6px; vertical-align: -1px; }
  .tl-legend .legend-foot { margin-left: auto; font-style: italic; opacity: 0.75; }
  .tl-legend .legend-note { font-size: 10px; }
  /* v14-LL compact one-strip legend (above widget toolbar) */
  .tl-legend-strip { gap: 4px; padding: 5px 10px; row-gap: 2px; line-height: 1.5; }
  .tl-legend-strip .legend-dot { width: 7px; height: 7px; margin-right: 1px; margin-left: 4px; }
  .tl-legend-strip .lg { color: var(--text); font-weight: 500; margin: 0 2px 0 4px; text-transform: lowercase; letter-spacing: 0; }
  .tl-legend-strip .lg:first-child { margin-left: 0; }
  .tl-legend-strip .sep { color: #4a4a5a; margin: 0 4px; }
  .tl-legend-strip .note { color: var(--muted); font-style: italic; opacity: 0.8; }

  .col h3 { margin: 0 0 8px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 600; }
  .col .col-sub { color: var(--accent); font-weight: 400; text-transform: none; letter-spacing: 0; margin-left: 4px; font-size: 10px; font-family: var(--mono); }
  .col .col-body { font-size: 12px; }
  .col .hint { color: var(--muted); font-size: 11px; font-style: italic; }

  .tree-row { display: flex; gap: 8px; padding: 2px 0; font-size: 12px; }
  .tree-row .k { color: var(--muted); font-family: var(--mono); font-size: 10px; min-width: 70px; }
  .tree-row code { color: var(--accent); font-family: var(--mono); font-size: 11px; }

  .summary-section { margin-bottom: 10px; }
  .summary-section .summary-label { color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 2px; }
  .summary-section ul { margin: 0; padding-left: 0; list-style: none; }
  .summary-section li { padding: 2px 0; font-size: 12px; display: flex; gap: 6px; align-items: center; }
  .summary-section li .n { color: var(--muted); font-family: var(--mono); font-size: 10px; }
  .summary-section .k { color: var(--muted); font-family: var(--mono); font-size: 10px; min-width: 90px; }
  .chip { background: var(--panel-2); color: var(--text); padding: 1px 6px; border-radius: 3px; font-family: var(--mono); font-size: 10px; }
  .chip.chip-err { background: rgba(255,92,108,0.15); color: var(--err); }

  .art-row { padding: 4px 0; border-bottom: 1px dashed var(--border); font-size: 12px; }
  .art-row:last-child { border-bottom: 0; }
  .art-row.err { color: var(--err); }
  .art-row .art-kind { color: var(--muted); font-family: var(--mono); font-size: 10px; margin-right: 6px; }
  .art-row .art-count { color: var(--accent); font-weight: 600; }
  .art-row .art-text { color: var(--text); font-size: 11px; margin-top: 2px; line-height: 1.4; }

  /* v16: summary-triple grid — cost / human labels / agent labels */
  .summary-aggregates { container-type: inline-size; }
  .summary-triple { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: start; }
  .s-cost-line { margin: 0 0 8px; font-family: var(--mono); font-size: 11px; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .summary-triple-cell { min-width: 0; }
  .summary-triple-cell + .summary-triple-cell { padding-left: 12px; border-left: 1px dashed var(--border); }
  .lab-cell { font-size: 11px; }
  @container (max-width: 320px) {
    .summary-triple { grid-template-columns: 1fr; }
    .summary-triple-cell + .summary-triple-cell { padding-left: 0; border-left: 0; padding-top: 8px; border-top: 1px dashed var(--border); }
  }
  .lab-group { margin-bottom: 8px; }
  .lab-title { color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px; }
  .lab-chips { display: flex; flex-wrap: wrap; gap: 4px; }

  .tl-chart-wrap { background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 0 10px 10px 0; /* no top padding: the sticky axis must sit flush at the scroll top */ overflow: auto; position: relative; user-select: none; cursor: grab; }
  .tl-chart-wrap.panning,
  .tl-chart-wrap.panning rect.seg { cursor: grabbing !important; }
  .tl-chart-wrap.shift-held { cursor: crosshair; }
  .tl-chart-wrap.shift-held rect.seg { cursor: crosshair !important; }
  .tl-marquee { pointer-events: none; }
  .selection-chip-slot { display: inline-flex; align-items: center; gap: 6px; padding: 1px 8px; background: var(--panel-2); border: 1px solid var(--accent); border-radius: 10px; color: var(--text); font-family: var(--mono); font-size: 10px; }
  .selection-chip-slot[hidden] { display: none; }
  .selection-chip-slot strong { color: var(--accent); font-weight: 700; }
  .selection-chip-slot .selection-chip-clear { background: transparent; color: var(--muted); border: 1px solid var(--border); border-radius: 3px; padding: 1px 6px; font-family: var(--mono); font-size: 10px; cursor: pointer; margin-left: 2px; }
  .selection-chip-slot .selection-chip-clear:hover { color: var(--text); border-color: var(--muted); }
  /* legacy selectors (hit-test ignore paths) kept pointing at the inline slot */
  .selection-chip { display: none; }

  /* Aggregate labels bars */
  .lab-row { display: flex; align-items: center; gap: 6px; padding: 2px 0; font-size: 11px; }
  .lab-row .lab-k { color: var(--text); min-width: 100px; font-family: var(--mono); font-size: 10px; }
  .lab-row .lab-track { flex: 1; background: var(--panel-2); border-radius: 2px; height: 10px; overflow: hidden; }
  .lab-row .lab-bar { height: 100%; background: var(--accent); border-radius: 2px; }
  .lab-row .lab-n { color: var(--muted); font-family: var(--mono); font-size: 10px; min-width: 30px; text-align: right; }
  .lab-row:nth-child(2) .lab-bar { background: #ffb86c; }
  .lab-row:nth-child(3) .lab-bar { background: #c9a0ff; }
  .lab-row:nth-child(4) .lab-bar { background: #5cff8c; }
