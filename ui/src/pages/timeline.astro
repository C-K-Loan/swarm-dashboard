  body.edit-mode #widget-grid .widget-header h3::before { content: "⠿ "; color: #e14580; }
  body.edit-mode #widget-grid .widget { outline: 1px dashed #e14580; }
  body.edit-mode #widget-grid .widget-body, body.edit-mode #widget-grid .col-body { pointer-events: none; opacity: .75; }
  body.edit-mode #widget-grid .grid-stack-placeholder > .placeholder-content { background: rgba(225,69,128,.12); border: 2px dashed #e14580; border-radius: 6px; }
  body.edit-mode #widget-toolbar { box-shadow: inset 0 0 0 1px #e14580; }
  /* v15-D treemap */
  .tree-body { padding: 0 !important; overflow: hidden !important; display: flex; flex-direction: column; }
  .tree-body svg { display: block; flex: 0 0 auto; }
  .tree-body rect.tr-node { cursor: pointer; transition: stroke 0.08s ease; }
  .tree-body rect.tr-node:hover { stroke: #5bb6ff !important; stroke-width: 2 !important; }
  .tree-body rect.tr-head { cursor: zoom-out; }
  .tr-legend-bar { display: flex; gap: 10px; padding: 4px 8px; font-size: 10px; color: var(--muted); background: #16161e; border-bottom: 1px solid var(--border); align-items: center; flex: 0 0 auto; }
  .tr-leg { display: inline-flex; align-items: center; gap: 4px; }
