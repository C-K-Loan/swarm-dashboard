  .col h3 { display: flex; align-items: center; }

  .art-section { margin-bottom: 12px; padding-bottom: 10px; border-bottom: 1px dashed var(--border); }
  .art-section:last-child { border-bottom: 0; }
  .art-sec-head { color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; display: flex; align-items: baseline; gap: 10px; }
  .art-sec-head .n { color: var(--accent); font-family: var(--mono); margin-left: 4px; }
  .art-sub-mono { color: var(--muted); font-family: var(--mono); font-size: 9px; letter-spacing: 0; text-transform: none; }

  /* Dev-diary styled card grid (matches gamejam dist/diary/index.html visual) */
  .diary-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px; }
  .diary-card { background: #1a1d24; border-radius: 6px; padding: 7px; margin: 0; border: 1px solid #22262e; }
  .diary-card video, .diary-card img { max-width: 100%; width: 100%; max-height: 220px; object-fit: contain; border-radius: 4px; background: #000; display: block; }
  /* Lock all video tiles to the same 16:9 frame so unpostered / still-loading
     videos don't render as just a controls strip. Posters/first-frames fill via
     object-fit:contain. */
  .diary-card video { aspect-ratio: 16/9; height: auto; min-height: 140px; }
  .diary-card h4 { margin: 6px 0 2px; color: #c9d6ee; font-size: 12px; font-weight: 600; word-break: break-word; }
  .diary-card h4 small { color: #8a90a0; font-weight: 400; margin-left: 4px; font-family: var(--mono); font-size: 10px; }
  .diary-card .diary-caption { margin: 2px 0 0; color: #b7bdc9; font-size: 11px; line-height: 1.4; }
  .diary-card .diary-meta { color: #8a90a0; font-family: var(--mono); font-size: 10px; margin: 4px 0 0; }
  .diary-card.missing { color: #8a90a0; padding: 24px 7px; text-align: center; font-family: var(--mono); font-size: 11px; }
  .diary-card.missing .diary-missing-ph { font-size: 32px; opacity: 0.5; }

  /* Live/sandbox file list: 1 line per file, click-to-preview */
  .code-files-live { font-family: var(--mono); font-size: 11px; margin: 4px 0 0; }
  .code-file.cf-live { display: flex; align-items: center; gap: 8px; padding: 3px 4px; border-radius: 3px; border-bottom: 1px dotted rgba(42,42,58,0.4); color: #c9d6ee; }
