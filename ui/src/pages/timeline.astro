    async function openArtifactModal({ url, name, path, size }) {
      const m = _ensureArtifactModal();
      if (m.hidden) artifactTrigger = document.activeElement;
      artifactRequest?.abort();
      const request = artifactRequest = new AbortController();
      url = artifactUrl(url, path);
      m.querySelector(".art-modal-title").textContent = name || path || url || "File preview";
      const open = m.querySelector(".art-modal-open");
      open.hidden = !url;
      if (url) open.href = url;
      else open.removeAttribute("href");
      const body = m.querySelector(".art-modal-body");
      body.innerHTML = '<p class="art-preview-message">Loading preview…</p>';
      m.hidden = false;
      m.querySelector(".art-modal-close").focus();
      document.addEventListener("keydown", _modalEscHandler);
      const placeholder = (reason) => {
        if (request.signal.aborted) return;
        const bytes = size !== undefined && size !== null && size !== "" ? `${Number(size).toLocaleString()} bytes` : "size unavailable";
        body.replaceChildren();
        const message = document.createElement("p");
        message.className = "art-preview-message";
        message.textContent = `Cannot preview · ${bytes}. ${reason}${url ? " Use OPEN SRC to open the file." : ""}`;
        body.append(message);
      };
      if (!url) { placeholder("No accessible source is available."); return; }
      const ext = (name || path || new URL(url, location.href).pathname).split(".").pop().toLowerCase();
      if (["png", "jpg", "jpeg", "gif", "webp", "svg"].includes(ext) || ["mp4", "webm", "mov"].includes(ext)) {
        const media = document.createElement(["mp4", "webm", "mov"].includes(ext) ? "video" : "img");
        if (media instanceof HTMLVideoElement) { media.controls = true; media.autoplay = true; }
        else media.alt = name || "Artifact preview";
        media.addEventListener("error", () => placeholder("The media could not be loaded."));
        media.src = url;
        body.replaceChildren(media);
        return;
      }
      if (["html", "htm"].includes(ext)) {
        const frame = document.createElement("iframe");
        frame.title = name || "HTML preview";
        frame.setAttribute("sandbox", "allow-scripts");
        frame.referrerPolicy = "no-referrer";
        frame.src = url;
        body.replaceChildren(frame);
        return;
      }
      try {
        const response = await fetch(url, { signal: request.signal });
        if (!response.ok) throw new Error(`Source request failed (${response.status}).`);
        const bytes = new Uint8Array(await response.arrayBuffer());
        size = bytes.byteLength;
        // Fetch succeeds for binary files too: reject binary controls and invalid UTF-8.
        if (bytes.some((b) => b === 0 || (b < 9) || (b > 13 && b < 32))) throw new Error("This is a binary file.");
        const source = new TextDecoder("utf-8", { fatal: true }).decode(bytes);
        if (request.signal.aborted) return;
        if (!source.trim()) { body.innerHTML = '<p class="art-preview-message">This file is empty.</p>'; return; }
        if (["md", "markdown"].includes(ext)) {
          const article = document.createElement("article");
          article.className = "md";
          article.innerHTML = DOMPurify.sanitize(marked.parse(source, { async: false }));
          article.querySelectorAll("pre code").forEach((code) => hljs.highlightElement(code));
          // Relative markdown links and images should resolve against the source file.
          article.querySelectorAll("a[href], img[src]").forEach((el) => {
            const attr = el.tagName === "A" ? "href" : "src";
            const value = el.getAttribute(attr);
            if (!value || value.startsWith("#")) return;
            const resolved = url.includes("/api/raw?") && path && !/^(?:[a-z]+:|\/)/i.test(value)
              ? artifactUrl(null, new URL(value, `https://local${path}`).pathname)
              : new URL(value, new URL(url, location.href)).href;
            if (resolved) el.setAttribute(attr, resolved);
            if (attr === "href") { el.setAttribute("target", "_blank"); el.setAttribute("rel", "noopener noreferrer"); }
          });
          body.replaceChildren(article);
        } else {
          const pre = document.createElement("pre");
          pre.className = "art-source";
          const code = document.createElement("code");
          code.textContent = source;
          if (["js", "jsx", "ts", "tsx", "py", "sh", "rs", "go", "c", "cpp", "h", "css", "json", "jsonl", "csv", "toml", "yaml", "yml", "xml", "sql"].includes(ext) && source.length < 200000) {
            code.className = "hljs";
            code.innerHTML = hljs.highlightAuto(source).value;
          }
          pre.append(code);
          body.replaceChildren(pre);
        }
      } catch (error) {
        if (!request.signal.aborted) placeholder(error instanceof TypeError ? "Source could not be read as UTF-8 text." : error.message);
      }
    }
    function closeArtifactModal() {
