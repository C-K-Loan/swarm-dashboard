          if (["http:", "https:"].includes(parsed.protocol)) return parsed.href;
        } catch (_) {}
      }
      if (import.meta.env.DEV && path?.startsWith("/")) {
        const parts = [];
        for (const part of path.split("/")) {
          if (part === "..") parts.pop();
          else if (part && part !== ".") parts.push(part);
        }
        const normalized = "/" + parts.join("/");
        const blocked = parts.some((part) => /^(?:[REDACTED]|[REDACTED]|[REDACTED]|[REDACTED]|[REDACTED]|[REDACTED])$/i.test(part));
        if (!blocked && artifactRoots.some((root) => normalized.startsWith(root))) return `/api/raw?path=${encodeURIComponent(normalized)}`;
      }
      return "";
    }
    let artifactRequest = null;
