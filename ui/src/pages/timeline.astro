  .tr-crumb-sep { color: #4a4a5a; margin: 0 4px; }
  .tr-empty { display: flex; align-items: center; justify-content: center; height: 100%; color: var(--muted); font-size: 12px; padding: 20px; text-align: center; }
  /* comms widget */
  .comms-controls { display: inline-flex; align-items: center; gap: 6px; font-size: 10px; color: var(--muted); margin-right: 8px; }
  .comms-controls input[type="range"] { width: 70px; }
  .comms-container { display: flex; flex-direction: column; gap: 8px; }
  /* v15-H: top row = graph (70%) + table (30%); bottom row = transcript full-width */
  .comms-container.comms-split { flex-direction: column; gap: 10px; height: 100%; min-height: 0; }
  .comms-container.comms-split .comms-top { flex: 1 1 auto; display: flex; flex-direction: row; gap: 8px; min-height: 60px; }
  .comms-container.comms-split .comms-graph-pane { flex: 1 1 70%; display: flex; flex-direction: column; gap: 4px; min-width: 0; min-height: 0; overflow: hidden; }
  .comms-container.comms-split .comms-graph-pane .comms-svg-wrap { flex: 1 1 auto; min-height: 0; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .comms-container.comms-split .comms-graph-pane .comms-svg-wrap svg { width: 100%; height: 100%; max-height: 100%; display: block; }
  .comms-container.comms-split .comms-h-splitter { flex: 0 0 5px; height: 5px; cursor: ns-resize; background: linear-gradient(to bottom, transparent 0%, #2a2a3a 50%, transparent 100%); margin: 0 20px; border-radius: 2px; }
  .comms-container.comms-split .comms-h-splitter:hover, .comms-container.comms-split .comms-h-splitter.dragging { background: linear-gradient(to bottom, transparent 0%, #a855f7 50%, transparent 100%); }
  .comms-container.comms-split .comms-bottom { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 100px; }
  .comms-container.comms-split .comms-bottom .comms-transcript { flex: 1 1 auto; }
  .comms-container.comms-split .comms-transcript { flex: 1 1 60%; display: flex; flex-direction: column; min-width: 0; min-height: 0; background: #0b0b0d; border: 1px solid #1f2937; border-radius: 5px; overflow: hidden; }
  .comms-container.comms-split .comms-top .comms-table-wrap { flex: 1 1 30%; display: flex; flex-direction: column; min-width: 180px; max-width: 40%; min-height: 0; max-height: none !important; background: #0b0b0d; border: 1px solid #1f2937; border-radius: 5px; overflow: hidden; }
  .comms-container.comms-split .comms-table-scroll { flex: 1 1 auto; overflow: auto; }
  .comms-container.comms-split .comms-table { width: 100%; border-collapse: collapse; font-size: 10px; }
  .comms-container.comms-split .comms-table th, .comms-container.comms-split .comms-table td { padding: 3px 6px; border-bottom: 1px dotted rgba(42,42,58,0.5); text-align: left; }
  .comms-container.comms-split .comms-table th { position: sticky; top: 0; background: #0f1115; color: #9ca3af; font-weight: 600; font-size: 9px; text-transform: uppercase; letter-spacing: 0.05em; }
  .comms-container.comms-split .comms-table td.r, .comms-container.comms-split .comms-table th.r { text-align: right; font-family: ui-monospace,SFMono-Regular,Menlo,monospace; color: #c9d6ee; }
  .comms-container.comms-split .comms-tr-head { padding: 6px 10px; border-bottom: 1px solid #1f2937; display: flex; justify-content: space-between; align-items: center; font-size: 11px; flex: 0 0 auto; }
  .comms-container.comms-split .comms-tr-title { color: #a7f3d0; letter-spacing: 0.05em; text-transform: uppercase; font-weight: 600; }
  .comms-container.comms-split .comms-tr-hint { color: #6b7280; font-size: 10px; }
  .comms-container.comms-split .comms-tr-body { flex: 1 1 auto; overflow-y: auto; padding: 6px 4px; }
  .comms-container.comms-split .xmsg { padding: 6px 10px; border-bottom: 1px dotted rgba(42,42,58,0.5); }
  .comms-container.comms-split .xmsg-head { display: flex; gap: 8px; align-items: center; font-size: 10px; margin-bottom: 3px; }
  .comms-container.comms-split .xmsg-ts { color: #6b7280; font-family: ui-monospace,SFMono-Regular,Menlo,monospace; }
  .comms-container.comms-split .xmsg-arrow { font-family: ui-monospace,SFMono-Regular,Menlo,monospace; font-size: 10px; }
  .comms-container.comms-split .xmsg-body { font-size: 11px; color: #c9d6ee; word-break: break-word; line-height: 1.5; font-family: ui-sans-serif,system-ui,sans-serif; }
  .comms-container.comms-split .xmsg-md p { margin: 0 0 6px; }
  .comms-container.comms-split .xmsg-md p:last-child { margin-bottom: 0; }
  .comms-container.comms-split .xmsg-md code { background: #0f1115; color: #a7f3d0; padding: 0 4px; border-radius: 2px; font-family: ui-monospace,SFMono-Regular,Menlo,monospace; font-size: 10.5px; }
  .comms-container.comms-split .xmsg-md pre { background: #0f1115; border: 1px solid #1f2937; padding: 6px 10px; border-radius: 3px; overflow-x: auto; white-space: pre-wrap; word-break: break-word; font-family: ui-monospace,SFMono-Regular,Menlo,monospace; font-size: 10.5px; margin: 4px 0; }
