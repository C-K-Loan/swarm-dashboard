        return `
          <div class="diff-snip-pair">
            <pre class="diff-snip-old"><code>${esc(oldT)}</code></pre>
            <pre class="diff-snip-new"><code>${esc(newT)}</code></pre>
          </div>`;
      }

      searchEl?.addEventListener("input", () => { search = searchEl.value.trim(); render(); });
      mergeEl?.addEventListener("change", () => { merge = mergeEl.checked; render(); });

      if (window._selectionBus) {
        window._selectionBus.subscribe((sc) => {
          scope = sc && (sc.agentIds || sc.titles || sc.timeRange) ? sc : null;
          render();
        });
      }

      loadData();
    })();
    // === /v16-D ===

    refresh();

    // Bucket dropdown drives the (hidden) bucket buttons, which URL sync, zoom and tests still use.
    (function installBucketSelect() {
      const sel = document.getElementById("bucket-select");
      if (!sel) return;
      const sync = () => { const a = document.querySelector("[data-bucket].active"); if (a) sel.value = a.getAttribute("data-bucket"); };
      sel.addEventListener("change", () => document.querySelector(`[data-bucket="${CSS.escape(sel.value)}"]`)?.click());
      document.querySelectorAll("[data-bucket]").forEach((b) => new MutationObserver(sync).observe(b, { attributes: true, attributeFilter: ["class"] }));
      sync();
    })();

    // Default selection on load: the first column, unless the user already picked something.
    (function selectFirstColumnOnLoad() {
      if (new URL(location.href).searchParams.get("select") === "none") return; // ?select=none keeps the fleet/org-wide default
      // The fleet scope lights every cell on load, so "untouched" means no user click/key in the chart yet.
      let touched = false;
      const chart = document.querySelector(".tl-chart-wrap");
      let applying = false;
      const mark = () => { if (!applying) touched = true; };
      chart?.addEventListener("pointerdown", mark, { capture: true });
      document.addEventListener("keydown", mark, { capture: true });
      // Any timeline selection not made by this default (cell, row, col, keyboard, scripted) hands control to the user.
      window._selectionBus?.subscribe((scope) => { if ((scope?.source === "timeline" || scope?.source === "comms") && !applying && window.__firstColApplied) touched = true; });
      // Late data loads re-render the chart and reset the scope, so re-apply until the user takes over.
      const started = Date.now();
      const tick = () => {
        if (touched || Date.now() - started > 90000) return;
        const want = new URL(location.href).searchParams.get("fleet") || "";
        const fleetReady = (document.getElementById("fleet-select")?.value || "") === want;
        const first = [...document.querySelectorAll("#tl-chart rect.col-header-hit")]
          .sort((a, b) => +a.getAttribute("data-col-ts") - +b.getAttribute("data-col-ts"))[0];
        const applied = window._lastSelAxis === "col" && first && window._lastSelColTs === +first.getAttribute("data-col-ts")
          && document.getElementById("tl-selection-range")?.classList.contains("active");
        if (first && fleetReady && !applied) {
          applying = true;
          try { first.dispatchEvent(new MouseEvent("click", { bubbles: true })); } finally { applying = false; }
          window.__firstColApplied = true;
        }
        setTimeout(tick, 1000);
      };
      setTimeout(tick, 400);
    })();

    // Far-left proxy scrollbar for the widget area, two-way synced with #widget-grid's scrollTop.
    (function installWidgetScrollbar() {
      const grid = document.getElementById("widget-grid"), bar = document.getElementById("widget-scrollbar");
      const main = document.querySelector("main.tl-page");
      if (!grid || !bar || !main) return;
      const spacer = bar.firstElementChild;
      let syncing = false;
      const layout = () => {
        if (main.classList.contains("chart-right")) {
          const h = Math.max(160, Math.floor(main.getBoundingClientRect().bottom - grid.getBoundingClientRect().top - 6));
          document.documentElement.style.setProperty("--tl-row-h", h + "px");
        }
        const r = grid.getBoundingClientRect(), overflow = grid.scrollHeight - grid.clientHeight;
        bar.hidden = overflow <= 1 || r.height < 40;
        if (bar.hidden) return;
        bar.style.top = Math.round(r.top) + "px";
        bar.style.height = Math.round(r.height) + "px";
        spacer.style.height = Math.round(r.height + overflow) + "px";
        bar.scrollTop = grid.scrollTop;
      };
      grid.addEventListener("scroll", () => { if (syncing) { syncing = false; return; } syncing = true; bar.scrollTop = grid.scrollTop; }, { passive: true });
      bar.addEventListener("scroll", () => { if (syncing) { syncing = false; return; } syncing = true; grid.scrollTop = bar.scrollTop; }, { passive: true });
      let raf = 0;
      const schedule = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; layout(); }); };
      window.addEventListener("resize", schedule);
      new ResizeObserver(schedule).observe(main);
      new MutationObserver(schedule).observe(grid, { attributes: true, attributeFilter: ["style", "class"], subtree: true });
      new MutationObserver(schedule).observe(main, { attributes: true, attributeFilter: ["class"] });
      schedule();
    })();

    // Selection highlights: accent band in the time axis (+ faint column tint) and tinted rows in the agent column.
    (function installSelectionHighlights() {
      const NS = "http://www.w3.org/2000/svg";
      const mk = (tag, attrs) => { const e = document.createElementNS(NS, tag); for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v)); return e; };
      let last = null;
      window._paintSelectionHighlights = () => {
        document.querySelectorAll("#tl-chart .sel-hl").forEach((n) => n.remove());
        const g = renderTimeline.lastGeometry, st = renderTimeline.lastState, svg = document.querySelector("#tl-chart svg");
        // Any narrowed scope (timeline or an A2A pick) paints; dropdown baselines carry no windows or range.
        const ws = last?.windows || (last?.agentIds && last?.timeRange ? [...last.agentIds].map((sid) => ({ sid, start: last.timeRange[0], end: last.timeRange[1] })) : []);
        if (!g || !st || !svg || !ws.length) return;
        const axis = document.getElementById("tl-axis"), sticky = document.getElementById("tl-sticky");
        const spans = [...new Map(ws.map((w) => [w.start + ":" + w.end, w])).values()];
        const body = svg.querySelector("#tl-axis");
        for (const w of spans) {
          const x0 = Math.max(g.labelWidth, g.xFor(w.start)), x1 = g.xFor(w.end);
          if (x1 <= x0) continue;
          svg.insertBefore(mk("rect", { class: "sel-hl", x: x0, y: 22, width: x1 - x0, height: Math.max(0, +svg.getAttribute("height") - 32), fill: "#5ce6c6", "fill-opacity": 0.07, "pointer-events": "none" }), body);
          axis?.insertBefore(mk("rect", { class: "sel-hl", x: x0, y: 0, width: x1 - x0, height: 22, fill: "#5ce6c6", "fill-opacity": 0.35, "pointer-events": "none" }), axis.querySelector(".col-header-hit"));
          axis?.append(mk("rect", { class: "sel-hl", x: x0, y: 20, width: x1 - x0, height: 3, fill: "#5ce6c6", "pointer-events": "none" }));
        }
        const sids = new Set(ws.map((w) => w.sid));
        st.visibleAgents.forEach((a, i) => {
          const ids = a.members ? a.members.map((m) => m.id) : [a.id];
          if (!ids.some((id) => sids.has(id))) return;
          const y = 24 + i * g.rowHeight - 2;
          const label = svg.querySelector(`.row-label[data-agent-row-i="${i}"]`), host = label?.parentNode || sticky; // pinned master lives in #tl-pin-label
          host?.insertBefore(mk("rect", { class: "sel-hl", x: 0, y, width: g.labelWidth, height: g.rowHeight - 1, fill: "#5ce6c6", "fill-opacity": 0.14, "pointer-events": "none" }), label);
          host?.insertBefore(mk("rect", { class: "sel-hl", x: 0, y, width: 3, height: g.rowHeight - 1, fill: "#5ce6c6", "pointer-events": "none" }), label);
        });
      };
      window._selectionBus?.subscribe((scope) => { last = scope; window._paintSelectionHighlights(); });
    })();

    // Selected-range chip: subscribe to the selection bus and surface the
    // from→to timestamps of whatever cells / column / row is active, pinned to
    // the top-left of the agent timeline chart. Updates live.
    (function installSelectionRangeChip() {
      const chip = document.getElementById("tl-selection-range");
      if (!chip || !window._selectionBus) return;
      const fmt = (ts) => {
        const d = new Date(ts * 1000);
        return d.toISOString().slice(5, 16).replace("T", " "); // "MM-DD HH:MM" (no Z)
      };
      window._selectionBus.subscribe((scope) => {
        const tr = scope && scope.timeRange;
        if (!tr || !tr[0] || !tr[1]) { chip.textContent = ""; chip.classList.remove("active"); return; }
        chip.innerHTML = `<span class="tl-sr-from">${fmt(tr[0])}</span> <span class="tl-sr-arrow">→</span> <span class="tl-sr-to">${fmt(tr[1])}</span> <span class="tl-sr-label">UTC</span>`;
        chip.classList.add("active");
      });
    })();

    // Keyboard navigation on the agent timeline: once a column OR a row has
    // been selected via click, Arrow keys iterate column-wise / row-wise and
    // Home/End jump to first/last. Wraps around cyclically.
    (function installChartNav() {
      // The real column grid (header hit-boxes); a row's cellStore coalesces idle runs, so it is not a grid.
      function cols() {
        return [...document.querySelectorAll("#tl-chart rect.col-header-hit")]
          .map(h => [+h.getAttribute("data-col-ts"), +h.getAttribute("data-col-end")])
          .sort((x, y) => x[0] - y[0]);
      }
      function colActive([a, b]) {
        const vs = renderTimeline.lastState;
        return !!vs && vs.cellStore.some(cells => (cells || []).some(c => c.state !== "idle" && (c.end_ts || c.start_ts + 60) > a && c.start_ts < b));
      }
      function rowCount() {
        const vs = renderTimeline.lastState;
        return vs ? (vs.visibleAgents?.length || 0) : 0;
      }
      function stepCol(delta, absolute) {
        const list = cols();
        if (!list.length) return;
        const cur = window._lastSelColTs;
        let idx = list.findIndex(c => c[0] === cur);
        if (absolute === "first") idx = 0;
        else if (absolute === "last") idx = list.length - 1;
        else if (idx < 0) idx = 0;
        else {
          // Arrow steps to the next column with activity, so the selection and state panel never go blank.
          for (let k = 1; k <= list.length; k++) {
            const j = (idx + delta * k + list.length * k) % list.length;
            if (colActive(list[j])) { idx = j; break; }
          }
        }
        const [a, b] = list[idx];
        window._lastSelAxis = "col";
        window._lastSelColTs = a; window._lastSelColEnd = b;
        selectColumn(a, b, false);
      }
      function stepRow(delta, absolute) {
        const n = rowCount();
        if (!n) return;
        let idx = window._lastSelRowIdx;
        if (absolute === "first") idx = 0;
        else if (absolute === "last") idx = n - 1;
        else {
          if (!Number.isInteger(idx)) idx = 0; else idx = (idx + delta + n) % n;
        }
        window._lastSelAxis = "row";
        window._lastSelRowIdx = idx;
        selectAgentRows([idx], false);
        // Scroll the row into view (vertical) if the chart is tall
        const rl = document.querySelector(`#tl-chart rect.row-label[data-agent-row-i="${idx}"]`);
        if (rl) {
          const r = rl.getBoundingClientRect();
          const wrap = document.querySelector(".tl-chart-wrap");
          if (wrap && (r.top < wrap.getBoundingClientRect().top || r.bottom > wrap.getBoundingClientRect().bottom)) {
            rl.scrollIntoView({ block: "nearest", inline: "nearest" });
          }
        }
      }
      document.addEventListener("keydown", (ev) => {
        // Only handle when focus isn't inside a text input / contenteditable
        const t = ev.target;
        if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
        const axis = window._lastSelAxis;
        if (axis === "col") {
          if (ev.key === "ArrowLeft")  { ev.preventDefault(); stepCol(-1); }
          else if (ev.key === "ArrowRight") { ev.preventDefault(); stepCol(+1); }
          else if (ev.key === "Home")  { ev.preventDefault(); stepCol(0, "first"); }
          else if (ev.key === "End")   { ev.preventDefault(); stepCol(0, "last"); }
        } else if (axis === "row") {
          if (ev.key === "ArrowDown") { ev.preventDefault(); stepRow(+1); }
          else if (ev.key === "ArrowUp") { ev.preventDefault(); stepRow(-1); }
          else if (ev.key === "Home") { ev.preventDefault(); stepRow(0, "first"); }
          else if (ev.key === "End")  { ev.preventDefault(); stepRow(0, "last"); }
        }
      });
    })();
  </script>
</Layout>

<style is:global>
  .tl-chart-wrap { position: relative; }
