  #widget-grid .widget .widget-help { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 15px; height: 15px; margin-left: 6px; border: 1px solid var(--border); border-radius: 50%; color: var(--muted); font-size: 10px; font-family: var(--mono); cursor: help; user-select: none; }
