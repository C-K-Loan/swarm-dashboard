    // v15-I: Persist toolbar state (rows, bucket, range, judge, filter, sort,
    // org, fleet) to URL params so refresh restores the view. Also makes URLs
    // shareable. Reads params on DOMContentLoaded and writes on every change.
    (function installUrlStateSync() {
      // (query-param name) -> { getEl, read, apply }
      const spec = {
        rows:   { el: () => document.getElementById("row-level") },
        range:  { el: () => document.getElementById("range-select") },
        judge:  { el: () => document.getElementById("model-select") },
        filter: { el: () => document.getElementById("agent-filter") },
        sort:   { el: () => document.getElementById("sort-select") },
        org:    { el: () => document.getElementById("org-select") },
        fleet:  { el: () => document.getElementById("fleet-select") },
      };
      function writeParam(key, val) {
        const u = new URL(location.href);
        if (val == null || val === "" || val === "default") u.searchParams.delete(key);
        else u.searchParams.set(key, val);
        history.replaceState({}, "", u.toString());
      }
      function syncParamToEl(key, s) {
        const el = s.el(); if (!el) return;
        const p = new URL(location.href).searchParams.get(key);
        if (p == null) return;
        if (el.value === p) return;
        el.value = p;
        el.dispatchEvent(new Event("change", { bubbles: true }));
        // Some selects also need a custom event for the viz bus
        if (key === "fleet") window.dispatchEvent(new CustomEvent("fleetchange", { detail: { fleet: p } }));
        if (key === "org") window.dispatchEvent(new CustomEvent("orgchange", { detail: { org: p } }));
      }
      function attach() {
        for (const [key, s] of Object.entries(spec)) {
          const el = s.el(); if (!el) continue;
          syncParamToEl(key, s);
          const ev = (el.tagName === "INPUT") ? "input" : "change";
          el.addEventListener(ev, () => writeParam(key, el.value));
        }
        // Bucket is 5 buttons with data-bucket attribute; the active one has .active
        const bucketBtns = document.querySelectorAll("[data-bucket]");
        if (bucketBtns.length) {
          const p = new URL(location.href).searchParams.get("bucket");
          if (p) {
            const match = [...bucketBtns].find(b => b.getAttribute("data-bucket") === p);
            if (match) match.click();
          }
          bucketBtns.forEach(b => b.addEventListener("click", () => {
            writeParam("bucket", b.getAttribute("data-bucket"));
          }));
        }
      }
      // Re-sync fleet + org a few times after dropdown options finish populating.
      // The fleet <select> is populated lazily from data.agents mid-script, so
      // the first sync pass misses it.
      function resyncLazy() {
        for (const key of ["fleet", "org"]) {
          const s = spec[key]; const el = s.el(); if (!el) continue;
          const want = new URL(location.href).searchParams.get(key);
          if (!want || el.value === want) continue;
          const hasOpt = [...el.options].some(o => o.value === want);
          if (hasOpt) syncParamToEl(key, s);
        }
      }
      setTimeout(resyncLazy, 300);
      setTimeout(resyncLazy, 1000);
      setTimeout(resyncLazy, 2500);
      if (document.readyState === "loading") {
        window.addEventListener("DOMContentLoaded", attach, { once: true });
      } else attach();
    })();
    // Pre-compute per-session media list for fast per-cell poster lookup
    window._mediaBySession = {};
    for (const sid in artifacts) {
      const media = (artifacts[sid] || []).filter((x) => x.kind === "media" && x.web_url);
      if (media.length) window._mediaBySession[sid] = media;
    }
    function pickPosterForWindow(sessionId, startTs, endTs) {
      const media = window._mediaBySession[sessionId] || [];
      if (!media.length) return null;
      let lo = 0, hi = media.length;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        if (media[mid].ts < startTs) lo = mid + 1; else hi = mid;
      }
      let best = null;
      for (let k = lo; k < media.length && media[k].ts < endTs; k++) {
        const m = media[k];
        if (/\.(png|jpg|jpeg|webp)$/i.test(m.basename)) {
          if (!best || m.ts > best.ts) best = m;
        }
      }
      if (best) return best;
      for (let k = lo; k < media.length && media[k].ts < endTs; k++) return media[k];
      return null;
    }
    function countMediaInWindow(sessionId, startTs, endTs) {
      const media = window._mediaBySession[sessionId] || [];
      if (!media.length) return 0;
      // Binary search for the first ts >= startTs (media is already ts-sorted
      // by the ingest). O(log n + k) instead of O(n) per cell — critical on
      // hourly/all-time renders that call this >100k times.
      let lo = 0, hi = media.length;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        if (media[mid].ts < startTs) lo = mid + 1; else hi = mid;
      }
      let n = 0;
      for (let k = lo; k < media.length && media[k].ts < endTs; k++) n++;
      return n;
    }
    // Vivid state colors — judges should spot across the room
    const COLORS = {
      blocked: "#ff2d4a",           // deep red
      waiting: "#ffd93d",            // bright yellow
      working: "#2eff6a",            // saturated green
      context_exhausted: "#ff7a1a",  // orange
      idle: "#3a3a4a",               // muted gray
    };
    const STATE_ORDER = ["blocked", "waiting", "context_exhausted", "working", "idle"];

    // Compact model label: "claude-opus-5-5" -> "opus-5.5", "gpt-6.1-sol" -> "gpt-6.1"
    function compactModelName(m) {
      if (!m) return "";
      let s = String(m).trim();
      s = s.replace(/^claude-/, "");
      s = s.replace(/^(opus|sonnet|haiku|fable)-(\d+)-(\d+)$/, "$1-$2.$3");
      s = s.replace(/^gpt-(\d+(?:\.\d+)?)(?:-\w+)?$/, "gpt-$1");
      s = s.replace(/^Qwen\/Qwen3-(.+?)-Instruct.*$/i, "qwen3-$1".toLowerCase());
      return s.toLowerCase();
    }
    function modelFamily(m) {
      const s = String(m || "").toLowerCase();
      if (s.includes("opus")) return "opus";
      if (s.includes("sonnet")) return "sonnet";
      if (s.includes("haiku")) return "haiku";
      if (s.includes("fable")) return "fable";
      if (s.includes("gpt")) return "gpt";
      if (s.includes("qwen")) return "qwen";
      if (s.includes("codex")) return "codex";
      return "other";
    }
    const MODEL_FAMILY_COLORS = {
      opus: "#c9a0ff", sonnet: "#8fb8ff", haiku: "#5cff8c", fable: "#ff9fe0",
      gpt: "#2eff6a", qwen: "#ffb86c", codex: "#8a8aa0", other: "#8a8aa0",
    };
    function modelColor(fam) { return MODEL_FAMILY_COLORS[fam] || "#8a8aa0"; }
    function computeModelLabel(agent) {
      const list = agent.models || [];
      if (!list.length) {
        if (agent.model) {
          const label = compactModelName(agent.model);
          return { label, family: modelFamily(agent.model), tooltip: agent.model };
        }
        return { label: "", family: "other", tooltip: "" };
      }
      const top = list[0];
      const extra = list.length - 1;
      const label = compactModelName(top.model) + (extra > 0 ? "+" + extra : "");
      const tooltip = list.map((x) => compactModelName(x.model) + " ×" + x.count).join(", ");
      return { label, family: modelFamily(top.model), tooltip };
    }

    // Compute per-segment opacity based on urgency count distribution
    function urgencyBoost(seg) {
      const u = seg.urgencies || {};
      const high = u.high || 0;
      const mid = u.mid || 0;
      const low = u.low || 0;
      const total = high + mid + low;
      if (total === 0) return 0.75;
      const highFrac = high / total;
      const midFrac = mid / total;
      // high → full opacity, low → muted
      return Math.max(0.55, 0.65 + highFrac * 0.35 + midFrac * 0.15);
    }

    // Filter agents to range
    function filterRange(agents, rangeKey, preserveEmpty = false) {
      const maxTs = data.time_range.max_ts;
      let cutoff = 0;
      if (rangeKey === "7d") cutoff = maxTs - 7 * 86400;
      else if (rangeKey === "24h") cutoff = maxTs - 86400;
      else if (rangeKey === "1h") cutoff = maxTs - 3600;
      return agents.map((a) => ({
        ...a,
        segments: a.segments.filter((s) => s.end_ts >= cutoff),
      })).filter((a) => preserveEmpty || a.segments.length);
    }

    function filterText(agents, q) {
      if (!q) return agents;
      const ql = q.toLowerCase();
      return agents.filter((a) =>
        a.title.toLowerCase().includes(ql) ||
        (a.project || "").toLowerCase().includes(ql) ||
        (a.fleet || "").toLowerCase().includes(ql)
      );
    }
    function filterFleet(agents, fleet) {
      if (!fleet) return agents;
      return agents.filter((a) => (a.fleet || "") === fleet);
    }
    // Org filter — looks up each agent id in the hierarchy agentToOrg map.
    let _orgHierarchy = null;
    async function loadOrgHierarchy() {
      if (_orgHierarchy) return _orgHierarchy;
      try {
        const r = await fetch("/data/timeline_hierarchy.json");
        if (r.ok) _orgHierarchy = await r.json();
      } catch {}
      return _orgHierarchy;
    }
    function filterOrg(agents, org) {
      if (!org) return agents;
      const atOrg = _orgHierarchy?.agentToOrg || {};
      return agents.filter((a) => atOrg[a.id] === org);
    }

    // v14-GG: unified sort with 6 modes
    function sortAgents(agents, mode) {
      const by = (fn, dir = -1) => (a, b) => (fn(a) - fn(b)) * dir;
      switch (mode) {
        case "last-activity":
          return [...agents].sort(by((a) => Math.max(...a.segments.map((s) => s.end_ts || s.start_ts))));
        case "messages":
          return [...agents].sort(by((a) => a.total_turns || 0));
        case "cost":
          return [...agents].sort(by((a) => a.total_cost_usd || 0));
        case "alpha":
          return [...agents].sort((a, b) => (a.title || "").localeCompare(b.title || ""));
        case "status":
          return sortAgentsByState(agents);
        case "activity": {
          // Most turns in the current fleet/range first; ties by name.
          const turns = new Map(agents.map((a) => [a, rangeTurns(a)]));
          return [...agents].sort((a, b) => turns.get(b) - turns.get(a) || (a.title || "").localeCompare(b.title || ""));
        }
        case "first-activity":
        default:
          // Spawn order: whoever was active first comes first.
          return [...agents].sort((a, b) => Math.min(...a.segments.map((s) => s.start_ts)) - Math.min(...b.segments.map((s) => s.start_ts)) || (a.title || "").localeCompare(b.title || ""));
      }
    }

    // Turns inside the current range (segments are already range-filtered); the row label shows this same number.
    function rangeTurns(a) {
      return a.segments.length && a.segments.every((s) => s.turn_count != null) ? a.segments.reduce((n, s) => n + s.turn_count, 0) : a.total_turns || 0;
    }
    // Nav header toggle: activity | spawn order; drives #sort-select so the URL (?sort=) and other sorts stay in one place.
    function sortToggle(labelWidth) {
      const cur = window._agentSort || "activity";
      const opt = (mode, label) => `<tspan data-sort-mode="${mode}" fill="${cur === mode ? "#00e8c6" : "#6a6a7a"}" font-weight="${cur === mode ? 700 : 400}" style="cursor:pointer">${label}</tspan>`;
      return `<text class="tl-sort-toggle" x="${labelWidth - 6}" y="15" text-anchor="end" font-family="SF Mono,Menlo,monospace" font-size="10"><title>sort agent rows: most turns in this fleet/range first, or spawn order</title>${opt("activity", "activity")}<tspan fill="#4a4a5a"> | </tspan>${opt("first-activity", "spawn order")}</text>`;
    }
    document.getElementById("tl-chart")?.addEventListener("click", (ev) => {
      const mode = ev.target.closest?.("[data-sort-mode]")?.getAttribute("data-sort-mode");
      const sel = document.getElementById("sort-select");
      if (!mode || !sel) return;
      ev.stopPropagation();
      if (sel.value !== mode) { sel.value = mode; sel.dispatchEvent(new Event("change", { bubbles: true })); }
    }, true);

    function sortAgentsByState(agents) {
      // Prefer agents with any blocked/waiting segment at top
      const rank = (a) => {
        const hasBlocked = a.segments.some((s) => s.state === "blocked");
        const hasWaiting = a.segments.some((s) => s.state === "waiting" || s.state === "context_exhausted");
        if (hasBlocked) return 0;
        if (hasWaiting) return 1;
        if (a.segments.some((s) => s.state === "working")) return 2;
        return 3;
      };
      return [...agents].sort((a, b) => rank(a) - rank(b) || (a.project || "").localeCompare(b.project || ""));
    }

    // State dominance helper for aggregating segments within a bucket
    const STATE_RANK = { blocked: 5, context_exhausted: 4, waiting: 3, working: 2, idle: 1 };
    function dominantState(bucket) {
      // Max turn-weighted state in bucket
      const w = {};
      for (const s of bucket.segs) w[s.state] = (w[s.state] || 0) + s.turn_count;
      let best = null, bestN = -1;
      for (const [st, n] of Object.entries(w)) {
        if (n > bestN || (n === bestN && (STATE_RANK[st] || 0) > (STATE_RANK[best] || 0))) {
          best = st; bestN = n;
        }
      }
      return best;
    }

    // Build buckets for one agent at a given bucket width (seconds)
    function bucketizeAgent(agent, minTs, maxTs, bucketSec) {
      const buckets = [];
      // Pre-create empty buckets covering range
      const bucketCount = Math.ceil((maxTs - minTs) / bucketSec);
      for (let i = 0; i < bucketCount; i++) {
        buckets.push({
          start_ts: minTs + i * bucketSec,
          end_ts: minTs + (i + 1) * bucketSec,
          state: "idle",
          turn_count: 0,
          segs: [],
          cost_usd: 0,
          tokens_in: 0,
          tokens_out: 0,
          intents: {},
          user_intents: {},
          roles: {},
          blockers: {},
          urgencies: {},
          sample_text: "",
          latest_text: "",
          file_edits_count: 0,
          errors_count: 0,
          blocker_type: null,
        });
      }
      // Assign each segment to the bucket containing its start_ts
      for (const seg of agent.segments) {
        const idx = Math.floor((seg.start_ts - minTs) / bucketSec);
        if (idx < 0 || idx >= buckets.length) continue;
        const b = buckets[idx];
        b.segs.push(seg);
        b.turn_count += seg.turn_count;
        b.cost_usd += seg.cost_usd;
        b.tokens_in += seg.tokens_in;
        b.tokens_out += seg.tokens_out;
        for (const [k, v] of Object.entries(seg.intents || {})) b.intents[k] = (b.intents[k] || 0) + v;
        for (const [k, v] of Object.entries(seg.user_intents || {})) b.user_intents[k] = (b.user_intents[k] || 0) + v;
        for (const [k, v] of Object.entries(seg.roles || {})) b.roles[k] = (b.roles[k] || 0) + v;
        for (const [k, v] of Object.entries(seg.blockers || {})) b.blockers[k] = (b.blockers[k] || 0) + v;
        for (const [k, v] of Object.entries(seg.urgencies || {})) b.urgencies[k] = (b.urgencies[k] || 0) + v;
        b.file_edits_count += seg.file_edits_count || 0;
        b.errors_count += seg.errors_count || 0;
        if (!b.sample_text && seg.sample_text) b.sample_text = seg.sample_text;
        if (seg.latest_text) b.latest_text = seg.latest_text;
        if (!b.blocker_type && seg.blocker_type) b.blocker_type = seg.blocker_type;
      }
      // Derive dominant state per bucket
      for (const b of buckets) {
        if (b.segs.length === 0) {
          b.state = "idle";
        } else {
          b.state = dominantState(b);
          // Blocker type = most frequent across segs
          const blockEntries = Object.entries(b.blockers).sort((a, c) => c[1] - a[1]);
          if (blockEntries.length) b.blocker_type = blockEntries[0][0];
        }
      }
      return buckets;
    }

    // v15-E: spawn hierarchy — children indented under their parent (spawn_tree.json: { parents: {title: parentTitle|null} }).
    // Tolerant: missing/changed file or no relations among visible agents → flat order untouched.
    window._spawnParents = window._spawnParents || null;
    window._spawnCollapsed = window._spawnCollapsed || (() => { try { return new Set(JSON.parse(localStorage.getItem("cct_spawn_collapsed_v1") || "[]")); } catch (_) { return new Set(); } })();

    // Chart collapse toggle — frees the whole chart area so widgets fill the viewport.
    (() => {
      const wrap = document.querySelector(".tl-chart-wrap");
      const btn = document.getElementById("tl-chart-collapse");
      if (!wrap || !btn) return;
      const KEY = "cct_chart_collapsed_v1";
      const apply = (on) => {
        wrap.classList.toggle("collapsed", on);
        btn.textContent = on ? "chart: collapsed" : "chart: shown";
        btn.title = on ? "expand timeline chart" : "collapse timeline chart";
