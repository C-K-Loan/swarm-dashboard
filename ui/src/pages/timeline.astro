  .comms-container.comms-split .xmsg-page-bar { display: flex; justify-content: space-between; align-items: center; padding: 4px 10px; background: #0f1115; color: #9ca3af; font-size: 10px; border-bottom: 1px solid #1f2937; position: sticky; top: 0; z-index: 1; }
  .comms-container.comms-split .xmsg-page-bar strong { color: #a7f3d0; }
  .comms-container.comms-split .xmsg-jump-latest { background: #1f2937; color: #a7f3d0; border: 1px solid #374151; padding: 2px 8px; border-radius: 3px; cursor: pointer; font: 10px ui-monospace,SFMono-Regular,Menlo,monospace; }
  .comms-container.comms-split .xmsg-jump-latest:hover { background: #374151; }
  .comms-container.comms-split .xmsg-sentinel { padding: 8px; text-align: center; border-top: 1px dashed #1f2937; }
  .comms-container.comms-split .xmsg-load-more { background: #0f1115; color: #c9d6ee; border: 1px solid #1f2937; padding: 4px 14px; border-radius: 3px; cursor: pointer; font: 10px ui-monospace,SFMono-Regular,Menlo,monospace; }
  .comms-container.comms-split .xmsg-load-more:hover { background: #1f2937; color: #a7f3d0; border-color: #374151; }
  .comms-container.comms-split .xmsg-tn-toggle { display: inline-flex; align-items: center; gap: 4px; margin-right: 10px; cursor: pointer; color: #9ca3af; font: 10px ui-monospace,SFMono-Regular,Menlo,monospace; user-select: none; }
  .comms-container.comms-split .xmsg-tn-toggle input { margin: 0; cursor: pointer; }
  /* Fullscreen: top half still graph, bottom still transcript+table. Graph pane needs
   * explicit max-height so the SVG doesn't gobble the whole widget. */
  #widget-grid.has-expanded-widget .grid-stack-item.widget-expanded .comms-container.comms-split .comms-top { flex: 1 1 auto; }
  .comms-table tr.comms-ch-row { cursor: pointer; }
  .comms-table tr.comms-ch-row:hover td, .comms-table tr.comms-ch-row.active td { background: rgba(92,230,198,.12); }
  #widget-grid.has-expanded-widget .grid-stack-item.widget-expanded .comms-container.comms-split .comms-bottom { flex: 1 1 auto; }
  .comms-svg-wrap { position: relative; display: flex; justify-content: center; width: 100%; }
  .comms-svg-wrap svg { width: 100%; height: auto; display: block; }
  .comms-table-wrap { overflow-y: auto; max-height: 110px; }
  .comms-legend { display: flex; flex-wrap: wrap; gap: 6px 10px; font-size: 9px; color: var(--muted); padding: 0 4px; line-height: 1.1; }
  .comms-legend .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 2px; vertical-align: middle; }
  .comms-table { width: 100%; font-size: 10px; border-collapse: collapse; }
