  .comms-info { font-size: 9.5px; color: var(--muted); padding: 2px 6px; background: var(--panel-2); border-radius: 3px; line-height: 1.3; }
  .comms-container.comms-split .comms-graph-pane .comms-legend { padding: 1px 4px; margin: 0; }
  .comms-container.comms-split .comms-graph-pane .comms-info { margin: 0; }
  .comms-container.comms-split .comms-graph-pane { gap: 2px; }
  .tl-top-3col { grid-template-columns: 1.1fr 2fr 1fr; }
  .dev-toggle { margin-left: auto; display: inline-flex; gap: 10px; font-weight: 400; text-transform: none; letter-spacing: 0; font-size: 10px; color: var(--muted); }
  .dev-toggle label { cursor: pointer; display: inline-flex; align-items: center; gap: 4px; }
