---
import Layout from "../layouts/Layout.astro";
import "../styles/v02.css";
import hierarchyOverrides from "../config/timeline-hierarchy.json";
import fs from "node:fs";
import path from "node:path";
import { timelineRuns, runText } from "../lib/v02-store";
const teacherRuns = timelineRuns();

// Local, ignored sidecar generated read-only from CCT/orchestrator metadata.
let sourceMembership: any = {};
try { sourceMembership = JSON.parse(fs.readFileSync(path.resolve("../data/timeline_hierarchy.json"), "utf-8")); } catch (_) {}
const hierarchyConfig = {
  ...sourceMembership,
  ...hierarchyOverrides,
  orgs: hierarchyOverrides.orgs.length ? hierarchyOverrides.orgs : sourceMembership.orgs || [],
  agentToOrg: { ...sourceMembership.agentToOrg, ...hierarchyOverrides.agentToOrg },
};

const dataPath = path.resolve("../data/timeline.json");
let data: any = { agents: [], aggregate: {}, time_range: {} };
try {
  data = JSON.parse(fs.readFileSync(dataPath, "utf-8"));
} catch (e) {}

const artifactsPath = path.resolve("../data/artifacts.json");
let artifacts: Record<string, any[]> = {};
try {
  artifacts = JSON.parse(fs.readFileSync(artifactsPath, "utf-8"));
} catch (e) {}
---
<Layout title="Timeline · swarm-board">
  <div class="tl-controls" slot="header-controls" title={`${data.aggregate.agent_count} agents · ${data.aggregate.segment_count?.toLocaleString()} segments · ${(data.time_range.span_sec/3600).toFixed(0)}h observed · $${data.aggregate.total_cost_usd?.toFixed(4)} classifier cost`}>
        <label class="label" for="row-level">rows</label>
        <select id="row-level" aria-label="Timeline row level" title="rows: agent / fleet / org">
          <option value="agent">Agent</option>
          <option value="fleet">Fleet</option>
          <option value="org">Org</option>
        </select>
        <span class="label">bucket</span>
        <select id="bucket-select" aria-label="Time bucket" title="time bucket (column width)"><option value="raw">turn</option><option value="300">5min</option><option value="900">15min</option><option value="3600">hour</option><option value="14400">4h</option><option value="86400">day</option></select>
        <span class="bucket-btns" hidden>
        <button class="btn" data-bucket="raw" title="finest resolution: one slot per turn">turn</button>
        <button class="btn" data-bucket="300">5min</button>
        <button class="btn" data-bucket="900">15min</button>
        <button class="btn" data-bucket="3600">hour</button>
        <button class="btn" data-bucket="14400" title="4-hour bucket (6 per day): 00-04 / 04-08 / 08-12 / 12-16 / 16-20 / 20-00">4h</button>
        <button class="btn active" data-bucket="86400">day</button>
        </span>
        <span class="label">range</span>
        <select id="range-select" aria-label="Time range" title="time range">
          <option value="all">all time</option>
          <option value="7d" selected>last 7 days</option>
          <option value="24h">last 24h</option>
          <option value="1h">last hour</option>
        </select>
        <span class="label">filter</span>
        <input type="text" id="agent-filter" placeholder="filter agents…" title="filter agents / projects" style="width:100px" />
      </div>
  <main class="tl-page">

    <div class="widget-toolbar" id="widget-toolbar">
      <details class="wt-widgets" id="wt-widgets">
        <summary class="wt-btn" title="show / hide widgets">widgets <span id="wt-widgets-n"></span> ▾</summary>
        <div class="wt-menu">
      <label><input type="checkbox" data-widget-toggle="state-graph" checked /> task graph</label>
      <label><input type="checkbox" data-widget-toggle="prose" checked /> summary</label>
      <label><input type="checkbox" data-widget-toggle="stats" checked /> stats</label>
      <label><input type="checkbox" data-widget-toggle="transcript" checked /> chat transcript</label>
      <label><input type="checkbox" data-widget-toggle="artifacts" checked /> artifacts</label>
      <label><input type="checkbox" data-widget-toggle="comms" checked /> A2A comms</label>
      <label><input type="checkbox" data-widget-toggle="diffs" checked /> file diffs</label>
      <label><input type="checkbox" data-widget-toggle="tree" checked /> file tree</label>
      <label><input type="checkbox" data-widget-toggle="spawn-tree" checked /> spawn tree</label>
        </div>
      </details>
      <label class="wt-field" title="prompt contract the labels were generated with"><select class="wt-select" id="v02-prompt" aria-label="Prompt version"><option value="v0.2-full">v0.2 full</option><option value="v0.3-lean">v0.3 lean</option></select></label>
      <label class="wt-field" title="labels: which model labeled the V0.2 task graph (drives every widget)"><select class="wt-select" id="v02-teacher" aria-label="Labels model">{teacherRuns.map(r=><option value={r.name} data-prompt={r.prompt} data-model={r.model} data-label={r.label} title={r.name}>{runText(r)}</option>)}</select></label>
      <button class="wt-btn" id="wt-edit" title="edit layout: drag widgets by their title bar, resize from the corner grip">Edit</button>
      <button class="wt-btn wt-done" id="wt-done" title="drag a widget by its ⠿ title bar to reorder; drag the corner grip to change width (half / full) and height. Click to finish." hidden>Done</button>
      <button class="wt-btn" id="wt-reset" title="restore the default layout">Reset</button>
      <details class="wt-widgets wt-chart-menu" id="wt-chart-menu">
        <summary class="wt-btn" title="chart and layout options">Chart ▾</summary>
        <div class="wt-menu">
          <button class="wt-btn" id="tl-chart-collapse" title="collapse / expand timeline chart">▾</button>
          <button class="wt-btn" id="wt-chart-pos" title="toggle agent timeline chart position: bottom (default) ↔ right side column">chart: bottom</button>
          <button class="wt-btn" id="wt-chart-fit" title="set the chart height to show every agent row (max 70% of the window); drag the bar above the chart to fine-tune">fit rows</button>
          <button class="wt-btn" id="wt-row-density" title="agent row height: compact (2x more agents fit) or comfortable (taller rows with cell thumbnails and prose previews)">rows: compact</button>
          <button class="wt-btn" id="wt-chart-compact" title="collapse long stretches of empty buckets to a narrow gap marker (makes 'all time' views on sparse fleets fit the viewport)">compact: off</button>
          <label class="wt-field" title="layout preset">layout <select class="wt-select" id="wt-profile"></select></label>
        </div>
      </details>
      <span id="tl-selection-range" class="tl-selection-range" aria-live="polite"></span>
      <span class="selection-chip-slot" id="selection-chip-slot" hidden></span>
      <span id="hierarchy-status" class="hierarchy-status" aria-live="polite"></span>
    </div>
    <section class="tl-top grid-stack" id="widget-grid">
      <div class="grid-stack-item" gs-id="state-graph" gs-x="0" gs-y="0" gs-w="7" gs-h="7"><div class="grid-stack-item-content widget col col-summary col-state-graph" data-widget-id="state-graph">
        <div class="widget-header"><h3>task graph</h3><span class="widget-help" title="V0.2/V0.3 task/decision graph for the selection, labeled by the run chosen in the header labels dropdown. Replay steps through the selected turns.">?</span><button class="widget-expand" title="expand (fullscreen) / restore" aria-label="Expand task graph">⛶</button><button class="widget-close" data-widget-close="state-graph" title="hide" aria-label="Hide task graph">×</button></div>
        <div class="col-body summary-body">
          <div class="bucket-summary-section" id="bucket-summary-section" hidden>
            <div class="bs-body" id="bs-body"></div>
          </div>
        </div>
      </div></div>
      <div class="grid-stack-item" gs-id="prose" gs-x="6" gs-y="0" gs-w="6" gs-h="7"><div class="grid-stack-item-content widget col col-summary col-prose" data-widget-id="prose">
        <div class="widget-header"><h3>summary</h3><span class="widget-help" title="Prose summaries of the selection: V0.1 hourly bullets, or V0.1.B hierarchically merged bullets (snapped to one merge-tree node, merge model selectable).">?</span><button class="widget-expand" title="expand (fullscreen) / restore" aria-label="Expand summary">⛶</button><button class="widget-close" data-widget-close="prose" title="hide" aria-label="Hide summary">×</button></div>
        <div class="col-body summary-body">
          <div class="bucket-summary-section" id="prose-section" hidden>
            <div class="bs-head prose-head">
              <select id="summary-version" class="prose-select" title="summary version" aria-label="Summary version"><option value="0.1b">V0.1.B merged</option><option value="0.1">V0.1 bullets</option></select>
              <span id="prose-head" class="prose-tools"></span>
              <label class="bs-toggle prose-ts" title="show how long ago each bullet happened"><input type="checkbox" id="bs-show-ts" /> timestamps</label>
            </div>
            <div class="bs-body" id="prose-body"></div>
          </div>
        </div>
      </div></div>
      <div class="grid-stack-item" gs-id="stats" gs-x="7" gs-y="7" gs-w="5" gs-h="3"><div class="grid-stack-item-content widget col col-summary col-stats" data-widget-id="stats">
        <div class="widget-header"><h3>stats <span class="col-sub" id="summary-sub"></span></h3><span class="widget-help" title="Aggregates for the current selection: total cost/tokens/turns across picked cells, duration window, and classifier label histograms (user_intent, agent_role, blocker_type, urgency). Classifier labels come from Qwen3-30B-A3B.">?</span><button class="widget-expand" title="expand (fullscreen) / restore" aria-label="Expand stats">⛶</button><button class="widget-close" data-widget-close="stats" title="hide" aria-label="Hide stats">×</button></div>
        <div class="col-body summary-body" id="summary-body">
          <div class="summary-aggregates" id="summary-aggregates">
            <p id="s-cost" class="s-cost-line"><span class="hint">—</span></p>
            <div class="summary-triple">
              <div class="summary-triple-cell">
                <div class="summary-label">👤 legacy V0.1 human labels</div>
                <div id="s-labels-human" class="lab-cell"><p class="hint">pick a cell</p></div>
              </div>
              <div class="summary-triple-cell">
                <div class="summary-label">🤖 legacy V0.1 agent labels</div>
                <div id="s-labels-agent" class="lab-cell"><p class="hint">pick a cell</p></div>
              </div>
            </div>
          </div>
        </div>
      </div></div>
      <div class="grid-stack-item" gs-id="transcript" gs-x="0" gs-y="7" gs-w="7" gs-h="6"><div class="grid-stack-item-content widget col col-summary col-transcript" data-widget-id="transcript">
        <div class="widget-header"><h3>chat transcript <span class="col-sub" id="tx-sub"></span></h3><span class="widget-help" title="Messages in the current selection. Follows the shared selection: chart cells, agent rows, A2A node/channel picks (channel picks show only that pair's messages).">?</span><button class="widget-expand" title="expand (fullscreen) / restore" aria-label="Expand chat transcript">⛶</button><button class="widget-close" data-widget-close="transcript" title="hide" aria-label="Hide chat transcript">×</button></div>
        <div class="col-body summary-body">
          <div class="transcript-section">
            <div class="transcript-head">
              <span class="transcript-controls">
                <label title="show tool-call blocks"><input type="checkbox" id="tx-tools" /> tools</label>
                <label title="show subagent reports"><input type="checkbox" id="tx-sub-cb" checked /> subagent</label>
                <label title="show agent-to-agent (cct send) messages"><input type="checkbox" id="tx-a2a" checked /> a2a</label>
                <label title="show human prompts (CKL typing)"><input type="checkbox" id="tx-human-cb" checked /> human</label>
                <label title="show CCT [heartbeat] health-sweep injections (off by default — hidden even when 'human' is on)"><input type="checkbox" id="tx-hb-cb" /> heartbeat</label>
                <label title="show Claude Code background-task completion notifications (off by default — delivered as user-role but not from you)"><input type="checkbox" id="tx-sys-cb" /> harness</label>
                <label title="show CCT spawn/boot prompts (\"You are X, …\") delivered as user-role when an agent starts"><input type="checkbox" id="tx-spawn-cb" checked /> spawn</label>
                <label title="show agent prose output"><input type="checkbox" id="tx-agent" checked /> agent</label>
              </span>
              <input type="text" id="tx-search" placeholder="search messages..." class="transcript-search" />
            </div>
            <div class="transcript-body" id="transcript-body">
              <p class="hint">pick a bucket on the timeline to see what actually happened</p>
            </div>
          </div>
        </div>
      </div></div>
      <div class="grid-stack-item" gs-id="artifacts" gs-x="6" gs-y="0" gs-w="6" gs-h="6"><div class="grid-stack-item-content widget col col-artifacts" data-widget-id="artifacts">
        <div class="widget-header">
          <h3>artifacts <span class="col-sub" id="art-sub"></span></h3>
          <span class="dev-toggle">
            <label><input type="radio" name="dev-mode" value="dev" checked /> dev</label>
            <label><input type="radio" name="dev-mode" value="nondev" /> non-dev</label>
            <label title="hide tiles whose source file is missing on disk (ghost paths from pruned worktrees)" style="margin-left:8px; font-size:10px"><input type="checkbox" id="art-hide-missing" /> hide missing</label>
            <label title="sort artifacts oldest-first instead of newest-first (renderable still ranks above ghost)" style="margin-left:8px; font-size:10px"><input type="checkbox" id="art-sort-oldest" /> oldest first</label>
          </span>
          <span class="widget-help" title="Rendered media (screenshots, videos, PDFs) + code edits the agent produced in the selection, scanned from tool_use blocks. DEV mode = full file-edit list with ghost/source markers. NON-DEV mode = bigger media grid + collapsed one-line code summary (judges-first). Auto-flips to non-dev when the bucket contains media.">?</span>
          <button class="widget-expand" title="expand (fullscreen) / restore">⛶</button><button class="widget-close" data-widget-close="artifacts" title="hide">×</button>
        </div>
        <div class="col-body" id="art-body">
          <p class="hint">rendered media + file edits scanned from raw tool_use blocks</p>
        </div>
      </div></div>
      <div class="grid-stack-item" gs-id="diffs" gs-x="6" gs-y="6" gs-w="6" gs-h="5"><div class="grid-stack-item-content widget col col-diffs" data-widget-id="diffs">
        <div class="widget-header">
          <h3>file diffs <span class="col-sub" id="diffs-sub"></span></h3>
          <span class="diffs-controls">
            <input type="text" id="diffs-search" placeholder="filter paths…" class="diffs-search" />
            <label title="group adjacent edits to the same file"><input type="checkbox" id="diffs-merge" checked /> merge</label>
          </span>
          <span class="widget-help" title="Per-file +added / -removed line counts for the selection, grouped by repo, biggest churn first. Click a row to expand old/new snippets (where captured). Merge checkbox collapses repeated edits to the same path. Filter box narrows by substring. Scope follows the selection bus: fleet picker, cell click, or timeline lasso all retarget the list.">?</span>
          <button class="widget-expand" title="expand (fullscreen) / restore">⛶</button><button class="widget-close" data-widget-close="diffs" title="hide">×</button>
        </div>
        <div class="col-body" id="diffs-body"><p class="hint">loading file diffs…</p></div>
      </div></div>
      <div class="grid-stack-item" gs-id="comms" gs-x="0" gs-y="6" gs-w="6" gs-h="5"><div class="grid-stack-item-content widget col col-comms" data-widget-id="comms">
        <div class="widget-header">
          <h3>A2A comms <span class="col-sub" id="comms-sub"></span></h3>
          <span class="comms-controls">
            <label>min msgs <input type="range" id="comms-min" min="1" max="80" value="1" /> <span id="comms-min-val">1</span></label>
          </span>
          <span class="widget-help" title="Agent-to-agent chord/graph of cct send traffic in the selection: who messaged whom, how often. Edge thickness = message count. Click a node to narrow the selection to that agent (publishes on selection bus so timeline + diffs + artifacts retarget). Min msgs slider hides thin edges.">?</span>
          <button class="widget-expand" title="expand (fullscreen) / restore">⛶</button><button class="widget-close" data-widget-close="comms" title="hide">×</button>
        </div>
        <div class="col-body" id="comms-body">
          <p class="hint">loading a2a traffic graph…</p>
        </div>
      </div></div>
      <div class="grid-stack-item" gs-id="tree" gs-x="0" gs-y="11" gs-w="12" gs-h="8"><div class="grid-stack-item-content widget col col-tree" data-widget-id="tree">
        <div class="widget-header">
          <h3>file tree <span class="col-sub" id="tree-sub"></span></h3>
          <span class="comms-controls">
            <label>min events <input type="range" id="tree-min" min="0" max="20" value="0" /> <span id="tree-min-val">0</span></label>
          </span>
          <span class="widget-help" title="Treemap of files touched in the selection, sized by activity (edits + ghost mentions). Ghost files (prose-mentioned but absent from disk) attach to a module by first path segment. Hover a tile for path and event count. Click publishes a title scope so other widgets narrow to that file's touchers. Min events slider culls tiny tiles.">?</span>
          <button class="widget-expand" title="expand (fullscreen) / restore">⛶</button><button class="widget-close" data-widget-close="tree" title="hide">×</button>
        </div>
        <div class="col-body tree-body" id="tree-body"><p class="hint">loading repo tree…</p></div>
      </div></div>
      <div class="grid-stack-item" gs-id="spawn-tree" gs-x="0" gs-y="19" gs-w="6" gs-h="6"><div class="grid-stack-item-content widget col" data-widget-id="spawn-tree">
        <div class="widget-header">
          <h3>spawn tree <span class="col-sub" id="st-sub" aria-live="polite"></span></h3>
          <button class="widget-expand" title="expand (fullscreen) / restore" aria-label="Expand spawn tree">⛶</button>
          <button class="widget-close" data-widget-close="spawn-tree" title="hide" aria-label="Hide spawn tree">×</button>
        </div>
        <div id="st-body" class="col-body widget-body" tabindex="0" aria-label="Spawn tree diagram"><p class="hint">loading spawn tree…</p></div>
      </div></div>
    </section>

    <div id="widget-scrollbar" class="widget-scrollbar" title="scroll widgets" hidden><div></div></div>
    <div class="tl-vert-splitter" id="tl-vert-splitter" title="drag to resize the chart (Chart ▾ fit rows shows every agent)"></div>
    <section class="tl-chart-wrap">
      <div id="tl-chart"></div>
    </section>
  </main>

  <script is:inline src="/timeline-hierarchy.js"></script>
  <script is:inline src="/spawn-tree.js"></script>
  <script define:vars={{ hierarchyConfig }}>
    // v15-J: Lazy-fetch BOTH timeline.json and artifacts.json instead of
    // inlining them via Astro's `define:vars`. The old path serialized a 53MB
    // timeline.json into inline script payload which V8 blew up on during parse
    // (Chrome SIGILL on gamejam+all+hourly). Lazy fetch:
    //   - cuts initial HTML from ~130MB to ~50KB
    //   - trades for a ~200ms blink where widgets briefly show empty state
    //     before data populates - acceptable to not crash the tab
    window.__hierarchyConfig = hierarchyConfig;
    // Shared promise. The main module script awaits this. Was previously an
    // event dispatch — raced when fetch finished BEFORE the main script got
    // a chance to attach its listener, hanging the page forever.
    window.__timelineDataPromise = (async () => {
      const qs = new URLSearchParams(location.search);
      const scopeParams = new URLSearchParams();
      // Pass BOTH fleet + org when present (API intersects them). Lets URLs
      // with mixed scope selectors return the AND set instead of 'no agents'.
      if (qs.get("fleet")) scopeParams.set("fleet", qs.get("fleet"));
      if (qs.get("org")) scopeParams.set("org", qs.get("org"));
      if (qs.get("range")) scopeParams.set("range", qs.get("range"));
      const timelineUrl = scopeParams.toString()
        ? ("/api/timeline?" + scopeParams.toString())
        : "/data/timeline.json";
      const artifactsUrl = scopeParams.toString()
        ? ("/api/artifacts?" + scopeParams.toString())
        : "/data/artifacts.json";
      // cache: 'no-store' so the browser never serves a stale old-full-size
      // response that was cached before the API shards existed.
      const noStore = { cache: "no-store" };
      const [data, artifacts] = await Promise.all([
        fetch(timelineUrl, noStore).then(r => r.ok ? r.json() : { agents:[], aggregate:{}, time_range:{} }).catch(() => ({ agents:[], aggregate:{}, time_range:{} })),
        fetch(artifactsUrl, noStore).then(r => r.ok ? r.json() : {}).catch(() => ({})),
      ]);
      const payload = { data, artifacts, hierarchyConfig };
      window.timelinePageData = payload;
      // Keep the event too for any backward-compat listeners
      window.dispatchEvent(new Event("timelinedataready"));
      return payload;
    })();
  </script>
  <script>
    import { marked } from "marked";
    import { renderV02Summary, disposeV02Summary } from "../lib/v02-summary";
    import { renderV01BSummary } from "../lib/v01b-merge.mjs";
    import { reclassifyTranscript, classifyUserRow, isHumanFacing, busSenderFor, UNKNOWN_SENDER } from "../lib/transcript-roles.mjs";
    import DOMPurify from "dompurify";
    import hljs from "highlight.js/lib/common";
    import "highlight.js/styles/github-dark.css";
    // Wait for the lazy data fetch kicked off in the define:vars script above.
    // Use the shared Promise (not an event) to avoid a listener-race where the
    // fetch resolves BEFORE this script attaches, causing an eternal hang.
    if (!window.timelinePageData && window.__timelineDataPromise) {
      await window.__timelineDataPromise;
    }
    const { data, artifacts, hierarchyConfig } = window.timelinePageData || { data: {agents:[], aggregate:{}, time_range:{}}, artifacts: {}, hierarchyConfig: {} };
    const hierarchy = window.TimelineHierarchy;
    let incomingScope = null;
    window._artifacts = artifacts;
    // Upgrade native title tooltips on widget help markers to instant CSS tooltips
    // (native title has ~0.75s delay and vanishes if the cursor moves 1px).
    document.querySelectorAll(".widget-help[title]").forEach((el) => {
      const t = el.getAttribute("title");
      if (t) { el.setAttribute("data-help", t); el.removeAttribute("title"); }
    });
    window._transcript = null;
    window._bucketSummaries = null; // keyed by `${sid}|${bucket_start}`
    // Lazy fetch bus index for retro-detecting agent-dispatched human-looking
    // msgs. Keyed by receiver → sorted list of {ts, from, hash, status, provenance}.
    (async () => {
      try {
        const r = await fetch("/data/bus_index.json", { cache: "no-store" });
        if (!r.ok) return;
        const bix = await r.json();
        window._busIndex = bix.data || {};
        window._busWindowSec = bix.window_sec || 120;
        window.dispatchEvent(new Event("busindexready"));
      } catch (_) { /* non-critical */ }
    })();

    // Shared body-hash helper so the client can match a transcript body to a
    // bus row the same way the python builder hashed it (sha256 first 16
    // chars of prefix-stripped first-400-chars). Uses SubtleCrypto if available.
    window._busBodyHash = async function(text) {
      const stripped = (text || "").replace(/^\s*\[from\s+[^\]]+\]\s*/i, "").slice(0, 400);
      if (!crypto?.subtle) return null;
      const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(stripped));
      return [...new Uint8Array(buf)].slice(0, 8).map(b => b.toString(16).padStart(2, "0")).join("");
    };

    // Agent-written "user" rows (spawn briefs, [sender] messages, harness events) are not CKL.
    // A spawner is trusted only if it was active before the child, since spawn_tree has bad edges.
    window._reclassifyTranscriptRoles = function () {
      const tx = window._transcript, parents = window._spawnParents;
      if (!tx) return;
      const byId = new Map((data.agents || []).map(a => [a.id, a]));
      const firstTs = new Map();
      for (const a of data.agents || []) {
        const t0 = Math.min(...(a.segments || []).map(s => s.start_ts));
        if (Number.isFinite(t0) && !(firstTs.get(a.title) <= t0)) firstTs.set(a.title, t0);
      }
      const bus = window._busIndex || {}, busWin = window._busWindowSec || 120;
      const changed = reclassifyTranscript(tx, (sid) => {
        const child = byId.get(sid)?.title, parent = child && parents && parents[child];
        return parent && parent !== child && firstTs.get(parent) < firstTs.get(child) ? parent : null;
      }, {
        humanFacing: (sid) => isHumanFacing(byId.get(sid)?.title),
        busSender: (sid, row) => busSenderFor(bus[byId.get(sid)?.title], row.t || 0, row.x, busWin),
      });
      if (changed) window.dispatchEvent(new Event("rolesupdated"));
    };
