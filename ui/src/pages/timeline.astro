    }).catch(() => {});
    document.getElementById("range-select")?.addEventListener("change", refresh);
    document.getElementById("agent-filter")?.addEventListener("input", refresh);
    // Model/judge dropdown: fetch /data/timeline.<model>.json, mutate `data` in place, refresh.
    document.getElementById("model-select")?.addEventListener("change", async (ev) => {
      const model = ev.target.value;
      const url = model === "qwen3-30b-a3b" ? "/data/timeline.json" : `/data/timeline.${model}.json`;
      try {
        const r = await fetch(url);
        if (!r.ok) { alert(`timeline.${model}.json missing (${r.status}). Build it with: python3 scripts/make_timeline.py data/classified data/prose data/timeline.${model}.json ${model}`); return; }
        const next = await r.json();
        for (const k of Object.keys(data)) delete data[k];
        Object.assign(data, next);
        refresh();
      } catch (e) {
        alert(`failed to switch judge: ${e.message}`);
      }
    });
    window.addEventListener("fleetchange", refresh);
    // Org filter: load hierarchy on first org event then refresh/publish like fleet.
    window.addEventListener("orgchange", async () => { await loadOrgHierarchy(); refresh(); });
    window.addEventListener("orgchange", async (ev) => {
      await loadOrgHierarchy();
      const org = (ev && ev.detail && ev.detail.org) || "";
      if (!org) {
        window._selectionBus.publish({ agentIds: null, titles: null, timeRange: null, source: "org-filter", stickyElementKey: null });
        return;
      }
      const filtered = filterOrg(data.agents, org);
      const titles = new Set(filtered.map((a) => a.title || a.id));
      window._selectionBus.publish({ agentIds: null, titles, timeRange: null, source: "org-filter", stickyElementKey: `org:${org}` });
    });
    // Preload hierarchy so initial refresh after DOMContentLoaded's orgchange works.
    loadOrgHierarchy();
    // v15-E: fleet dropdown publishes to the selection bus so every viz (treemap, comms, …)
    // sees a scope narrowed to the fleet's agents. Empty fleet = clear scope.
    window.addEventListener("fleetchange", (ev) => {
      const fleet = (ev && ev.detail && ev.detail.fleet) || "";
      if (!fleet) {
        window._selectionBus.publish({ agentIds: null, titles: null, timeRange: null, source: "fleet-filter", stickyElementKey: null });
        return;
      }
      const filtered = filterFleet(data.agents, fleet);
      const fleetTitles = new Set(filtered.map((a) => a.title || a.id));
      window._selectionBus.publish({ agentIds: null, titles: fleetTitles, timeRange: null, source: "fleet-filter", stickyElementKey: fleet });
    });
    window.addEventListener("sortchange", refresh);
    // v14-HH: re-fetch data snapshots when daemon publishes a new sentinel
    window.addEventListener("liverefresh", async () => {
      try {
        const [tl, art, tx, bs] = await Promise.all([
          fetch("/data/timeline.json?cb=" + Date.now()).then(r => r.ok ? r.json() : null),
          fetch("/data/artifacts.json?cb=" + Date.now()).then(r => r.ok ? r.json() : null).catch(() => null),
          fetch("/data/transcript.json?cb=" + Date.now()).then(r => r.ok ? r.json() : null).catch(() => null),
          fetch("/data/bucket_summaries.json?cb=" + Date.now()).then(r => r.ok ? r.json() : null).catch(() => null),
        ]);
        if (tl) {
          // data is a `const` from define:vars; mutate in place so references stay live
          for (const k of Object.keys(data)) delete data[k];
          Object.assign(data, tl);
        }
        if (art) window._artifacts = art;
        if (tx) { window._transcript = tx; window._reclassifyTranscriptRoles(); }
        if (bs) window._bucketSummaries = bs;
        // Preserve current selection + zoom + scroll
        const wrap = document.querySelector(".tl-chart-wrap");
        const scrollLeft = wrap?.scrollLeft || 0;
        const scrollTop = wrap?.scrollTop || 0;
        refresh();
        if (wrap) { wrap.scrollLeft = scrollLeft; wrap.scrollTop = scrollTop; }
      } catch (e) { console.warn("liverefresh fetch failed", e); }
    });
    document.querySelectorAll("[data-bucket]").forEach((b) => {
      b.addEventListener("click", () => {
        document.querySelectorAll("[data-bucket]").forEach((o) => o.classList.remove("active"));
        b.classList.add("active");
        currentBucket = b.getAttribute("data-bucket");
        refresh();
      });
    });

    // === v14-FF: continuous time-axis zoom (Premiere-style) ===
    window._zoomMult = window._zoomMult || 1;
    const GRAIN_SEC = { "raw": 1, "300": 300, "900": 900, "3600": 3600, "14400": 14400, "86400": 86400 };
    const GRAIN_UPGRADE = { "86400": "14400", "14400": "3600", "3600": "900", "900": "300", "300": "raw" };
    const GRAIN_DOWNGRADE = { "raw": "300", "300": "900", "900": "3600", "3600": "14400", "14400": "86400" };
    const MIN_PX_PER_CELL = 2;
    const MAX_PX_PER_CELL = 60;

    function autoAdjustGrain() {
      const g = renderTimeline.lastGeometry;
      if (!g || !g.bucketSec || !g.span) return false;
      const bucketCount = g.span / g.bucketSec;
      const pxPerCell = g.chartWidth / Math.max(bucketCount, 1);
      let newBucket = null;
      if (pxPerCell > MAX_PX_PER_CELL && GRAIN_UPGRADE[currentBucket]) newBucket = GRAIN_UPGRADE[currentBucket];
      else if (pxPerCell < MIN_PX_PER_CELL && GRAIN_DOWNGRADE[currentBucket]) newBucket = GRAIN_DOWNGRADE[currentBucket];
      if (newBucket && newBucket !== currentBucket) {
        currentBucket = newBucket;
        document.querySelectorAll("[data-bucket]").forEach((o) => {
          o.classList.toggle("active", o.getAttribute("data-bucket") === currentBucket);
        });
        return true;
      }
      return false;
    }

    function applyZoom(newMult, cursorClientX) {
      const wrap = document.querySelector(".tl-chart-wrap");
      if (!wrap) return;
      const g = renderTimeline.lastGeometry;
      if (!g) return;
      // Compute cursor's time position BEFORE re-render
      const wrapBox = wrap.getBoundingClientRect();
      const cursorXInContent = (cursorClientX || wrapBox.left + wrapBox.width/2) - wrapBox.left + wrap.scrollLeft;
      let anchorTime = null;
      if (cursorXInContent > g.labelWidth) {
        anchorTime = ((cursorXInContent - g.labelWidth) / g.chartWidth) * g.span + g.minTs;
      }
      // Clamp (wider range now that grain doesn't auto-switch — user wants pure pixel stretch)
      window._zoomMult = Math.max(1, Math.min(200, newMult));
      // Fast path: skip filter/sort/pickHighlight — just redraw with cached agents.
      // Grain stays whatever user picked; zoom is Photoshop-style cell stretch only.
      renderTimeline(currentAgents, currentBucket);
      // Re-anchor scroll so anchorTime is under the cursor again
      if (anchorTime !== null) {
        const g2 = renderTimeline.lastGeometry;
        if (g2) {
          const newCursorXInContent = g2.labelWidth + ((anchorTime - g2.minTs) / g2.span) * g2.chartWidth;
          const cursorScreenOffset = (cursorClientX || wrapBox.left + wrapBox.width/2) - wrapBox.left;
          wrap.scrollLeft = Math.max(0, newCursorXInContent - cursorScreenOffset);
        }
      }
    }

    (function installZoomWheel() {
      const wrap = document.querySelector(".tl-chart-wrap");
      if (!wrap) return;
      // rAF-coalesced zoom: accumulate deltaY across all wheel events in a frame,
      // then apply ONE applyZoom() per frame. Prevents re-render thrash.
      let pendingDelta = 0;
      let pendingCursorX = null;
      let rafScheduled = false;
      function flushZoom() {
        rafScheduled = false;
        if (!pendingDelta) return;
        // Single zoom speed. k=0.004 → ~1.49x per mouse notch, ~1.02x per trackpad tick.
        const factor = Math.exp(-pendingDelta * 0.004);
        pendingDelta = 0;
        applyZoom((window._zoomMult || 1) * factor, pendingCursorX);
      }
      wrap.addEventListener("wheel", (ev) => {
        if (!ev.deltaY) return;
        // Only Ctrl+wheel zooms. Plain wheel = native scroll. Shift+wheel = horizontal (browser default).
        if (!ev.ctrlKey) return;
        ev.preventDefault();
        pendingDelta += ev.deltaY;
        pendingCursorX = ev.clientX;
        if (!rafScheduled) {
          rafScheduled = true;
          requestAnimationFrame(flushZoom);
        }
      }, { passive: false });
    })();

    // === v14-II: hand-tool pan (Photoshop-style) ===
    // Triggers:
    //   - Middle-click drag (always)
    //   - Space-held + left drag (always)
    //   - Left drag on an idle cell or non-cell gutter area (default)
    // Non-idle agent cells still marquee-select as before.
    (function installPanDrag() {
      const wrap = document.querySelector(".tl-chart-wrap");
      if (!wrap) return;
      let panState = null; // { startX, startY, startScrollLeft, startScrollTop, pointerId }

      function shouldPan(ev) {
        if (ev.button === 1) return true;                       // middle = pan
        if (ev.button !== 0) return false;
        if (ev.shiftKey) return false;                          // Shift = marquee select
        if (ev.target.closest(".tl-hint") || ev.target.closest(".selection-chip")) return false;
        return true;                                            // default: left-drag pans everywhere
      }

      // Mousedown on wrap decides whether to arm pan. Move/up on WINDOW so events
      // keep firing even when the cursor leaves wrap mid-drag.
      wrap.addEventListener("mousedown", (ev) => {
        if (!shouldPan(ev)) return;
        panState = {
          startX: ev.clientX,
          startY: ev.clientY,
          startScrollLeft: wrap.scrollLeft,
          startScrollTop: wrap.scrollTop,
          engaged: false,
        };
      });

      window.addEventListener("mousemove", (ev) => {
        if (!panState) return;
        const dx = ev.clientX - panState.startX;
        const dy = ev.clientY - panState.startY;
        if (!panState.engaged) {
          if (Math.abs(dx) + Math.abs(dy) <= 3) return;
          panState.engaged = true;
          wrap.classList.add("panning");
        }
        ev.preventDefault();
        wrap.scrollLeft = panState.startScrollLeft - dx;
        wrap.scrollTop = panState.startScrollTop - dy;
      });

      window.addEventListener("mouseup", () => {
        if (!panState) return;
        const engaged = panState.engaged;
        panState = null;
        wrap.classList.remove("panning");
        if (engaged) {
          const swallow = (e) => { e.stopPropagation(); e.preventDefault(); window.removeEventListener("click", swallow, true); };
          window.addEventListener("click", swallow, true);
          setTimeout(() => window.removeEventListener("click", swallow, true), 50);
        }
      });
      wrap.addEventListener("auxclick", (ev) => { if (ev.button === 1) ev.preventDefault(); });

      // Shift = marquee cue
      document.addEventListener("keydown", (ev) => {
        if (ev.key === "Shift") wrap.classList.add("shift-held");
      });
      document.addEventListener("keyup", (ev) => {
        if (ev.key === "Shift") wrap.classList.remove("shift-held");
      });
      window.addEventListener("blur", () => wrap.classList.remove("shift-held"));
    })();
    // === /v14-II ===

    document.addEventListener("keydown", (ev) => {
      const t = ev.target;
      if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
      if (ev.key === "+" || (ev.key === "=" && !ev.shiftKey)) {
        ev.preventDefault();
        applyZoom((window._zoomMult || 1) * 1.25);
      } else if (ev.key === "-") {
        ev.preventDefault();
        applyZoom((window._zoomMult || 1) / 1.25);
      } else if (ev.key === "0") {
        ev.preventDefault();
        window._zoomMult = 1;
        refresh();
      }
    });
    // === /v14-FF ===

    // === v15-A: sticky chart sidebar + vertical splitter (persisted) ===
    (function installLayoutBundle() {
      const wrap = document.querySelector(".tl-chart-wrap");
      const sp = document.getElementById("tl-vert-splitter");
      if (!wrap) return;
      window._syncSticky = function () {
        const g = document.getElementById("tl-sticky");
        if (!g) return;
        const x = wrap.scrollLeft;
        g.setAttribute("transform", `translate(${x},0)`);
        const sh = document.getElementById("tl-sticky-shadow");
        if (sh) sh.setAttribute("opacity", x > 0 ? "1" : "0");
        const y = wrap.scrollTop;
        document.getElementById("tl-axis")?.setAttribute("transform", `translate(0,${y})`);
        document.getElementById("tl-corner")?.setAttribute("transform", `translate(${x},${y})`);
        document.getElementById("tl-pin-row")?.setAttribute("transform", `translate(0,${y})`);
        document.getElementById("tl-pin-label")?.setAttribute("transform", `translate(${x},${y})`);
      };
