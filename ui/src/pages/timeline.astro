          } else {
            parts.push(`<figure class="diary-card"><img loading="lazy" src="${url}" alt="${escapeHtml(titleText)}"/><h4>${escapeHtml(titleText)} <small>${mtime}${size ? " · " + size : ""}</small></h4>${captionShort && m.diary_title ? '<p class="diary-caption">' + escapeHtml(captionShort) + '</p>' : ''}</figure>`);
