        return;
      }
      renderAggregatePanels.lastSelection = null;
      renderPanels.lastSelection = { a: agent, s: seg };
      const isIdle = seg.state === "idle" && (seg.turn_count || 0) === 0;
      document.getElementById("summary-sub").textContent = "";
      document.getElementById("art-sub").textContent = ` · ${seg.errors_count || 0} errors · ${seg.file_edits_count || 0} edits (prose flags)`;

      if (isIdle) {
        document.getElementById("s-cost").textContent = "no activity in bucket";
        document.getElementById("art-body").innerHTML = `<p class="hint">no activity in bucket · agent was idle for this ${seg._bucket || "window"}</p>`;
        writeLabels(`<p class="hint">no labels in bucket</p>`, `<p class="hint">no labels in bucket</p>`);
        renderTranscriptSingle(agent, seg);
        renderBucketSummarySingle(agent, seg);
        return;
      }
      renderArtifactsOnly(agent, seg);
      renderTranscriptSingle(agent, seg);
      renderBucketSummarySingle(agent, seg);

      // v13-CC: FINISHED / STARTED / BLOCKED classifier counts moved to the
      // LABELS/RUBRICS panel below — summary panel now owns COST + PROSE SUMMARY + TRANSCRIPT.
      // v13-BB: duration_sec is only set on raw segments; buckets carry start_ts/end_ts
      // instead, so fall back to end-start when duration_sec is missing/NaN.
      let latency = Number(seg.duration_sec);
      if (!Number.isFinite(latency) || latency < 0) {
        const span = Number(seg.end_ts) - Number(seg.start_ts);
        latency = Number.isFinite(span) && span >= 0 ? span : null;
      }
      const durStr = latency === null
        ? "—"
        : latency < 1
          ? "<1s"
          : latency < 60
            ? latency.toFixed(0) + "s"
            : latency < 3600
              ? (latency / 60).toFixed(1) + "min"
              : (latency / 3600).toFixed(1) + "h";
      document.getElementById("s-cost").innerHTML = costLine(seg.cost_usd, seg.tokens_in, seg.tokens_out, seg.turn_count, durStr);

      // (old prose-based artifacts rendering removed; now using renderArtifactsOnly with real tool_use data)

      // Labels — classifier count breakdown, inlined into summary panel (v16)
      const makeGroup = (title, items) => {
        if (!items.length) return "";
        return `<div class="lab-group"><div class="lab-title">${title}</div><div class="lab-chips">${items.map(([k, n]) => `<span class="chip">${k} <span class="n">×${n}</span></span>`).join(" ")}</div></div>`;
      };
      const intents = Object.entries(seg.intents || {}).sort((a,b)=>b[1]-a[1]);
      const roles = Object.entries(seg.roles || {}).sort((a,b)=>b[1]-a[1]);
      const blockers = Object.entries(seg.blockers || {}).sort((a,b)=>b[1]-a[1]);
      const urgencies = Object.entries(seg.urgencies || {}).sort((a,b)=>b[1]-a[1]);
      const userIntents = Object.entries(seg.user_intents || {}).sort((a,b)=>b[1]-a[1]);
      writeLabels(
        makeGroup("user intents", userIntents),
        makeGroup("intents", intents) + makeGroup("roles", roles) + makeGroup("blockers", blockers) + makeGroup("urgencies", urgencies));
    }

    // Pre-select best segment for first impression:
    //   priority: gamejam-master hour-bucket with most media → other-project (meta) → first blocked anywhere
    function pickHighlightSegment(agents) {
      // 1. gamejam-master with heaviest media hour (ribbon demo moment)
      const gjm = agents.find((a) => a.title === "gamejam-master");
      if (gjm) {
        const media = window._mediaBySession[gjm.id] || [];
        if (media.length) {
          // Find segment near the hour-of-day with most media density
          const hourCounts = new Map();
          for (const m of media) {
            const hourStart = Math.floor(m.ts / 3600) * 3600;
            hourCounts.set(hourStart, (hourCounts.get(hourStart) || 0) + 1);
          }
          let bestHour = null, bestN = 0;
          for (const [h, n] of hourCounts) {
            if (n > bestN) { bestN = n; bestHour = h; }
          }
          if (bestHour !== null) {
            // Find any segment inside [bestHour, bestHour+3600)
            const seg = gjm.segments.find((s) => s.start_ts >= bestHour && s.start_ts < bestHour + 3600)
                     || gjm.segments.find((s) => s.start_ts >= bestHour);
            if (seg) return { agent: gjm, seg, agentIdx: agents.indexOf(gjm), segIdx: gjm.segments.indexOf(seg) };
          }
        }
      }
      // 2. meta-recursive
      const planner = agents.find((a) => a.project === "other-project");
      if (planner) {
        const seg = planner.segments.find((s) => s.state === "context_exhausted")
          || planner.segments.find((s) => s.state === "blocked")
          || planner.segments[planner.segments.length - 1];
        if (seg) return { agent: planner, seg, agentIdx: agents.indexOf(planner), segIdx: planner.segments.indexOf(seg) };
      }
      // 3. first blocked anywhere
      for (let i = 0; i < agents.length; i++) {
        const seg = agents[i].segments.find((s) => s.state === "blocked" || s.state === "context_exhausted");
        if (seg) return { agent: agents[i], seg, agentIdx: i, segIdx: agents[i].segments.indexOf(seg) };
      }
      return null;
    }

    // Wiring
    let currentAgents = data.agents;
    let currentBucket = "86400"; // default day — hour on all fleets is laggy
    {
      // URL sync may click the bucket button before its handler exists; read ?bucket= directly.
      const want = new URL(location.href).searchParams.get("bucket");
      const btn = want && document.querySelector(`[data-bucket="${CSS.escape(want)}"]`);
      if (btn) {
        currentBucket = want;
        document.querySelectorAll("[data-bucket]").forEach((o) => o.classList.toggle("active", o === btn));
      }
    }

    function refresh() {
      updateSpawnTree();
      const range = (document.getElementById("range-select") || {}).value || "7d";
      const q = (document.getElementById("agent-filter") || {}).value || "";
      const sel = document.getElementById("fleet-select");
      const fleet = sel?.value || "";
      const classified = sel?.selectedOptions[0]?.getAttribute("data-classified") === "1";
      const privacy = sel?.selectedOptions[0]?.getAttribute("data-privacy") === "1";
      const orgSel = document.getElementById("org-select");
      const org = orgSel?.value || "";
      const level = document.getElementById("row-level").value;
      // cct-live placeholders have no transcript; their "working" bands are guessed from file mtimes.
      let filtered = filterRange(data.agents.filter(a => a.source !== "cct-live"), range, level !== "agent");
      filtered = filterText(filtered, q);
      filtered = filterOrg(filtered, org);
      filtered = filterFleet(filtered, fleet);
      const agentCount = filtered.length;
      filtered = hierarchy.buildRows(filtered, level, hierarchyConfig).filter(a => a.segments.length);
      filtered = sortAgents(filtered, window._agentSort || "activity");
      const unassigned = level === "org" ? filtered.find(row => row.id === "group:org:")?.members.length || 0 : 0;
      document.getElementById("hierarchy-status").textContent = `${filtered.length} ${level} rows · ${agentCount} agents${unassigned ? ` · ${unassigned} agents have no org assignment` : ""}${level !== "agent" && q ? " · members narrowed by text filter" : ""}`;
      if (level === "org") {
        const status = document.getElementById("hierarchy-status");
        const defaults = filtered.flatMap(row => row.members || []).filter(a => hierarchyConfig.agentSources?.[a.id]?.source === "default").length;
        const generated = hierarchyConfig.generatedAt;
        const stale = generated && Date.now() - Date.parse(generated) > 86400000;
        status.textContent += generated
          ? ` · CCT/orchestrator membership ${new Date(generated).toLocaleString()}${stale ? " (over 24h old)" : ""} · ${defaults} assigned by CCT default`
          : " · org source unavailable; showing explicit assignments or Unassigned";
        status.title = hierarchyConfig.source || "Build local org membership from CCT/orchestrator to populate org rows.";
      }
      selectionSet.clear(); currentCell = null; hideSelectionChip();
      currentAgents = filtered;
      const sub = document.querySelector(".tl-title .sub");
      if (sub) {
        const base = `${filtered.length} agents · ${data.aggregate.segment_count?.toLocaleString()} segments · ${(data.time_range.span_sec/3600).toFixed(0)}h observed · $${data.aggregate.total_cost_usd?.toFixed(4)} classifier cost`;
        sub.textContent = fleet ? `${base} · fleet: ${fleet}` : base;
      }
      // Honest empty-state banner when an unclassified / privacy-locked fleet is picked
      document.querySelectorAll(".fleet-empty-banner").forEach((n) => n.remove());
      if (fleet && filtered.length === 0) {
        const banner = document.createElement("div");
        banner.className = "fleet-empty-banner";
        if (privacy) {
          banner.innerHTML = `🔒 <strong>${fleet}</strong> is <strong>privacy-locked</strong> — local-only, never classified, never sent to any API. Pick a different fleet above or clear the filter.`;
        } else if (!classified) {
          banner.innerHTML = `∅ <strong>${fleet}</strong> has not been classified yet. The bundle index tracks it but the classifier has never been run on it (budget decision — classifying 32K msgs = ~$1.43 Nebius). <button class="btn-reqclass" data-fleet="${fleet}">request classification</button>`;
        } else {
          const inAllRange = filterFleet(filterText(data.agents, q), fleet).length;
          if (inAllRange > 0 && range !== "all") {
            banner.innerHTML = `<strong>${fleet}</strong> has ${inAllRange} agent${inAllRange===1?"":"s"} but none in the last ${range}. <button class="btn-widen" data-range="all">switch to all time</button>`;
          } else {
            banner.innerHTML = `No agents in this view for <strong>${fleet}</strong>. Widen the range (right side of toolbar) or clear the filter.`;
          }
        }
        const topSection = document.querySelector(".tl-top");
        topSection?.parentNode?.insertBefore(banner, topSection);
        banner.querySelector(".btn-reqclass")?.addEventListener("click", () => {
          alert(`request logged for '${fleet}'. (dashboard records interest; actual classify is a manual budget decision.)`);
        });
        banner.querySelector(".btn-widen")?.addEventListener("click", (e) => {
          const r = document.getElementById("range-select");
          if (r) { r.value = e.target.getAttribute("data-range") || "all"; r.dispatchEvent(new Event("change", {bubbles:true})); }
        });
      }
      renderTimeline(filtered, currentBucket);
      // Auto-select only in raw mode; bucket modes default to the first column (selectFirstColumnOnLoad).
      const pick = currentBucket === "raw" ? pickHighlightSegment(filtered) : null;
      if (pick) {
        const el = document.getElementById("tl-chart");
        // Find bucket containing pick.seg.start_ts in visibleAgents
        const vState = renderTimeline.lastState || { visibleAgents: [], cellStore: [] };
        const vIdx = vState.visibleAgents.indexOf(pick.agent);
        if (vIdx >= 0) {
          let cellIdx = -1;
          const cells = vState.cellStore[vIdx] || [];
          for (let k = 0; k < cells.length; k++) {
            const c = cells[k];
            if (c.start_ts <= pick.seg.start_ts && pick.seg.start_ts < (c.end_ts || c.start_ts + 1)) {
              cellIdx = k;
              break;
            }
          }
          if (cellIdx === -1 && cells.length) cellIdx = 0;
          if (cellIdx >= 0) {
            const cell = cells[cellIdx];
            // Auto-pick non-dev mode if this bucket has media (judges-first default)
            const hasMedia = countMediaInWindow(pick.agent.id, cell.start_ts, cell.end_ts) > 0;
            if (hasMedia) {
              devMode = "nondev";
              const nd = document.querySelector("input[name='dev-mode'][value='nondev']");
              if (nd) nd.checked = true;
            }
            renderPanels(pick.agent, cell);
            currentCell = { ai: vIdx, ci: cellIdx }; // v13-Z: arm keyboard nav from the auto-pick
            const target = el?.querySelector(`rect[data-agent-i="${vIdx}"][data-cell-i="${cellIdx}"]`);
            if (target) {
              target.setAttribute("stroke", "#a855f7");
              target.setAttribute("stroke-width", "2");
              target.setAttribute("opacity", "1");
              const chartWrap = document.querySelector(".tl-chart-wrap");
              if (chartWrap) {
                const bbox = target.getBoundingClientRect();
                const containerBox = chartWrap.getBoundingClientRect();
                if (bbox.left < containerBox.left || bbox.right > containerBox.right) {
                  chartWrap.scrollLeft = Math.max(0, parseFloat(target.getAttribute("x")) - 300);
                }
              }
            }
            // v16: hint banner removed per user — the selection chip + widget subtitles already say what's selected.
          }
        }
      }
      reapplyScope();
    }

    function reapplyScope() {
      const scope = window._selectionBus.lastScope;
      if (scope && (scope.agentIds || scope.titles || scope.timeRange)) {
        window._selectionBus.publish({ ...scope, source: "hierarchy-restore" });
      }
    }
    document.getElementById("row-level").addEventListener("change", refresh);
    function showHint(pick) {
      // Remove any previous hint
      document.querySelectorAll(".tl-hint").forEach((h) => h.remove());
      const hint = document.createElement("div");
