  .tl-selection-range { display: none; align-items: center; gap: 6px; padding: 2px 10px; font: 600 12px var(--mono); background: #12241f; color: #e8fff8; border: 1px solid var(--accent); border-radius: 12px; }
  .tl-selection-range.active { display: inline-flex; }
  .tl-selection-range .tl-sr-label { color: var(--muted); font-weight: 400; font-size: 10px; }
