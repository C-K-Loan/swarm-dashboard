  .comms-container.comms-split .xmsg-wrap pre { margin: 4px 0 2px; max-height: 300px; overflow: auto; }
  .comms-container.comms-split .xmsg-wrap-body { margin: 4px 0 2px; max-height: 400px; overflow: auto; padding-left: 8px; border-left: 1px dashed #1f2937; color: #c9d6ee; font-size: 10.5px; line-height: 1.45; white-space: pre-wrap; word-break: break-word; }
  .comms-container.comms-split .xmsg-wrap-body .xmsg-wrap { margin: 2px 0; padding: 1px 6px; font-size: 9.5px; }
  .comms-container.comms-split .xmsg-more { color: #4b5563; margin-left: 4px; font-size: 10px; }
  .comms-container.comms-split .xmsg-spawn-badge { display: inline-block; background: #4c1d95; color: #ddd6fe; padding: 1px 7px; margin-left: 8px; border-radius: 10px; font: 600 9px ui-sans-serif,system-ui; letter-spacing: 0.03em; text-transform: uppercase; }
  .comms-container.comms-split .xmsg-relay-badge { display: inline-block; background: #1e3a5f; color: #93c5fd; padding: 1px 7px; margin-left: 8px; border-radius: 10px; font: 600 9px ui-sans-serif,system-ui; letter-spacing: 0.03em; text-transform: uppercase; }
  .comms-container.comms-split .xmsg-relayed .xmsg-arrow strong:first-child { color: #93c5fd !important; }
