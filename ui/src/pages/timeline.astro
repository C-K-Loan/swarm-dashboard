  #row-level:focus-visible, .bs-more summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (pointer: coarse) { #row-level { min-height: 40px; } }

  /* v14-LL fixed-viewport layout: no outer page scroll.
   * body is a flex column (outer header + main + footer), so main occupies the
