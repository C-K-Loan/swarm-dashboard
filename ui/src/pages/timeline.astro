      const code = bucketArts.filter((x) => x.kind === "code");
      const other = bucketArts.filter((x) => x.kind === "other");

      // Prefer videos then pngs; dedupe by basename-without-ext so poster+video pair collapses.
      // Tie-breaker: a candidate WITH web_url beats one without at the same rank
      // (otherwise prose-only entries can mask the mirrored one and tiles render as "missing").
      const byStem = new Map();
      for (const m of media) {
        const stem = m.basename.replace(/\.(mp4|webm|mov|png|jpg|jpeg|gif|webp|svg)$/i, "");
        const ext = (m.basename.split(".").pop() || "").toLowerCase();
        const prev = byStem.get(stem);
        const rank = { mp4: 3, webm: 3, mov: 3, png: 2, jpg: 2, jpeg: 2, webp: 2, gif: 1, svg: 1 }[ext] || 0;
        const prevReal = prev && prev.web_url ? 1 : 0;
        const curReal  = m && m.web_url ? 1 : 0;
        if (!prev
            || rank > prev._rank
            || (rank === prev._rank && curReal > prevReal)) {
          byStem.set(stem, { ...m, _rank: rank, _stem: stem });
          // Attach poster if preferring video
          if (rank === 3) {
            const poster = media.find((x) => x.basename === stem + ".png" && x.web_url);
            if (poster) byStem.get(stem)._poster = poster.web_url;
