            return `<div class="xmsg${spawnCls}${relayCls}" style="background:${spawnBg}; border-left:3px solid ${spawnBorder};">
              <div class="xmsg-head">
                <span class="xmsg-ts">${ts}Z</span>
                <span class="xmsg-arrow"><strong style="color:${fromColor}">${escTx(r.from)}</strong> <span style="color:#6b7280">→</span> <strong style="color:${toColor}">${escTx(r.to)}</strong></span>
                ${spawnBadge}${relayBadge}
              </div>
              <div class="xmsg-body xmsg-md">${bodyHtml}${truncHint}</div>
            </div>`;
          }).join("");
          const loadMore = () => {
            const next = Math.min(cursor + PAGE_SIZE, total);
            const chunk = PAGE_RENDER(cursor, next);
            sentinelEl.insertAdjacentHTML("beforebegin", chunk);
            cursor = next;
            if (cursor >= total) sentinelEl.remove();
            else loadBtn.textContent = `load ${Math.min(PAGE_SIZE, total - cursor)} more older · (${cursor}/${total})`;
          };
          loadBtn?.addEventListener("click", loadMore);
          // IntersectionObserver: auto-load when sentinel scrolls into view
          if (sentinelEl && window.IntersectionObserver) {
            const io = new IntersectionObserver((entries) => {
              for (const e of entries) if (e.isIntersecting && cursor < total) loadMore();
            }, { root: dest });
            io.observe(sentinelEl);
          }
          dest.querySelector(".xmsg-jump-latest")?.addEventListener("click", () => {
            // Render ALL rows (replace), scroll to bottom
            dest.innerHTML = `<div class="xmsg-page-bar"><span>showing all <strong>${total}</strong> (latest at bottom)</span></div>`
              + PAGE_RENDER(0, total);
            dest.scrollTop = dest.scrollHeight;
          });
        }
        // Task-notification toggle (always wired, independent of pagination)
        dest.querySelector(".xmsg-tn-cb")?.addEventListener("change", (e) => {
          try { localStorage.setItem("cct_tx_show_tasknotifs", e.target.checked ? "1" : "0"); } catch (_) {}
          window._lastCommsTxKey = null;
          window._lastCommsTxHtml = null;
          // Force re-populate — the ONLY call site is render(). Trigger it via
          // the installer's render ref (populator doesn't have one directly).
          const evt = new CustomEvent("tx-refresh"); window.dispatchEvent(evt);
        });
      }
      window.addEventListener("tx-refresh", () => { if (commsData) render(); });
      // Expose for render() epilogue
      window._populateCommsTranscript = populateCommsTranscript;

      // When the transcript lazy-fetch completes, invalidate the cache so the
      // next render actually populates (not just re-attaches an empty cache).
      // Also synthesize the "human" node + edges once — uses the SHARED
      // reclassifyUser classifier (defined at module scope ~line 1883) so a
      // bug fix in message classification propagates here automatically.
      let humanAugmented = false;
      function augmentHumanNode() {
        if (humanAugmented || !commsData || !window._transcript) return;
        // Re-runnable: start from comms.json as loaded, since roles change when spawn parents or the bus arrive.
        if (!commsData._orig) commsData._orig = { nodes: commsData.nodes.map(n => ({ ...n })), edges: commsData.edges.map(e => [...e]) };
        commsData.nodes = commsData._orig.nodes.map(n => ({ ...n }));
        commsData.edges = commsData._orig.edges.map(e => [...e]);
        const tx = window._transcript;
        const agents = window.timelinePageData?.data?.agents || [];
        const nameById = new Map(agents.map(a => [a.id, a.title]));
        // Build TWO maps:
        //   perRecv:  receiver -> {msgs, bytes}   for human→receiver edges
        //   byPair:   "from|to" -> {msgs, bytes} for a2a edges derived from
        //             reclassified bracket-prefix messages ([harness-architect], etc).
        //             These edges aren't in comms.json because the ingestion
        //             only scanned cct bus events, not role=u messages. Keeps
        //             the graph consistent with the transcript view.
        const perRecv = new Map();
        const byPair  = new Map();
        const classify = (typeof window.reclassifyUser === "function") ? window.reclassifyUser : null;
        for (const [sid, msgs] of Object.entries(tx)) {
          const receiver = nameById.get(sid);
          if (!receiver) continue;
          for (const m of msgs) {
            const kind = classify ? classify(m) : { role: m.r, a2a: m.a2a || null };
            const bytes = (m.x || "").length;
            if (kind.role === "u" && !kind.a2a) {
              // true human → receiver
              const prev = perRecv.get(receiver) || { msgs: 0, bytes: 0 };
              prev.msgs += 1; prev.bytes += bytes;
              perRecv.set(receiver, prev);
            } else if ((kind.role === "x" || kind.role === "spawn") && kind.a2a) {
              // reclassified a2a sender → receiver
              const sender = kind.a2a;
              if (sender === receiver) continue;  // self-ref noise
              const key = sender + "\0" + receiver;
              const prev = byPair.get(key) || { from: sender, to: receiver, msgs: 0, bytes: 0 };
              prev.msgs += 1; prev.bytes += bytes;
              byPair.set(key, prev);
            }
          }
        }
        // Push human node + edges
        if (perRecv.size) {
          const totalMsgs = [...perRecv.values()].reduce((s, x) => s + x.msgs, 0);
          if (!commsData.nodes.find(n => n.n === "human")) {
            commsData.nodes.push({ n: "human", vol: totalMsgs, role: "coordination" });
          }
          for (const [recv, stat] of perRecv) {
            const dupIdx = commsData.edges.findIndex(e => e[0] === "human" && e[1] === recv);
            if (dupIdx >= 0) commsData.edges[dupIdx] = ["human", recv, stat.msgs, stat.bytes];
            else commsData.edges.push(["human", recv, stat.msgs, stat.bytes]);
          }
        }
        // Push synthesized a2a edges + ensure sender nodes exist. Role defaults
        // to "dev" if we have no better guess; graph layout picks the color.
        const nodeByName = new Map(commsData.nodes.map(n => [n.n, n]));
        for (const stat of byPair.values()) {
          if (!nodeByName.has(stat.from)) {
            const n = { n: stat.from, vol: stat.msgs, role: "dev" };
            commsData.nodes.push(n); nodeByName.set(stat.from, n);
          } else {
            nodeByName.get(stat.from).vol = (nodeByName.get(stat.from).vol || 0) + stat.msgs;
          }
          // Only ADD an edge if comms.json didn't already have one for this pair
          // (comms.json edges are the authoritative wire-level record; our synth
          // is a FALLBACK for traffic the ingestion missed).
          const dupIdx = commsData.edges.findIndex(e => e[0] === stat.from && e[1] === stat.to);
          if (dupIdx < 0) commsData.edges.push([stat.from, stat.to, stat.msgs, stat.bytes]);
        }
        humanAugmented = true;
      }
      // expose reclassifyUser onto window so this closure can access the shared one
      if (typeof reclassifyUser === "function") window.reclassifyUser = reclassifyUser;

      window.addEventListener("transcriptready", () => {
        window._lastCommsTxKey = null;
        window._lastCommsTxHtml = null;
        window._commsTxIndex = null;  // force rebuild with bus data if it arrived
        augmentHumanNode();
        if (commsData) render();
      });
      // Spawn parents or the bus index changed some senders: rebuild graph + pane from the new roles.
      window.addEventListener("rolesupdated", () => {
        window._lastCommsTxKey = null;
        window._lastCommsTxHtml = null;
        window._commsTxIndex = null;
        humanAugmented = false;
        if (commsData && window._transcript) { augmentHumanNode(); render(); }
      });
      // Bus index arriving AFTER transcript: invalidate so re-classification picks it up
      window.addEventListener("busindexready", () => {
        window._lastCommsTxKey = null;
        window._lastCommsTxHtml = null;
        window._commsTxIndex = null;
        if (commsData && window._transcript) render();
      });

      // v14-LL universal viz bus: subscribe → re-render on any scope change.
      // Scopes from source==='comms' carry stickyElementKey so our own clicks preserve sticky visuals.
      window._selectionBus.subscribe((scope) => {
        if (!scope) return;
        membershipScope = scope;
        agentFilter = scope.agentIds
          ? new Set(data.agents.filter(a => scope.agentIds.has(a.id)).map(a => a.title))
          : (scope.titles && scope.titles.size > 0) ? scope.titles : null;
        selectionWindow = scope.timeRange || null;
        if (scope.source !== "comms") pairPinned = false;
        if (scope.source === "comms") {
          stickyNode = scope.stickyElementKey?.startsWith("pair:") ? null : scope.stickyElementKey || null;
        } else if (!scope.titles) {
          stickyNode = null;
        } else if (stickyNode && agentFilter && !agentFilter.has(stickyNode)) {
          stickyNode = null;
        }
        render();
      });

      async function loadData() {
        try {
          const r = await fetch("/data/comms.json?cb=" + Date.now());
          if (!r.ok) { body.innerHTML = `<p class="hint">comms.json not found — run scripts/build_comms_index.py</p>`; return; }
          commsData = await r.json();
          render();
        } catch (e) {
          body.innerHTML = `<p class="hint">comms data load failed: ${e.message}</p>`;
        }
      }

      function render() {
        if (!commsData) return;
        if (!humanAugmented && window._transcript) augmentHumanNode();
        let { nodes: allNodes, edges: allEdges } = commsData;
        const reconstructed = !!(selectionWindow || membershipScope?.agentIds || membershipScope?.titles);
        const roles = new Map(commsData.nodes.map(n => [n.n, n.role]));
        if (reconstructed) {
          if (!window._transcript) {
            body.innerHTML = `<p class="hint">Loading communication evidence for this interval…</p>`;
            return;
          }
          // KNOWN LIMITATION: the graph (nodes/edges) still uses the bounding
          // selectionWindow, not exact per-session windows; only the A2A
          // transcript pane is exact. Disjoint selections can draw gap traffic.
          const timed = hierarchy.commsInWindow(window._transcript, data.agents, selectionWindow || [-Infinity, Infinity], membershipScope);
          allEdges = timed.edges;
          allNodes = timed.nodes.map(n => ({ ...n, role: roles.get(n.n) || "dev" }));
          // Merge pre-computed synthetic edges + nodes for python-harness fleets
          // (sandbox-live-role sub-agents have no transcript entries so the
          // reconstruction above returns nothing for them). We derive the scope
          // from membershipScope directly (not allNodes, which may be empty).
          const scopeFleetSet = new Set(
            (data.agents || [])
              .filter(a => membershipScope?.agentIds?.has(a.id) || membershipScope?.titles?.has(a.title))
              .map(a => a.fleet)
              .filter(Boolean)
          );
          if (scopeFleetSet.size) {
            const syntheticAgents = (data.agents || []).filter(a =>
              a.source === "sandbox-live-role" && scopeFleetSet.has(a.fleet)
            );
            const syntheticTitles = new Set(syntheticAgents.map(a => a.title));
            const existingTitles = new Set(allNodes.map(n => n.n));
            for (const n of (commsData.nodes || [])) {
              if (syntheticTitles.has(n.n) && !existingTitles.has(n.n)) {
                allNodes.push(n);
                existingTitles.add(n.n);
              }
            }
            const extraEdges = (commsData.edges || []).filter(e =>
              (syntheticTitles.has(e[0]) || syntheticTitles.has(e[1])) &&
              existingTitles.has(e[0]) && existingTitles.has(e[1])
            );
            allEdges = allEdges.concat(extraEdges);
          }
        }
        // Always re-insert human node + its edges into allNodes/allEdges so it
        // appears in both default and reconstructed modes (reconstruction wiped them).
        const humanRows = (commsData.edges || []).filter(e => e[0] === "human");
        if (humanRows.length) {
          const scopedTitles = new Set(allNodes.map(n => n.n));
          const relevant = humanRows.filter(e => scopedTitles.has(e[1]));
          if (relevant.length) {
            if (!allNodes.find(n => n.n === "human")) {
              const humanNode = commsData.nodes.find(n => n.n === "human");
              if (humanNode) allNodes.push({ ...humanNode });
            }
            allEdges = allEdges.concat(relevant);
          }
        }
        // v14-LL: either filter to selected agents, else keep top-26 by volume
        // Canonical receiver IDs already constrain reconstructed evidence. Observed
        // sender names can differ from synthetic timeline titles and must remain peers.
        let baseNodes = reconstructed ? allNodes : agentFilter
          ? allNodes.filter((n) => agentFilter.has(n.n)) : allNodes.slice(0, 26);
        // Human node always wins the slice: pin it in if it has any edges to
        // the baseNodes we just picked.
        const humanN = allNodes.find(n => n.n === "human");
        if (humanN && !baseNodes.find(n => n.n === "human")) {
          const basePeers = new Set(baseNodes.map(n => n.n));
          const touchesBase = allEdges.some(e => e[0] === "human" && basePeers.has(e[1]));
          if (touchesBase) baseNodes = [...baseNodes, humanN];
        }
        // Degree-0 silent agents: only fill them in when the scope is TRULY
        // silent (no real a2a traffic). On a fleet like ghost with real traffic
        // from a few agents, adding every other silent scoped agent floods the
        // graph with noise. Rule: if baseNodes already has any real participant,
        // skip the silent fill.
        if (baseNodes.length === 0) {
          const seen = new Set();
          const scopedAgents = membershipScope?.agentIds
            ? data.agents.filter(a => membershipScope.agentIds.has(a.id))
            : agentFilter
            ? data.agents.filter(a => agentFilter.has(a.title))
            : [];
          for (const a of scopedAgents) {
            if (a.title && !seen.has(a.title)) {
              baseNodes.push({ n: a.title, vol: 0, role: roles.get(a.title) || "dev" });
              seen.add(a.title);
            }
          }
        }
        const keep = new Set(baseNodes.map((n) => n.n));
        const candidateEdges = allEdges.filter(e => keep.has(e[0]) && keep.has(e[1]));
        const edges = candidateEdges.filter(e => e[2] >= minE);
        const visibleMessages = edges.reduce((n, e) => n + e[2], 0);
        const candidateMessages = candidateEdges.reduce((n, e) => n + e[2], 0);
        const maxN = Math.max(1, ...edges.map((e) => e[2]));
        const roleOrder = ["coordination", "dev", "review", "release", "qa"];
        const ordered = [...baseNodes].sort((a, b) => roleOrder.indexOf(a.role) - roleOrder.indexOf(b.role) || b.vol - a.vol);
        // Dynamic viewBox: use the available WIDTH; HEIGHT is driven by the body's actual
        // panel height minus a reserved budget for legend + info + table, so the SVG
        // never pushes other sections off-screen. SVG renders at width:100%, height:auto.
        const bodyW = Math.max(260, Math.round(body?.clientWidth || 340));
        const bodyH = Math.max(200, Math.round(body?.clientHeight || 340));
        const existingWrap = body.querySelector(".comms-svg-wrap");
        const wrapW = Math.max(260, Math.round(existingWrap?.clientWidth || bodyW));
        // Reserve ~160px for legend(15)+info(23)+table-wrap(~100)+gaps(~22). Rest to SVG.
        const vbH = Math.max(140, Math.min(wrapW * 0.55, bodyH - 160));
        const wrapH = vbH;
        const FS = 10;                 // label font size in SVG units
        const CHAR_W = FS * 0.58;      // mono approx char width
        const MAX_NODE_R = 10;         // matches r = 3 + 7*sqrt(…) ceiling below
        const maxLabelLen = ordered.reduce((m, n) => Math.max(m, n.n.length), 0);
        // Reserve enough side gutter so the longest east/west label fits (node
        // radius + 6px gap + chars). Cap at 50% so Rx can't collapse on absurd
        // name lengths; names longer than ~32 chars we let overflow slightly
        // rather than squash the graph.
        // Tighter side-gutter (was 50% × up to 32 chars = big L/R whitespace).
        // Now cap at 30% of width and 18 chars; longer names overflow slightly.
        const labelPad = Math.min(wrapW * 0.3, Math.min(maxLabelLen, 18) * CHAR_W + MAX_NODE_R + 8);
        const VB_W = wrapW, VB_H = wrapH;
        const Cx = VB_W / 2, Cy = VB_H / 2;
        // Ellipse layout: use the full width horizontally, and whatever height remains
        // vertically. Nodes + their labels both land on the same ellipse angle so labels
        // sit radially outward from each node.
        const Rx = Math.max(80, Cx - labelPad);
        // Vertical reservation: node radius + 6px gap + full font-size (not just
        // half) so top/bottom labels don't clip the viewBox top/bottom edge.
        const Ry = Math.max(40, Cy - (MAX_NODE_R + 6 + FS + 4));
        const pos = {};
        ordered.forEach((n, i) => {
          const ang = (i / Math.max(1, ordered.length)) * Math.PI * 2 - Math.PI / 2;
          pos[n.n] = { ...n, x: Cx + Rx * Math.cos(ang), y: Cy + Ry * Math.sin(ang), ang };
        });
        const maxVol = Math.max(1, ...ordered.map((n) => n.vol));
        // v14-LL: neighbors of stickyNode in current (post-minE) edges
        const neighbors = new Set();
        if (stickyNode && keep.has(stickyNode)) {
          neighbors.add(stickyNode);
          edges.forEach(([f, t]) => {
            if (f === stickyNode) neighbors.add(t);
            else if (t === stickyNode) neighbors.add(f);
          });
        }
        const esc = (s) => String(s).replace(/[<>&"]/g, (c) => ({ "<":"&lt;",">":"&gt;","&":"&amp;","\"":"&quot;" }[c]));
        const edgeActive = (f, t) => {
          if (stickyNode) return neighbors.has(f) && neighbors.has(t);
          if (!hoverNode) return true;
          return hoverNode === f || hoverNode === t;
        };
        const nodeActive = (nn) => {
          if (stickyNode) return neighbors.has(nn);
          if (!hoverNode) return true;
          if (hoverNode === nn) return true;
          return edges.some((e) => (e[0] === hoverNode && e[1] === nn) || (e[1] === hoverNode && e[0] === nn));
        };

        // Edges SVG
        const edgeSvg = edges.map(([f, t, n]) => {
          const a = pos[f], b = pos[t];
          if (!a || !b) return "";
          const cx = Cx + (a.x + b.x - 2 * Cx) * 0.18;
          const cy = Cy + (a.y + b.y - 2 * Cy) * 0.18;
          const w = 0.5 + 2.5 * (Math.log(n + 1) / Math.log(maxN + 1));
          const dx = b.x - cx, dy = b.y - cy, d = Math.hypot(dx, dy) || 1;
          const rt = 4 + 6 * Math.sqrt(b.vol / maxVol);
          const ex = b.x - (dx / d) * rt, ey = b.y - (dy / d) * rt;
          const op = edgeActive(f, t) ? (stickyNode ? 0.85 : 0.6) : 0.06;
          const color = ROLE_COLORS[a.role] || "#888";
          return `<path data-edge="1" data-from="${esc(f)}" data-to="${esc(t)}" d="M${a.x},${a.y} Q${cx},${cy} ${ex},${ey}" fill="none" stroke="${color}" stroke-width="${w.toFixed(2)}" stroke-opacity="${op}"><title>${esc(f)} → ${esc(t)}: ${n} msgs</title></path>`;
        }).join("");

        // Nodes SVG — labels not truncated; placed outside the circle on the ring angle
        const nodeSvg = ordered.map((n) => {
          const p = pos[n.n];
          const r = 3 + 7 * Math.sqrt(n.vol / maxVol);
          const isSticky = stickyNode === n.n;
          const op = nodeActive(n.n) ? 1 : 0.18;
          const color = ROLE_COLORS[n.role] || "#888";
          let lx = Cx + (Rx + r + 6) * Math.cos(p.ang);
          const ly = Cy + (Ry + r + 6) * Math.sin(p.ang);
          // Three-way anchor: center labels for near-vertical nodes so they
          // don't extend asymmetrically off one edge of the widget.
          const cosA = Math.cos(p.ang);
          const anchor = cosA > 0.3 ? "start" : cosA < -0.3 ? "end" : "middle";
          // Clamp lx so the label (half-width for middle, full for start/end)
          // stays inside the viewBox.
          const labelPx = n.n.length * CHAR_W;
          const halfW = anchor === "middle" ? labelPx / 2 : 0;
          const minLx = anchor === "end" ? labelPx + 2 : halfW + 2;
          const maxLx = anchor === "start" ? VB_W - labelPx - 2 : VB_W - halfW - 2;
          if (lx < minLx) lx = minLx;
          else if (lx > maxLx) lx = maxLx;
          const strokeW = isSticky ? 2.6 : 1.2;
          const strokeCol = isSticky ? "#a855f7" : "#0a0a12";
          const labelFill = isSticky ? "#a855f7" : "#a0a0b0";
          const labelWeight = isSticky ? "600" : "400";
          const isHuman = n.n === "human";
          const nodeInner = isHuman
            ? `<circle cx="${p.x}" cy="${p.y}" r="${r.toFixed(1)}" fill="${color}" stroke="${strokeCol}" stroke-width="${strokeW}"/><text x="${p.x}" y="${p.y}" font-size="${Math.max(8, r * 1.1).toFixed(1)}" text-anchor="middle" dominant-baseline="central" pointer-events="none">👤</text>`
            : `<circle cx="${p.x}" cy="${p.y}" r="${r.toFixed(1)}" fill="${color}" stroke="${strokeCol}" stroke-width="${strokeW}"/>`;
          return `<g data-node="${esc(n.n)}" opacity="${op}" style="cursor:pointer">
            ${nodeInner}
            <text x="${lx}" y="${ly}" font-size="${FS}" fill="${labelFill}" font-weight="${labelWeight}" text-anchor="${anchor}" dominant-baseline="middle" font-family="SF Mono,Menlo,monospace">${esc(n.n)}</text>
            <title>${esc(n.n)}${isHuman ? " (you)" : " (" + n.role + ")"}: ${n.vol.toLocaleString()} msgs · click to pin · right-click to start src/dst pair</title>
          </g>`;
        }).join("");

        // Legend
        const legend = roleOrder.map((r) => `<span><span class="dot" style="background:${ROLE_COLORS[r]}"></span>${r}</span>`).join("");

        // Top edges table
        const top14 = [...edges].sort((a, b) => b[2] - a[2]).slice(0, 14);
        const rows = top14.map((e) => `<tr data-from="${esc(e[0])}" data-to="${esc(e[1])}" class="comms-ch-row" title="show this channel's messages in the chat transcript"><td>${esc(e[0])}</td><td>${esc(e[1])}</td><td class="r">${e[2]}</td><td class="r">${(e[3]/1000).toFixed(0)}k</td></tr>`).join("");

        // Hover / sticky info card
        let info = "";
        if (stickyNode) {
          const out = edges.filter((e) => e[0] === stickyNode).reduce((s, e) => s + e[2], 0);
          const inn = edges.filter((e) => e[1] === stickyNode).reduce((s, e) => s + e[2], 0);
          const nb = Math.max(0, neighbors.size - 1);
          info = `<div class="comms-info"><strong>📌 ${esc(stickyNode)}</strong> · sent ${out} · received ${inn} · ${nb} visible peers${data.agents.some(a => a.title === stickyNode) ? "" : " · sender has no indexed session; scope uses its indexed neighbors"} · click again to clear</div>`;
        } else if (hoverNode) {
          const out = edges.filter((e) => e[0] === hoverNode).reduce((s, e) => s + e[2], 0);
          const inn = edges.filter((e) => e[1] === hoverNode).reduce((s, e) => s + e[2], 0);
          info = `<div class="comms-info"><strong>${esc(hoverNode)}</strong> · sent ${out} · received ${inn}</div>`;
        } else if (agentFilter) {
          info = `<div class="comms-info">${membershipScope?.agentIds?.size || agentFilter.size} selected sessions · includes observed sender peers · click to pin</div>`;
        } else {
          info = `<div class="comms-info">hover to isolate · click a node to pin + select on timeline</div>`;
        }

        if (sub) {
          sub.textContent = "";
        }
        body.innerHTML = `
          <div class="comms-container comms-split">
            <div class="comms-top">
              <div class="comms-graph-pane">
                <div class="comms-svg-wrap">
                  <svg viewBox="0 0 ${VB_W} ${VB_H}" preserveAspectRatio="xMidYMid meet">
                    <defs><marker id="comms-arr" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="4" markerHeight="4" orient="auto"><path d="M0,0 L6,3 L0,6 z" fill="#888"/></marker></defs>
                    ${edgeSvg}${nodeSvg}
                  </svg>
                </div>
                <div class="comms-legend">${legend}</div>
                ${info}
              </div>
              <div class="comms-table-wrap">
                <div class="comms-tr-head"><span class="comms-tr-title">top channels</span><span class="comms-tr-hint">${top14.length} of ${edges.length}</span></div>
                <div class="comms-table-scroll">
                  <table class="comms-table">
                    <thead><tr><th>from</th><th>to</th><th class="r">msgs</th><th class="r">kchar</th></tr></thead>
                    <tbody>${rows}</tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>`;
        // Populate transcript. If a node is pinned, filter to that one's chat.
