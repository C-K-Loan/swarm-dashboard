  .comms-container.comms-split .xmsg-wrap { background: #11131a; border: 1px dashed #374151; border-radius: 3px; padding: 2px 8px; margin: 4px 0; font-family: ui-monospace,SFMono-Regular,Menlo,monospace; font-size: 10px; }
  .comms-container.comms-split .xmsg-wrap > summary { cursor: pointer; color: #9ca3af; outline: none; list-style: none; }
  .comms-container.comms-split .xmsg-wrap > summary::-webkit-details-marker { display: none; }
