  #widget-grid .widget .widget-help:hover::after {
    content: attr(data-help);
    position: absolute; top: calc(100% + 6px); right: 0;
    width: 320px; max-width: 60vw; white-space: normal; text-align: left;
    background: var(--panel-2); color: var(--text);
    padding: 8px 10px; border: 1px solid var(--border); border-radius: 6px;
    font-size: 11px; line-height: 1.45; font-family: var(--sans, system-ui); letter-spacing: 0;
    box-shadow: 0 6px 24px rgba(0,0,0,0.5);
    z-index: 9999; pointer-events: none;
    text-transform: none;
  }
  #widget-grid .widget .widget-help:hover::before {
    content: ""; position: absolute; top: calc(100% + 1px); right: 4px;
    width: 10px; height: 6px; z-index: 9999; pointer-events: none;
    background: var(--panel-2); clip-path: polygon(0 100%, 100% 100%, 50% 0);
    border-top: 1px solid var(--border);
  }
  /* Code rollup in artifacts widget */
  .code-rollup { margin-top: 8px; }
  .cr-tot { display: flex; gap: 8px; align-items: baseline; font-family: var(--mono); font-size: 11px; margin-bottom: 4px; padding-bottom: 4px; border-bottom: 1px dashed var(--border); }
  ul.code-files { list-style: none; padding: 0; margin: 0; max-height: 320px; overflow: auto; }
  .code-file { display: flex; gap: 8px; padding: 2px 0; font-family: var(--mono); font-size: 11px; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.03); }
  .code-file.more { justify-content: center; padding: 4px 0; }
  .cf-repo { color: var(--muted); font-size: 10px; min-width: 100px; max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cf-path { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text); direction: rtl; text-align: left; unicode-bidi: plaintext; }
  .cf-path > bdi { direction: ltr; unicode-bidi: isolate; }
  .cf-touch { color: var(--muted); font-size: 10px; min-width: 32px; text-align: right; }
  .cf-add { color: #5cff8c; min-width: 48px; text-align: right; }
  .cf-rem { color: #ff5c6c; min-width: 48px; text-align: right; }
  .code-file.cf-head { color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; border-bottom: 1px solid var(--border); padding-bottom: 4px; margin-bottom: 2px; }
  .code-file.cf-head .cf-path { direction: ltr; }
  .code-file.cf-head .cf-add, .code-file.cf-head .cf-rem { color: var(--muted); }
  #widget-grid .widget .col-body { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 10px 12px; min-height: 0; }
  /* v15-B gridstack */
  .widget-toolbar .wt-sep { color: #4a4a5a; }
  .widget-toolbar .wt-field { color: var(--muted); white-space: nowrap; }
  /* One tight row: nothing wraps; overflow is clipped (menus hold the rest). */
  #widget-toolbar { flex-wrap: nowrap; overflow: visible; white-space: nowrap; min-width: 0; }
  #widget-toolbar > * { flex: 0 0 auto; white-space: nowrap; }
  #widget-toolbar .wt-btn, #widget-toolbar .wt-select { white-space: nowrap; }
  #widget-toolbar .wt-select { max-width: 200px; }
  #widget-toolbar #v02-prompt { max-width: 92px; }
  #widget-toolbar .hierarchy-status { display: none; }
  #widget-toolbar .tl-selection-range, #widget-toolbar .selection-chip-slot { white-space: nowrap; }
  #widget-toolbar .tl-selection-range > span { display: inline; }
  .wt-chart-menu .wt-menu { gap: 4px; }
  .wt-chart-menu .wt-menu .wt-btn { text-align: left; }
  .selection-chip-clear { background: none; border: 0; color: var(--muted); cursor: pointer; padding: 0 2px; font: inherit; }
  .selection-chip-clear:hover { color: var(--text); }
  .widget-toolbar #v02-teacher { max-width: 210px; }
  .widget-toolbar .wt-widgets { position: relative; }
  .widget-toolbar .wt-widgets > summary { list-style: none; display: inline-block; white-space: nowrap; }
  .widget-toolbar .wt-widgets > summary::-webkit-details-marker { display: none; }
  .widget-toolbar .wt-menu { position: absolute; top: calc(100% + 4px); left: 0; z-index: 60; display: flex; flex-direction: column; gap: 6px; padding: 8px 10px; min-width: 160px; background: var(--panel-2); border: 1px solid var(--border); border-radius: 4px; box-shadow: 0 6px 18px rgba(0,0,0,.45); }
  .widget-toolbar .wt-btn, .widget-toolbar .wt-select { background: var(--panel-2); color: var(--text); border: 1px solid var(--border); border-radius: 4px; padding: 2px 8px; font: inherit; cursor: pointer; }
  .widget-toolbar .wt-btn:hover { border-color: var(--muted); }
  .widget-toolbar .wt-done { background: #e14580; border-color: #e14580; color: #fff; }
  .widget-toolbar [hidden] { display: none; }
  #widget-grid .grid-stack-item-content { inset: 0; overflow: hidden; }
  #widget-grid .grid-stack-item > .ui-resizable-handle { display: none; }
  /* Edit mode: one distinct corner resize grip, a ⠿ drag grip on each title bar, accent outlines. */
  body.edit-mode #widget-grid .grid-stack-item > .ui-resizable-se { display: block; width: 18px; height: 18px; right: 2px; bottom: 2px; cursor: nwse-resize; background: none; border-right: 3px solid #e14580; border-bottom: 3px solid #e14580; border-radius: 0 0 4px 0; transform: none; z-index: 5; }
  body.edit-mode #widget-grid .grid-stack-item > .ui-resizable-se:hover { border-color: #ff6fa8; }
  body.edit-mode #widget-grid .widget-header { cursor: grab; background: rgba(225,69,128,.10); }
