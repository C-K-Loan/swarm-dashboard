  .art-mentioned { color: var(--warn); margin-left: 3px; font-family: var(--mono); font-size: 9px; opacity: 0.6; }
  .art-more { color: var(--muted); font-style: italic; font-size: 10px; padding-top: 4px; }
  .col { background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px; min-height: 240px; max-height: 320px; overflow: auto; }
