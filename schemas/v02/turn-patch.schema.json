{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cct-summarizer-v0.2-turn-patch",
  "title": "CCT Summarizer V0.2 turn delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "turn_id",
    "actor_patch",
    "actor_evidence",
    "tasks",
    "decisions",
    "relationships"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "turn_id": {
      "type": "string"
    },
    "actor_patch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "reviewer",
            "devops",
            "dev",
            "manager",
            "demo-recorder",
            "demo-player",
            "other",
            null
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "blocked",
            "working",
            "researching",
            "reading",
            "learning",
            "testing",
            "idle",
            "unknown",
            null
          ]
        }
      }
    },
    "actor_evidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message_id",
          "quote"
        ],
        "properties": {
          "message_id": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "resolution",
          "changes",
          "evidence"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "resolution": {
            "enum": [
              "new",
              "existing",
              "ambiguous"
            ]
          },
          "candidate_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "not_started",
                  "progressing",
                  "waiting",
                  "testing",
                  "blocked",
                  "done",
                  "cancelled",
                  null
                ]
              },
              "importance": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "low",
                  "medium",
                  "high",
                  null
                ]
              },
              "complexity": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "low",
                  "medium",
                  "high",
                  null
                ]
              },
              "blocker": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "reason",
                      "need_human_help",
                      "waiting_on_actor"
                    ],
                    "properties": {
                      "reason": {
                        "type": "string"
                      },
                      "need_human_help": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "waiting_on_actor": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "message_id",
                "quote"
              ],
              "properties": {
                "message_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "summary",
          "affected_task_refs",
          "importance",
          "made_by_actor_id",
          "evidence"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "affected_task_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "importance": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "low",
              "medium",
              "high",
              null
            ]
          },
          "made_by_actor_id": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "message_id",
                "quote"
              ],
              "properties": {
                "message_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "from_ref",
          "to_ref",
          "evidence"
        ],
        "properties": {
          "type": {
            "enum": [
              "delegates_to",
              "works_on",
              "reviews",
              "depends_on",
              "is_sub_task"
            ]
          },
          "from_ref": {
            "type": "string"
          },
          "to_ref": {
            "type": "string"
          },
          "task_ref": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "message_id",
                "quote"
              ],
              "properties": {
                "message_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    }
  }
}
